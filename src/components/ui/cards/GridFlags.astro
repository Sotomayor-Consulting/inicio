---
import { Icon } from "astro-icon/components";

export interface Bandera {
  pais: string;
  svg: string;
}

export interface Props {
  banderas: Bandera[];
}

const { banderas } = Astro.props as Props;
---

<div class="flex flex-wrap gap-2 cursor-default">
  {
    [...banderas]
      .sort((a, b) => a.pais.localeCompare(b.pais, "es"))
      .map((li) => (
      <span
        class="flex w-fit cursor-default items-center gap-1 rounded-full bg-white py-0.5 pr-2 pl-2 text-sm leading-3 font-semibold shadow transition-all duration-300 ease-in-out hover:bg-primario-black dark:hover:bg-secundario hover:text-white max-sm:gap-0.5 max-sm:pr-1.5 max-sm:pl-1 max-sm:text-xs"
        role="presentation"
        aria-hidden="true"
      >
        <div
          class="flex aspect-square size-7 items-center justify-center rounded-full p-1 max-lg:size-6 max-sm:size-5"
          role="img"
          aria-label={`${li.pais} - flag`}
        >
          <Icon name={li.svg} class="text-4xl" />
        </div>
        {li.pais}
      </span>
    ))
  }
</div>
