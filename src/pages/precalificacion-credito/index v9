            <div class="calculation-panel" data-visible-if="loanType:Compra de vivienda,No estoy seguro" aria-live="polite">
              <p class="calculation-note">Estimación referencial automática basada en el valor de la propiedad. Los montos finales deben ser validados por un mortgage professional.</p>
              <div class="calculation-grid">
                <div class="calc-box">
                  <small>Entrada 30%</small>
                  <strong id="calcDownPayment">$0</strong>
                </div>
                <div class="calc-box">
                  <small>Monto del crédito 70%</small>
                  <strong id="calcLoanAmount">$0</strong>
                </div>
                <div class="calc-box">
                  <small>Costos de cierre 4%</small>
                  <strong id="calcClosingCosts">$0</strong>
                </div>
                <div class="calc-box">
                  <small>Reserva 12 cuotas</small>
                  <strong id="calcReserve12">$0</strong>
                </div>
                <div class="calc-box">
                  <small>Fondos aproximados requeridos</small>
                  <strong id="calcRequiredFunds">$0</strong>
                </div>
              </div>
            </div>


            <div class="field" data-visible-if="loanType:Compra de vivienda,No estoy seguro">
              <label for="fundsAvailable">¿Los fondos del pago inicial ya están disponibles?</label>
              <select id="fundsAvailable" name="fundsAvailable">
                <option value="">Selecciona una opción</option>
                <option>Sí, están disponibles</option>
                <option>Parcialmente</option>
