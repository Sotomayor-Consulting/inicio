      const agendaUrl = buildZcalUrl(payload);
      if (!agendaContainer || !agendaSection) return;
      agendaContainer.dataset.leadId = payload.lead_id;
      agendaContainer.innerHTML = "";

      const iframe = document.createElement("iframe");
      iframe.id = "zcal-iframe";
