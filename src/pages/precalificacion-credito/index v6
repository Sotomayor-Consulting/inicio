      });
      phoneInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          next();
        }
      });
      if (otherInput) {
        otherInput.addEventListener("input", () => {
          data.phoneCountryOtherDetail = otherInput.value;
          validationBox.classList.remove("show");
        });
      }
      refreshPhonePreview();
    }

    function renderAnswer(q){
      if (!q) return;
      if (q.type === "phone"){
        renderPhoneAnswer(q);
        return;
      }
      const value = data[q.id];
      if (q.type === "country" || q.type === "select"){
        const options = q.options || COUNTRY_OPTIONS;
        const optionHtml = [`<option value="">${escapeHtml(q.placeholder || "Selecciona una opción")}</option>`]
          .concat(options.map(opt => `<option value="${escapeHtml(opt)}" ${value === opt ? "selected" : ""}>${escapeHtml(opt)}</option>`)).join("");
        const desc = value ? getOptionDescription(q, value) : "";
        answerContainer.innerHTML = `<div class="select-wrap"><select id="answerInput">${optionHtml}</select></div>${desc ? `<div class="hint-row">${escapeHtml(desc)}</div>` : ""}${renderOtherDetail(q)}`;
        const input = document.getElementById("answerInput");
        input.focus({preventScroll:true});
        input.addEventListener("change", () => setValue(q.id, input.value));
        bindOtherDetail(q);
        return;
      }
      if (q.type === "radio"){
        answerContainer.innerHTML = `<div class="options">${q.options.map(opt => renderOptionButton(q, opt, value === opt)).join("")}</div>${renderOtherDetail(q)}`;
        answerContainer.querySelectorAll(".option").forEach(btn => btn.addEventListener("click", () => setValue(q.id, btn.dataset.value)));
        bindOtherDetail(q);
        return;
      }
      if (q.type === "checkbox"){
        ensureRequiredOptions(q);
        const selected = Array.isArray(data[q.id]) ? data[q.id] : [];
        answerContainer.innerHTML = `<div class="options">${q.options.map(opt => renderOptionButton(q, opt, selected.includes(opt), q.requiredOptions && q.requiredOptions.includes(opt))).join("")}</div><div class="hint-row">Puedes seleccionar más de una opción. Los documentos marcados como obligatorios no se pueden retirar.</div>${renderOtherDetail(q)}`;
        answerContainer.querySelectorAll(".option").forEach(btn => btn.addEventListener("click", () => {
          const current = Array.isArray(data[q.id]) ? [...data[q.id]] : [];
          const val = btn.dataset.value;
          if (q.requiredOptions && q.requiredOptions.includes(val)) return;
          const idx = current.indexOf(val);
          if (idx >= 0) current.splice(idx,1); else current.push(val);
          setValue(q.id, current);
        }));
        bindOtherDetail(q);
        return;
      }
      const isCurrency = q.type === "currency";
      const inputType = isCurrency ? "text" : q.type;
      const inputMode = isCurrency ? "numeric" : (q.type === "tel" ? "tel" : q.type === "email" ? "email" : "text");
      const displayValue = isCurrency ? formatCurrencyInput(value) : (value ?? "");
      const currencyHint = q.minAmount ? `Monto mínimo referencial: ${formatCurrencyInput(q.minAmount)}.` : "Puedes escribir el monto con o sin símbolo $. Lo formatearemos automáticamente.";
      const phoneHint = q.type === "tel" ? `<div class='phone-preview'>Ejemplo según país seleccionado: <strong>${escapeHtml(phoneExample())}</strong></div>` : "";
      const hint = isCurrency ? `<div class='hint-row'>${currencyHint}</div>` : phoneHint;
      answerContainer.innerHTML = `<input id="answerInput" class="${isCurrency ? "currency-input" : ""}" type="${inputType}" inputmode="${inputMode}" value="${escapeHtml(displayValue)}" placeholder="${escapeHtml(q.placeholder || "")}" autocomplete="off" />${hint}`;
      const input = document.getElementById("answerInput");
      input.focus({preventScroll:true});
      placeCaretAtEnd(input);
      input.addEventListener("input", () => updateFreeTextValue(q, input));
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          next();
        }
      });
    }

    function renderQuestion(){
      summaryMode = false;
      questionView.classList.remove("hidden");
      summaryView.classList.remove("active");
      nextBtn.classList.remove("hidden");
      submitBtn.classList.add("hidden");
      validationBox.classList.remove("show");

      const active = activeQuestions();
      if (currentIndex >= active.length) currentIndex = active.length - 1;
      if (currentIndex < 0) currentIndex = 0;
      const q = active[currentIndex];
      const cat = categories.find(c => c.id === q.category);
      categoryLabel.textContent = `${cat.label} · ${cat.description}`;
      stepIndicator.textContent = `Pregunta ${currentIndex + 1} de ${active.length}`;
      progressFill.style.width = `${Math.round((currentIndex / Math.max(active.length,1)) * 100)}%`;
      questionTitle.textContent = q.title;
      questionHelp.textContent = q.help || "";
      backBtn.disabled = currentIndex === 0;
      microNote.textContent = "Tus respuestas se utilizan para preparar una revisión inicial ordenada con un asesor hipotecario.";
      renderAnswer(q);
      renderCategories();
    }

    function validateCurrent(){
      const q = currentQuestion();
      if (!q) return true;
      if (q.required && !isAnswered(q)){
        validationBox.textContent = "Completa esta respuesta para continuar.";
        validationBox.classList.add("show");
        return false;
      }
      if (selectedHasOther(q) && !String(data[otherKey(q.id)] || "").trim()){
        validationBox.textContent = "Cuéntanos brevemente el contexto de la opción Otro para continuar.";
        validationBox.classList.add("show");
        return false;
      }
      if (q.id === "email" && data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)){
        validationBox.textContent = "Ingresa un correo electrónico válido.";
        validationBox.classList.add("show");
        return false;
      }
      if (q.id === "phone"){
        if (!String(data.phone || "").trim()){
          validationBox.textContent = "Ingresa tu número de WhatsApp para continuar.";
          validationBox.classList.add("show");
          return false;
        }
        if (data.phoneCountryIso && data.phoneE164){
          if (data.phoneIsValid === false){
            validationBox.textContent = "Revisa el número ingresado. Debe coincidir con el país seleccionado.";
            validationBox.classList.add("show");
            return false;
          }
        } else {
          if (!data.phoneCountry){
            validationBox.textContent = "Selecciona el código de país para continuar.";
            validationBox.classList.add("show");
            return false;
          }
          if (data.phoneCountry === "Otro" && !String(data.phoneCountryOtherDetail || "").trim()){
            validationBox.textContent = "Indica el país y el código internacional del número.";
            validationBox.classList.add("show");
            return false;
          }
          const normalized = normalizePhone(data.phone, data.phoneCountry);
          if (!normalized.ok){
            validationBox.textContent = normalized.message;
            validationBox.classList.add("show");
            return false;
          }
          data.phoneE164 = normalized.e164;
          data.whatsAppPhone = normalized.whatsapp;
        }
      }
      if (q.type === "currency" && q.minAmount && numeric(data[q.id]) < q.minAmount){
        validationBox.textContent = `El monto mínimo para continuar es ${formatCurrencyInput(q.minAmount)}.`;
        validationBox.classList.add("show");
        return false;
      }
      if (q.id === "documentsAvailable" && (!Array.isArray(data.documentsAvailable) || !data.documentsAvailable.includes("Pasaporte vigente (obligatorio)"))){
        validationBox.textContent = "El pasaporte vigente es obligatorio para continuar con la revisión inicial.";
        validationBox.classList.add("show");
        return false;
      }
      if (q.id === "consent" && data.consent !== "Acepto"){
        validationBox.textContent = "Para enviar la evaluación debes aceptar la confirmación de contacto.";
        validationBox.classList.add("show");
        return false;
      }
      return true;
    }

    function next(){
      if (!validateCurrent()) return;
      const active = activeQuestions();
      if (currentIndex < active.length - 1){
        currentIndex++;
        renderQuestion();
      } else {
        showSummary();
      }
    }

    function back(){
      if (summaryMode){
        summaryMode = false;
        sendState.className = "send-state";
        sendState.textContent = "";
        renderQuestion();
        return;
      }
      if (currentIndex > 0){
        currentIndex--;
        renderQuestion();
      }
    }

    function calculations(){
      const purchasePrice = numeric(data.estimatedPurchasePrice);
      const currentValue = numeric(data.currentPropertyValue);
      const price = data.loanPurpose === "Compra de vivienda" ? purchasePrice : currentValue;
      const down = numeric(data.downPaymentAmount);
      const currentBalance = numeric(data.currentMortgageBalance);
      const cashOut = numeric(data.cashOutAmount);
      const requestedPurchaseLoan = numeric(data.requestedLoanAmount);
      const requestedRefiLoan = numeric(data.requestedRefiLoanAmount);
      const availableAssets = numeric(data.availableAssets);
      let loanAmount = 0;

      if (data.loanPurpose === "Compra de vivienda"){
        loanAmount = price > 0 ? Math.max(price - down, 0) : requestedPurchaseLoan;
      } else if (data.loanPurpose === "Refinanciamiento"){
        loanAmount = requestedRefiLoan > 0 ? requestedRefiLoan : Math.max(currentBalance + cashOut, 0);
      }

      const valueForRatio = price > 0 ? price : (data.loanPurpose === "Compra de vivienda" ? Math.max(loanAmount + down, 0) : currentValue);
      const ltv = valueForRatio > 0 && loanAmount > 0 ? (loanAmount / valueForRatio) * 100 : 0;
      const monthlyIncome = numeric(data.monthlyIncome);
      const monthlyDebt = numeric(data.monthlyDebt);
      const hoa = numeric(data.hoaAmount);
      const estimatedPayment = estimateMonthlyPayment(loanAmount, valueForRatio || loanAmount, hoa);
      const dti = monthlyIncome > 0 && estimatedPayment > 0 ? ((monthlyDebt + estimatedPayment) / monthlyIncome) * 100 : 0;
      const rent = numeric(data.estimatedRent);
      const dscr = rent > 0 && estimatedPayment > 0 ? rent / estimatedPayment : 0;
      const downPercent = valueForRatio > 0 && down > 0 ? (down / valueForRatio) * 100 : 0;

      const closingCostBase = valueForRatio || loanAmount;
      const estimatedClosingCosts = closingCostBase > 0 ? closingCostBase * 0.03 : 0;
      const reserveMonths = 12;
      const reserveRequirementAmount = estimatedPayment > 0 ? estimatedPayment * reserveMonths : 0;
      const fundsNeeded = data.loanPurpose === "Compra de vivienda"
        ? down + estimatedClosingCosts + reserveRequirementAmount
        : estimatedClosingCosts + reserveRequirementAmount;
      const fundsGap = availableAssets - fundsNeeded;
      const meetsTwelveMonthReserve = availableAssets > 0 && fundsNeeded > 0 && fundsGap >= 0;

      return {
        price,
        down,
        loanAmount,
        ltv,
        downPercent,
        monthlyIncome,
        monthlyDebt,
        estimatedPayment,
        dti,
        rent,
        dscr,
        availableAssets,
        estimatedClosingCosts,
        reserveMonths,
        reserveRequirementAmount,
        fundsNeeded,
        fundsGap,
        meetsTwelveMonthReserve
      };
    }

    function estimateMonthlyPayment(loanAmount, propertyValue, hoa){
      if (!loanAmount || loanAmount <= 0) return 0;
      const annualRate = 0.075;
      const monthlyRate = annualRate / 12;
      const months = 360;
      const principalInterest = loanAmount * (monthlyRate * Math.pow(1 + monthlyRate, months)) / (Math.pow(1 + monthlyRate, months) - 1);
      const taxesInsurance = propertyValue > 0 ? (propertyValue * 0.018) / 12 : 0;
      return principalInterest + taxesInsurance + Number(hoa || 0);
    }

    function classifyLead(calc){
      const tags = [];
      let status = "Lead activo";
      let route = "Revisión manual con asesor hipotecario";

      const foreignNational =
        (data.usStatus === "Vivo fuera de EE. UU. y compraré como extranjero") ||
        (data.identificationType && data.identificationType.includes("Pasaporte") && data.usStatus !== "Ciudadano estadounidense" && data.usStatus !== "Residente permanente / Green Card") ||
        (data.residenceCountry && data.residenceCountry !== "Estados Unidos");

      if (foreignNational) tags.push("Comprador extranjero");
      if (data.buyingEntity && data.buyingEntity !== "A nombre personal") tags.push("Compra a nombre de empresa o LLC");
      if (data.usCreditHistory === "No") tags.push("Sin crédito en EE. UU.");
      if (data.incomeDocumentation === "Estados bancarios") tags.push("Revisión con estados bancarios");
      if (data.propertyUse === "Propiedad de inversión") tags.push("Propiedad de inversión");
      if (calc.ltv >= 85) tags.push("Financiamiento alto frente al valor");
      if (calc.dti >= 50) tags.push("Relación deuda-ingreso alta");
      if (calc.fundsNeeded > 0 && calc.availableAssets > 0 && !calc.meetsTwelveMonthReserve) tags.push("Fondos a revisar para 12 meses");
      if (calc.meetsTwelveMonthReserve) tags.push("Liquidez referencial 12 meses");
      if (data.creditEvents && data.creditEvents !== "No") tags.push("Revisión manual de crédito");

      const hotTimeline = ["Inmediatamente, tengo contrato firmado", "Estoy por hacer una oferta", "Dentro de 30 días"].includes(data.purchaseTimeline);
      const hasFunds = ["Sí, disponibles en cuenta bancaria", "Provienen de venta de otra propiedad"].includes(data.fundsAvailable);

      if (hotTimeline && hasFunds && calc.loanAmount > 0) status = "Lead prioritario";
      if (["Más de 6 meses", "Aún no lo decido"].includes(data.purchaseTimeline)) status = "Lead educativo";
      if (data.contactTime === "Hoy" || data.contactTime === "Mañana") status = status === "Lead educativo" ? "Lead activo" : status;

      if (data.propertyUse === "Propiedad de inversión" && calc.dscr > 0) route = "Revisar alternativa para propiedad de inversión";
      if (data.incomeDocumentation === "Estados bancarios") route = "Revisar alternativa con estados bancarios";
      if (foreignNational) route = "Revisar alternativa para comprador extranjero";
      if (calc.dti >= 50 || calc.ltv >= 90 || (calc.fundsNeeded > 0 && calc.availableAssets > 0 && !calc.meetsTwelveMonthReserve) || (data.creditEvents && data.creditEvents !== "No")) route = "Revisión manual con asesor hipotecario";

      return { status, route, tags };
    }

    function showSummary(){
      summaryMode = true;
      questionView.classList.add("hidden");
      summaryView.classList.add("active");
      nextBtn.classList.add("hidden");
      submitBtn.classList.remove("hidden");
      backBtn.disabled = false;
      microNote.textContent = "Revisa el resumen y envía la evaluación para que un asesor pueda continuar con la revisión.";
      progressFill.style.width = "100%";

      const calc = calculations();
      const cls = classifyLead(calc);
      const name = [data.firstName, data.lastName].filter(Boolean).join(" ") || "Tu perfil";
      summaryIntro.innerHTML = `<strong>${escapeHtml(name)}</strong>, tu evaluación quedó clasificada como <strong>${cls.status}</strong>. Ruta sugerida: <strong>${cls.route}</strong>.`;
      summaryGrid.innerHTML = [
        ["Monto estimado a financiar", money(calc.loanAmount)],
        ["Fondos disponibles declarados", money(calc.availableAssets)],
        ["Reserva referencial 12 meses", money(calc.reserveRequirementAmount)],
        ["Fondos requeridos estimados", money(calc.fundsNeeded)],
        ["Financiamiento frente al valor", percent(calc.ltv)],
        ["Relación deuda-ingreso", percent(calc.dti)]
      ].map(([label,value]) => `<div class="metric"><span>${label}</span><strong>${value}</strong></div>`).join("");

      badges.innerHTML = cls.tags.length ? cls.tags.map(tag => `<span class="badge ${tag.includes("Posible") ? "green" : tag.toLowerCase().includes("alto") || tag.includes("Sin crédito") || tag.includes("deuda-ingreso") ? "red" : ""}">${tag}</span>`).join("") : `<span class="badge green">Perfil sin alertas críticas iniciales</span>`;
      routeText.textContent = "Un asesor debe validar documentación, crédito, fondos, tipo de propiedad y condiciones disponibles antes de entregar una respuesta formal.";
      sendState.className = "send-state";
      sendState.textContent = "";
      lastPayload = buildPayload(calc, cls);
      renderCategories();
    }

    function buildPayload(calc, cls){
      return {
        metadata: {
          formName: "Precalificación hipotecaria Florida",
          formVersion: FORM_VERSION,
          source: "precalificacion_hipotecaria_florida",
          submittedAt: new Date().toISOString(),
          pageUrl: window.location.href
        },
        contacto: {
          nombre: data.firstName || "",
          apellido: data.lastName || "",
          correo: data.email || "",
          paisTelefono: data.phoneCountry || "",
          paisTelefonoIso: data.phoneCountryIso || phoneCountryIso(data.phoneCountry || ""),
          codigoPaisTelefono: data.phoneDialCode || phoneDialPrefix(data.phoneCountry || "").trim(),
          paisTelefonoOtro: data.phoneCountryOtherDetail || "",
          telefonoIngresado: data.phone || "",
          telefonoE164: data.phoneE164 || "",
          whatsappE164: data.whatsAppPhone || "",
          paisResidencia: data.residenceCountry || "",
          paisResidenciaOtro: data.residenceCountryOtherDetail || "",
          idiomaPreferido: data.preferredLanguage || ""
        },
        solicitudPrestamo: {
          tipoPrestamo: data.loanPurpose || "",
          plazoCompra: data.purchaseTimeline || "",
          propiedadSeleccionada: data.hasSelectedProperty || "",
          valorCompraDefinido: data.purchasePriceKnown || "",
          ciudadZonaInteres: data.targetCity || "",
          trabajaConRealtor: data.workingWithRealtor || "",
          objetivoRefinanciamiento: data.refiGoal || "",
          objetivoRefinanciamientoOtro: data.refiGoalOtherDetail || ""
        },
        propiedad: {
          tipoPropiedad: data.propertyType || "",
          tipoPropiedadOtro: data.propertyTypeOtherDetail || "",
          usoPropiedad: data.propertyUse || "",
          direccion: data.propertyAddress || "",
          valorCompraEstimado: numeric(data.estimatedPurchasePrice),
          montoSolicitadoManualCompra: numeric(data.requestedLoanAmount),
          montoSolicitadoManualRefinanciamiento: numeric(data.requestedRefiLoanAmount),
          pagoInicialEstimado: numeric(data.downPaymentAmount),
          valorActualPropiedad: numeric(data.currentPropertyValue),
          saldoHipotecaActual: numeric(data.currentMortgageBalance),
          pagoMensualActual: numeric(data.currentMonthlyPayment),
          montoCashOutSolicitado: numeric(data.cashOutAmount),
          tieneHOA: data.hasHOA || "",
          montoHOA: numeric(data.hoaAmount),
          rentaMensualEstimada: numeric(data.estimatedRent)
        },
        perfilComprador: {
          situacionEstadosUnidos: data.usStatus || "",
          documentoDisponible: data.identificationType || "",
          visaVigente: data.hasUSVisa || "",
          estructuraCompra: data.buyingEntity || "",
          estructuraCompraOtro: data.buyingEntityOtherDetail || ""
        },
        ingresos: {
          situacionLaboral: data.employmentStatus || "",
          situacionLaboralOtro: data.employmentStatusOtherDetail || "",
          paisPrincipalIngresos: data.incomeCountry || "",
          paisPrincipalIngresosOtro: data.incomeCountryOtherDetail || "",
          ingresoMensualBruto: numeric(data.monthlyIncome),
          formaDocumentarIngresos: data.incomeDocumentation || "",
          antiguedadActividad: data.activityTime || ""
        },
        fondosYLiquidez: {
          fondosDisponibles: data.fundsAvailable || "",
          activosDisponibles: numeric(data.availableAssets),
          paisFondos: data.fundsCountry || "",
          paisFondosOtro: data.fundsCountryOtherDetail || "",
          factorLiquidezMeses: 12,
          estadosBancariosDisponibles: data.bankStatementsAvailable || ""
        },
        creditoYDeudas: {
          historialCreditoEEUU: data.usCreditHistory || "",
          puntajeCreditoAproximado: data.creditScore || "",
          deudasMensuales: numeric(data.monthlyDebt),
          propiedadesActuales: data.hasProperties || "",
          ingresoRentasActuales: numeric(data.rentalIncome),
          eventosCredito: data.creditEvents || ""
        },
        cierre: {
          documentosDisponibles: Array.isArray(data.documentsAvailable) ? data.documentsAvailable : [],
          objetivoPrincipal: data.mainObjective || "",
          horarioContacto: data.contactTime || "",
          consentimiento: data.consent || ""
        },
        calculosPreliminares: {
          montoPrestamoEstimado: Math.round(calc.loanAmount || 0),
          ltvEstimado: Math.round(calc.ltv || 0),
          porcentajePagoInicial: Math.round(calc.downPercent || 0),
          pagoMensualEstimado: Math.round(calc.estimatedPayment || 0),
          dtiEstimado: Math.round(calc.dti || 0),
          dscrEstimado: calc.dscr ? Number(calc.dscr.toFixed(2)) : null,
          costosCierreEstimados: Math.round(calc.estimatedClosingCosts || 0),
          factorLiquidezMeses: calc.reserveMonths,
          liquidezDoceMesesEstimada: Math.round(calc.reserveRequirementAmount || 0),
          fondosRequeridosEstimados: Math.round(calc.fundsNeeded || 0),
          brechaFondosEstimada: Math.round(calc.fundsGap || 0),
          cumpleFactorLiquidez12Meses: Boolean(calc.meetsTwelveMonthReserve)
        },
        clasificacionLead: {
          estado: cls.status,
          rutaSugerida: cls.route,
          etiquetas: cls.tags
        },
        contextosAdicionales: collectOtherDetails(),
        respuestas: { ...data }
      };
    }

    function collectOtherDetails(){
      return Object.fromEntries(Object.entries(data).filter(([key, value]) => key.endsWith("OtherDetail") && String(value || "").trim()).map(([key, value]) => [key, String(value).trim()]));
    }

    function numeric(value){
      if (value === undefined || value === null || value === "") return 0;
      const cleaned = String(value).replace(/[^0-9.-]/g, "");
      const n = Number(cleaned || 0);
      return Number.isFinite(n) ? n : 0;
    }

    async function submitPayload(){
      if (!lastPayload) {
        const calc = calculations();
        lastPayload = buildPayload(calc, classifyLead(calc));
      }
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
      sendState.className = "send-state show warn";
      sendState.textContent = "Estamos enviando tu información para revisión.";

      try {
        const response = await fetch(WEBHOOK_URL, {
          method: "POST",
          mode: "cors",
          credentials: "omit",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(lastPayload)
        });
        if (!response.ok) throw new Error(`Webhook respondió ${response.status}`);
        showSentOk();
      } catch (error) {
        console.warn("Envío principal no confirmado. Usando respaldo.", error);
        const fallbackOk = fallbackPost(lastPayload);
        if (fallbackOk) {
          sendState.className = "send-state show ok";
          sendState.textContent = "Tu evaluación fue preparada y enviada para revisión. Un asesor podrá contactarte para continuar.";
        } else {
          sendState.className = "send-state show err";
          sendState.textContent = "No pudimos confirmar el envío automático. Por favor, intenta nuevamente o contacta directamente a un asesor.";
          submitBtn.disabled = false;
          submitBtn.textContent = "Reintentar envío";
        }
      }
    }

    function showSentOk(){
      sendState.className = "send-state show ok";
      sendState.textContent = "Información enviada correctamente. Un asesor podrá contactarte para continuar con la revisión.";
      submitBtn.textContent = "Evaluación enviada";
    }

    function fallbackPost(payload){
      try {
        const form = document.createElement("form");
        form.method = "POST";
        form.action = WEBHOOK_URL;
        form.target = "hiddenWebhookFrame";
        form.style.display = "none";

        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "payload";
        input.value = JSON.stringify(payload);
        form.appendChild(input);

        const version = document.createElement("input");
        version.type = "hidden";
        version.name = "formVersion";
        version.value = FORM_VERSION;
        form.appendChild(version);

        document.body.appendChild(form);
        form.submit();
        setTimeout(() => form.remove(), 1200);
        return true;
      } catch (e) {
        console.warn("Fallback POST falló", e);
        return false;
      }
    }

    function escapeHtml(str){
      return String(str).replace(/[&<>'"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;","\"":"&quot;"}[c]));
    }

    nextBtn.addEventListener("click", next);
    backBtn.addEventListener("click", back);
    submitBtn.addEventListener("click", submitPayload);

    renderQuestion();
  </script>
