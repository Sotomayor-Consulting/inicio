---
import MainLayout from "@/layouts/MainLayout.astro";
import SupportView from "@components/ui/blocks/support.astro";
---

<MainLayout>
  <SupportView
    badge="Suporte"
    title="Estamos aqui para ajudar voce"
    description1="Se voce precisar de suporte com nossos servicos, duvidas tecnicas ou
            assistencia geral, nossa equipe esta disponivel para atende-lo."
    description2="Voce pode nos escrever diretamente para"
    description3="e responderemos o mais breve possivel."
    bottom="Entrar em contato com o suporte"
    titleCard="Informacoes de contato"
    titlecorreo="E-mail de suporte"
    tituloatencion="Atendimento"
    descripcionatencion="Envie sua solicitacao com o maximo de detalhes possivel para receber uma resposta mais rapida e precisa."
    titulorespuesta="Resposta"
    descripcionrespuesta="Nossa equipe revisara sua mensagem e entrara em contato com voce o mais breve possivel."
  />
</MainLayout>
