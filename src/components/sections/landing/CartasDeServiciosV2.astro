const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en");
const isPortuguese = pathname.startsWith("/pr");

const datacards = isEnglish ? datacardsEn : isPortuguese ? datacardsPr : datacardsEs;
---

<section
  class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  id="cartas-servicios"
>
  <!-- Title and description -->
  <div class="mx-auto mb-6 w-full space-y-1 text-center sm:w-1/2 lg:w-1/3">
    <h2
      class="text-2xl leading-tight font-bold text-balance text-primario-black sm:text-3xl dark:text-neutral-200"
    >
      {title}
    </h2>
    {
      subTitle && (
        <p class="leading-tight text-pretty text-primario-black dark:text-neutral-400">
          {subTitle}
        </p>
      )
    }
  </div>
  <div
    class="flex flex-col items-center justify-center gap-y-2 sm:flex-row sm:gap-x-12 sm:gap-y-0 lg:gap-x-24"
  >
    <div class="grid w-full grid-cols-1 gap-5 lg:grid-cols-3">
      {
        datacards.map((data) => {
          // Definimos los títulos de Odoo en cada idioma
          const odooTitles = [
            "Odoo - Software empresarial", // español
            "Odoo - Business Software", // inglés
            "Odoo - Software Empresarial", // portugués (ajusta si es diferente)
          ];

          return odooTitles.includes(data.titulo) ? (
            <a
              href={data.link}
              class="group flex h-full flex-col rounded-xl border bg-white shadow-2xs transition duration-200 ease-in hover:scale-101 lg:col-start-2 dark:border-[#262626] dark:bg-[#262626] dark:text-neutral-200 text-primario-black"
            >
              <div class="flex h-28 flex-col items-center justify-center rounded-t-xl bg-linear-to-l from-[#432c3d] to-[#714b67] object-cover">
                <Icon name={data.icono} class="text-8xl" />
              </div>

              <div class="h-52 p-4 md:p-6">
                <span class="text-primary mb-1 block text-xs font-semibold uppercase transition-colors duration-200 ease-in group-hover:text-[#714B67]">
                  {data.tituloIcon}
                </span>
                <h3 class="text-foreground text-xl font-semibold transition-colors duration-200 ease-in group-hover:text-[#714B67]">
                  {data.titulo}
                </h3>
                <p class="text-muted-foreground-1 mt-3">{data.descripcion}</p>
              </div>
            </a>
          ) : (
            <a
              href={data.link}
              class="group flex h-full flex-col rounded-xl border bg-white shadow-2xl transition duration-200 ease-in hover:scale-101 dark:border-[#262626] dark:bg-[#262626] dark:text-neutral-200 text-primario-black"
            >
              <Image
                src={data.icono}
                alt={data.titulo}
                class="flex h-28 flex-col items-center justify-center rounded-t-xl object-cover"
                loading="lazy"
                inferSize={true}
              />

              <div class="flex h-52 flex-col justify-center p-4 md:p-6">
                <span class="mb-1 block text-xs font-semibold uppercase transition-colors duration-200 ease-in group-hover:text-secundario">
                  {data.tituloIcon}
                </span>
                <h3 class="text-foreground text-2xl font-semibold transition-colors duration-200 ease-in group-hover:text-secundario">
                  {data.titulo}
                </h3>
                <p class="mt-3 text-lg">{data.descripcion}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
