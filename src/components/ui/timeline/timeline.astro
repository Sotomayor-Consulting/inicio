---
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import { Image } from "astro:assets";
import form8821 from "@images/formulario-8821.jpg";
import formSS4 from "@images/ss4.jpg";
import background from "@images/background-dark.jpg"
---

<section
  class="mx-auto grid h-full max-w-[85rem] gap-4 px-4 py-14 sm:px-6 md:items-center md:gap-8 lg:px-8 2xl:max-w-full"
  
>
  <div
    class="flex w-full flex-col items-center justify-center py-10 text-center"
  >
    <h3
      class="mb-5 text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-4xl md:w-1/2 dark:text-neutral-200"
    >
      Nunca ha sido más fácil constituir una empresa en los EE. UU.
    </h3>
    <div>
      <PrimaryCTA title="Comenzar" url="/inicio/#precios" />
      <SecondaryCTA
        title="Más Información"
        url="/inicio/servicios-empresariales/llcs/"
      />
    </div>
  </div>

  <div>
    <div class="h-full font-sans text-gray-900">
      <div class="relative">
        <!-- Línea vertical fija centrada -->
        <div
          class="fixed inset-y-0 left-1/2 -z-10 hidden h-[70%] w-px -translate-x-1/2 translate-y-80 bg-gradient-to-b from-neutral-200 via-neutral-400 to-neutral-50 lg:block dark:from-[#171717] dark:via-neutral-400 dark:to-neutral-800"
        >
        </div>

        <!-- Círculo que se mueve sobre la línea -->
        <div
          id="progress-circle"
          class="pointer-events-none fixed top-[20vh] left-1/2 z-50 hidden h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#ba8d34] shadow-lg transition-all duration-300 ease-out lg:block"
        >
          <div
            class="absolute inset-0 animate-ping rounded-full bg-[#ba8d34] opacity-75"
          >
          </div>
        </div>

        <!-- Título flotante que sigue al círculo -->
        <div
          id="progress-label"
          class="pointer-events-none fixed top-[20vh] z-50 hidden -translate-y-1/2 text-2xl font-semibold text-neutral-800 lg:block dark:text-neutral-200"
        >
          Sección 1
        </div>

        <!-- SECCIONES DEL TIMELINE -->

        <!-- Sección 1: tarjeta a la izquierda -->
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Decide las bases"
          data-side="left"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="text-center lg:pr-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-3">
                    <h2
                      class="mb-2 text-2xl font-bold text-neutral-800 dark:text-neutral-200"
                    >
                      Elija un tipo de empresa y un estado.
                    </h2>
                    <p class="text-neutral-800 dark:text-neutral-400">
                      El primer paso es decidir en qué estado desea constituir
                      su empresa. A continuación, qué tipo de entidad legal
                      prefiere dentro de ese estado. Cada opción tiene sus
                      ventajas y a continuación le ofrecemos información que le
                      ayudará a decidir. La opción más común es una LLC
                      constituida en Delaware.
                    </p>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-lg font-bold text-gray-800 dark:text-white"
                        >
                          LLC.
                        </h3>
                        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
                          Una sociedad de responsabilidad limitada es una
                          estructura organizativa empresarial en los Estados
                          Unidos que ayuda a los propietarios de negocios a
                          separar sus responsabilidades personales de las
                          responsabilidades comerciales.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-lg font-bold text-gray-800 dark:text-white"
                        >
                          C-Corporation.
                        </h3>
                        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
                          Una corporación es una entidad independiente a efectos
                          fiscales. Generalmente, las corporaciones pagan
                          impuestos corporativos sobre sus propias ganancias, y
                          sus accionistas pagan impuestos sobre la renta
                          personal sobre el capital que se les distribuye.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-lg font-bold text-gray-800 dark:text-white"
                        >
                          Delaware.
                        </h3>
                        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
                          El lugar ideal para las startups que buscan
                          financiación de inversores ángeles y firmas de capital
                          riesgo. La mayoría de las empresas de la lista Fortune
                          500 están constituidas en Delaware.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-lg font-bold text-gray-800 dark:text-white"
                        >
                          Wyoming.
                        </h3>
                        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
                          Un estado excelente para pequeñas empresas privadas.
                          Costos extremadamente bajos, muy manejable y flexible
                          a medida que su empresa crece.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="hidden lg:block"></div>
            </div>
          </div>
        </section>

        <!-- Sección 2: tarjeta a la derecha -->
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Configura los detalles"
          data-side="right"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 text-center shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-3">
                    <h2
                      class="mb-2 text-2xl font-bold text-neutral-800 dark:text-neutral-200"
                    >
                      Concéntrese en su negocio. Nosotros nos encargamos de los
                      detalles.
                    </h2>
                    <p class="text-neutral-800 dark:text-neutral-400">
                      Una vez recibida su solicitud, iniciaremos el proceso
                      presentando sus formularios ante las agencias estatales y
                      federales correspondientes. Le haremos seguimiento diario
                      para garantizar que su solicitud se procese lo antes
                      posible. Dependiendo de la rapidez con que las agencias
                      estatales procesen el registro, debería recibir su
                      documentación en tan solo una semana.
                    </p>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-lg font-bold text-gray-800 dark:text-white"
                        >
                          Formulario 8821
                        </h3>
                        <p class="my-2 text-neutral-600 dark:text-neutral-400">
                          Al firmar este formulario, autoriza a nuestro equipo
                          especializado en EIN a obtener actualizaciones sobre
                          el estado de su EIN y a recuperar su carta EIN.
                        </p>
                        <!-- Popover -->
                        <div class="hs-tooltip inline-block [--trigger:hover]">
                          <button
                            type="button"
                            class="hs-tooltip-toggle flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-semibold text-gray-800 shadow-2xs hover:bg-gray-50 focus:bg-gray-50 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                          >
                            ver más
                            <span
                              class="hs-tooltip-content hs-tooltip-shown:opacity-100 hs-tooltip-shown:visible invisible absolute z-10 inline-block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-600 opacity-0 shadow-md transition-opacity dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400"
                              role="tooltip"
                            >
                              <Image
                                src={form8821}
                                class="h-auto w-50"
                                alt="formulario 8821"
                              />
                            </span>
                          </button>
                        </div>
                        <!-- End Popover -->
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-lg font-bold text-gray-800 dark:text-white"
                        >
                          Formulario SS-4
                        </h3>
                        <p class="my-2 text-neutral-600 dark:text-neutral-400">
                          La Solicitud de Número de Identificación Patronal
                          (SS-4) es el formulario del IRS que utilizamos para
                          solicitar un EIN para su nueva empresa.
                        </p>
                        <!-- Popover -->
                        <div class="hs-tooltip inline-block [--trigger:hover]">
                          <button
                            type="button"
                            class="hs-tooltip-toggle flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-semibold text-gray-800 shadow-2xs hover:bg-gray-50 focus:bg-gray-50 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                          >
                            ver más
                            <span
                              class="hs-tooltip-content hs-tooltip-shown:opacity-100 hs-tooltip-shown:visible invisible absolute z-10 inline-block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-600 opacity-0 shadow-md transition-opacity dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400"
                              role="tooltip"
                            >
                              <Image
                                src={formSS4}
                                class="h-auto w-50"
                                alt="formulario 8821"
                              />
                            </span>
                          </button>
                        </div>
                        <!-- End Popover -->
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Sección 3: izquierda -->
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Apertura de cuenta bancaria"
          data-side="left"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="text-center lg:pr-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 shadow-lg dark:bg-[#262626]"
                >
                  <h2
                    class="mb-2 text-2xl font-bold text-neutral-800 dark:text-neutral-200"
                  >
                    Abre una cuenta con uno de nuestros socios bancarios.
                  </h2>
                  <p class="text-neutral-800 dark:text-neutral-400">
                    Nos encargamos de todo. Nuestra completa integración con
                    socios de banca digital automatiza por completo el proceso
                    de solicitud para que no tengas que preocuparte de nada. La
                    apertura de la cuenta bancaria está sujeta a la aprobación
                    de nuestros socios.
                  </p>
                </div>
              </div>
              <div class="hidden lg:block"></div>
            </div>
          </div>
        </section>

        <!-- Sección 4: derecha -->
        <section
          class="timeline-section flex min-h-screen flex-col items-center opacity-50 transition-opacity duration-300"
          data-title="Obtén tus documentos"
          data-side="right"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 text-center shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-5">
                    <h2
                      class="mb-2 text-2xl font-bold text-neutral-800 dark:text-neutral-200"
                    >
                      Recibirás tu número de identificación fiscal del IRS en
                      unos días.
                    </h2>
                    <p class="text-neutral-800 dark:text-neutral-400">
                      El Número de Identificación Patronal (EIN) identifica a la
                      empresa para completar sus declaraciones federales y abrir
                      cuentas bancarias. Actuamos como un tercero autorizado
                      para ofrecer servicios de EIN exprés a nuestros clientes.
                      No es necesario ser residente de EE. UU. para obtener su
                      EIN. No se requiere número de Seguro Social (SSN) ni
                      Número de Identificación Personal del Contribuyente
                      (ITIN).
                    </p>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div
                        class="flex flex-col items-center justify-center p-4 md:p-5"
                      >
                        <img
                          src="https://cdn.prod.website-files.com/609486d2fafa37698a57db5b/61378f6540c42e7d5dd4373b_firstbase-irs.svg"
                          loading="lazy"
                          alt="Servicio de Impuestos Internos (IRS)"
                          class="w-40 filter invert dark:invert-0"
                        />
                        <p
                          class="mt-2 text-2xl text-neutral-600/60 dark:text-neutral-400/60"
                        >
                          Número de identificación del empleador
                        </p>
                        <p
                          class="mt-2 text-4xl text-neutral-600 dark:text-neutral-400"
                        >
                          12-3456789
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="container mx-auto mt-5 px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 text-center shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-5">
                    <h2
                      class="mb-2 text-2xl font-bold text-neutral-800 dark:text-neutral-200"
                    >
                      Todos los documentos operativos de la empresa están
                      listos.
                    </h2>
                    <p class="text-neutral-800 dark:text-neutral-400">
                      Tras la constitución de la empresa, preparamos un conjunto
                      de documentos legales esenciales. Estos documentos
                      proporcionan información clara y necesaria sobre los
                      propietarios, las operaciones y otros detalles vitales de
                      la empresa una vez completada la constitución. Todos los
                      documentos se redactarán con la terminología estándar
                      utilizada por las startups más exitosas.
                    </p>
                  </div>
                  <div class="mb-3">
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo operativo
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Certificado de Secretario
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo de compra de acciones
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo de indemnización para accionistas
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Actuación por consentimiento escrito del fundador
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo de cesión de tecnología
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Estatutos corporativos
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Resoluciones organizativas iniciales del Consejo de
                        Administración
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs text-gray-800 dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Certificado de acciones ordinarias
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

