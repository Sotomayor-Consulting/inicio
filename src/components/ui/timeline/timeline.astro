          </div>
        </section>-->
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const circle = document.getElementById("progress-circle");
      const label = document.getElementById("progress-label");
      const sections = Array.from(document.querySelectorAll(".timeline-section"));
  
      function updateTimeline() {
        // Si es móvil, remover todas las clases de opacidad y salir
        if (window.innerWidth < 1024) {
          sections.forEach(sec => {
            sec.classList.remove("opacity-50", "opacity-100");
          });
          // También ocultar el círculo y label en móvil si es necesario
          if (circle) circle.style.display = 'none';
          if (label) label.style.display = 'none';
          return;
        } else {
          // En desktop, asegurar que sean visibles
          if (circle) circle.style.display = 'block';
          if (label) label.style.display = 'block';
        }
  
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        
        if (docHeight <= 0) return;
  
        const scrollPercent = scrollTop / docHeight;
        const startY = window.innerHeight * 0.5;
        const endY = window.innerHeight * 0.6;
        const topPosition = startY + (endY - startY) * scrollPercent;
        
        circle.style.top = `${topPosition}px`;
        if (label) {
          label.style.top = `${topPosition}px`;
        }
  
        const viewportCenter = window.innerHeight / 2;
        let closestSection = null;
        let minDistance = Infinity;
  
        sections.forEach(sec => {
          const rect = sec.getBoundingClientRect();
          const sectionCenter = rect.top + rect.height / 2;
          const distance = Math.abs(sectionCenter - viewportCenter);
          if (distance < minDistance) {
            minDistance = distance;
            closestSection = sec;
          }
        });
  
        sections.forEach(sec => {
          sec.classList.add("opacity-50");
          sec.classList.remove("opacity-100");
        });
  
        if (closestSection) {
          closestSection.classList.remove("opacity-50");
          closestSection.classList.add("opacity-100");
  
          if (label) {
            const title = closestSection.dataset.title || "";
            const side = closestSection.dataset.side || "left";
            label.textContent = title;
  
            if (side === "left") {
              label.style.left = "calc(50% + 3rem)";
              label.style.textAlign = "left";
            } else {
              label.style.left = "calc(50% - 25rem)";
              label.style.textAlign = "right";
            }
          }
        }
      }
  
      // Debounce para mejor rendimiento
      let timeoutId;
      function debouncedUpdate() {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => requestAnimationFrame(updateTimeline), 10);
      }
  
      updateTimeline();
      window.addEventListener("scroll", debouncedUpdate);
      window.addEventListener("resize", debouncedUpdate);
    });
</script>




  <style is:global>
    /* Efecto ping del círculo */
    @keyframes ping {
      75%,
      100% {
        transform: scale(2);
        opacity: 0;
      }
    }
    .animate-ping {
      animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  </style>
</section>
