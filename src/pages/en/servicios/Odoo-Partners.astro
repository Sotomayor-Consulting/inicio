---
import { dataOdoo } from "src/data_files/en/data-de-servicios";
import MainLayout from "@/layouts/MainLayoutOdoo.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
---

<MainLayout
  title={dataOdoo.titulo}
  customDescription={dataOdoo.titulo}
  customOgTitle={dataOdoo.titulo}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `https://sotomayorconsulting.com/servicios/${dataOdoo.categoria.toLowerCase().replace(/\s+/g, "-")}`,
    name: dataOdoo.titulo,
    description: dataOdoo.descripcion,
    brand: {
      "@type": "Brand",
      name: "Sotomayor Consulting",
    },
  }}
>
  <section
    class="mx-auto flex max-w-340 flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <div class="relative z-10">
        <div class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
          <div class="mx-auto max-w-2xl text-center">
            <Icon
              name="odoo_logo_inverted"
              class="w-full text-center text-8xl"
            />

            <!-- Title -->
            <div class="mt-5 max-w-2xl">
              <h1
                class="block text-4xl font-semibold text-primario-black md:text-5xl lg:text-6xl dark:text-neutral-200"
              >
                {dataOdoo.titulo}
              </h1>
            </div>
            <!-- End Title -->

            <div class="mt-5 max-w-3xl">
              <p class="text-lg text-primario-black dark:text-neutral-400">
                {dataOdoo.descripcion}
              </p>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex justify-center gap-3">
              <a
                class="inline-flex items-center gap-x-2 rounded-lg border border-transparent bg-[#714B67] px-4 py-3 text-sm font-medium text-white hover:bg-[#714B67]/80 focus:bg-blue-700 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                target="_blank"
                href="https://zcal.co/t/agendar-asesoria-llc/60min"
              >
                Contact us
                <svg
                  class="size-4 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                >
              </a>
              <a
                class="inline-flex items-center gap-x-2 rounded-lg border border-transparent bg-[#714B67] px-4 py-3 text-sm font-medium text-white hover:bg-[#714B67]/80 focus:bg-blue-700 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                target="_blank"
                href="https://www.odoo.com?utm_campaign=partner-216100b8&utm_source=partner_ref"
              >
                Visit Odoo
                <svg
                  class="size-4 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                >
              </a>
            </div>
            <!-- End Buttons -->
          </div>
        </div>
      </div>
    </div>
    <!-- End Hero -->

    <!-- Features -->
    <div class="mx-auto px-0 py-10 sm:px-6 lg:px-8 lg:py-14">
      <!-- Tab Nav -->
      <nav
        class="mx-auto flex flex-col gap-y-px sm:flex-row sm:gap-x-4 sm:gap-y-0"
        aria-label="Tabs"
        role="tablist"
        aria-orientation="horizontal"
      >
        {
          dataOdoo.features.map((f, index) =>
            f.estado === "activo" ? (
              <button
                type="button"
                class="hs-tab-active:bg-gray-100 hs-tab-active:hover:border-transparent dark:hs-tab-active:bg-neutral-800 active flex w-full items-center gap-4 rounded-xl p-3 text-center hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden md:flex-col md:p-5 md:text-start dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                id={`tabs-with-card-item-${index}`}
                aria-selected="true"
                data-hs-tab={`#tabs-with-card-${index}`}
                aria-controls={`tabs-with-card-${index}`}
                role="tab"
              >
                <Icon
                  name={f.icono}
                  class="hs-tab-active:text-blue-600 dark:hs-tab-active:text-blue-500 size-7 shrink-0 text-primario-black dark:text-white"
                />
                <span class="sm:mt-5">
                  <span class="hs-tab-active:text-blue-600 dark:hs-tab-active:text-blue-500 block font-semibold text-primario-black dark:text-neutral-200">
                    {f.titulo}
                  </span>
                  <span class="mt-2 hidden text-primario-black lg:block dark:text-neutral-200">
                    {f.descripcion}
                  </span>
                </span>
              </button>
            ) : (
              <button
                type="button"
                class="hs-tab-active:bg-gray-100 hs-tab-active:hover:border-transparent dark:hs-tab-active:bg-neutral-800 flex w-full items-center gap-4 rounded-xl p-3 text-center hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden md:flex-col md:p-5 md:text-start dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                id={`tabs-with-card-item-${index}`}
                aria-selected="true"
                data-hs-tab={`#tabs-with-card-${index}`}
                aria-controls={`tabs-with-card-${index}`}
                role="tab"
              >
                <Icon
                  name={f.icono}
                  class="hs-tab-active:text-blue-600 dark:hs-tab-active:text-blue-500 size-7 shrink-0 text-primario-black dark:text-white"
                />
                <span class="sm:mt-5">
                  <span class="hs-tab-active:text-blue-600 dark:hs-tab-active:text-blue-500 block font-semibold text-primario-black dark:text-neutral-200">
                    {f.titulo}
                  </span>
                  <span class="mt-2 hidden text-primario-black lg:block dark:text-neutral-200">
                    {f.descripcion}
                  </span>
                </span>
              </button>
            ),
          )
        }
      </nav>
      <!-- End Tab Nav -->

      <!-- Tab Content -->
      <div class="mt-12 mb-10 md:mt-16 md:mb-0">
        {
          dataOdoo.features.map((f, index) =>
            f.estado === "activo" ? (
              <div
                id={`tabs-with-card-${index}`}
                role="tabpanel"
                aria-labelledby={`tabs-with-card-${index}`}
              >
                <div class="relative flex justify-center lg:pb-32">
                  {f.tipo === "video" ? (
                    <video
                      src={typeof f.image === "string" ? f.image : ""}
                      autoplay
                      controls
                      muted
                      loop
                      class="rounded-2xl shadow-2xl dark:shadow-neutral-600"
                    />
                  ) : (
                    <Image
                      src={f.image as any}
                      alt={`imagen-${index}`}
                      layout="constrained"
                      class="rounded-2xl shadow-2xl dark:shadow-neutral-600"
                    />
                  )}
                </div>
              </div>
            ) : (
              <div
                id={`tabs-with-card-${index}`}
                role="tabpanel"
                aria-labelledby={`tabs-with-card-${index}`}
                class="hidden"
              >
                <div class="mx-auto px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
                  <div class="md:grid md:grid-cols-2 md:items-center md:gap-12 xl:gap-32">
                    <div>
                      {f.tipo === "video" ? (
                        <video
                          src={typeof f.image === "string" ? f.image : ""}
                          autoplay
                          controls
                          muted
                          loop
                          class="rounded-2xl"
                        />
                      ) : (
                        <Image
                          src={f.image as any}
                          alt={`imagen-${index}`}
                          layout="constrained"
                          class="rounded-2xl"
                        />
                      )}
                    </div>
                    {f.features2?.map((f) => (
                      <div class="mt-5 sm:mt-10 lg:mt-0">
                        <div class="space-y-6 sm:space-y-8">
                          <div class="space-y-2 md:space-y-4">
                            <h2 class="text-3xl font-bold lg:text-4xl dark:text-neutral-200">
                              {f.titulo}
                            </h2>
                            <p class="text-muted-foreground-1 dark:text-neutral-200">
                              {f.descripcion}
                            </p>
                          </div>
                          <ul class="space-y-2 sm:space-y-4">
                            {f.lista.map((l) => (
                              <li class="flex gap-x-3">
                                <span class="bg-primary-50 text-primary-600 dark:bg-primary-500/20 dark:text-primary-200 mt-0.5 flex size-5 items-center justify-center rounded-full">
                                  <Icon
                                    name="mingcute:check-line"
                                    class="size-3.5 shrink-0 dark:text-neutral-200"
                                  />
                                </span>
                                <div class="grow">
                                  <span class="text-muted-foreground-1 text-sm sm:text-base dark:text-neutral-200">
                                    {l}
                                  </span>
                                </div>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ),
          )
        }
      </div>

      <!-- End Tab Content -->
      <div class="flex w-full justify-center">
        <!-- Hire Us -->
        <div class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
          <!-- Grid -->
          <div class="grid items-center gap-12 md:grid-cols-2">
            <div>
              <h1
                class="text-foreground text-3xl font-bold sm:text-4xl lg:text-5xl lg:leading-tight dark:text-neutral-200"
              >
                {dataOdoo.tituloForm}
              </h1>
              <p class="text-foreground mt-1 md:text-lg dark:text-neutral-200">
                {dataOdoo.descripcionForm}
              </p>

              <div class="mt-8">
                <h2
                  class="text-foreground text-lg font-semibold dark:text-neutral-200"
                >
                  {dataOdoo.preguntaForm}
                </h2>

                <ul class="mt-2 space-y-2">
                  {
                    dataOdoo.listaForm.map((l) => (
                      <li class="flex gap-x-3">
                        <svg
                          class="text-muted-foreground-2 mt-0.5 size-5 shrink-0 dark:text-neutral-200"
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span class="text-muted-foreground-2 dark:text-neutral-200">
                          {l}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <!-- Brands -->
              <div class="mt-8">
                <h2
                  class="text-foreground text-lg font-semibold dark:text-neutral-200"
                >
                  Official partner:
                </h2>

                <div class="mt-4 flex gap-x-8">
                  <Icon name="odoo_logo" class="text-7xl" />
                </div>
              </div>
              <!-- End Brands -->

              <div class="mt-10 flex items-center gap-x-5">
                <!-- Avatar Group -->
                <div class="flex -space-x-2">
                  <Image src="https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80" class="inline-block size-8 rounded-full ring-2 ring-[#8f8f8f]" alt="Avatar" inferSize={true} loading="lazy" />
                  <Image src="https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2.5&w=320&h=320&q=80" class="inline-block size-8 rounded-full ring-2 ring-[#8f8f8f]" alt="Avatar" inferSize={true} loading="lazy" />
                  <Image src="https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=3&w=320&h=320&q=80" class="inline-block size-8 rounded-full ring-2 ring-[#8f8f8f]" alt="Avatar" inferSize={true} loading="lazy" />
                  
                  <span
                    class="inline-flex size-8 items-center justify-center rounded-full bg-[#714B67] ring-2 ring-[#8f8f8f]"
                  >
                    <svg
                      class="size-3.5 text-[#8f8f8f]"
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      fill="currentColor"
                      viewBox="0 0 16 16"
                    >
                      <path
                        d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"
                      ></path>
                    </svg>
                  </span>
                </div>
                <!-- End Avatar Group -->
                <span
                  class="text-muted-foreground-1 text-sm dark:text-neutral-200"
                >
                  Trusted by over 3k clients.
                </span>
              </div>
            </div>
            <!-- End Col -->

            <div class="relative">
              <!-- Card -->
              <div
                class="flex flex-col rounded-xl border border-[#714B67] p-4 sm:p-6 lg:p-10"
              >
                <h2
                  class="text-foreground text-xl font-semibold dark:text-neutral-200"
                >
                  Fill out the form
                </h2>

                <form action="https://api.web3forms.com/submit" method="post">
                  <input
                    type="hidden"
                    name="access_key"
                    value="a3a0ec9c-e3a4-4000-a7e0-8d6709e5701c"
                  />
                  <div class="mt-6 grid gap-4 lg:gap-6">
                    <!-- Grid -->
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:gap-6">
                      <div>
                        <label
                          for="hs-firstname-hire-us-1"
                          class="text-foreground mb-2 block text-sm font-medium dark:text-neutral-200"
                          >First Name</label
                        >
                        <input
                          type="text"
                          name="hs-firstname-hire-us-1"
                          id="hs-firstname-hire-us-1"
                          class="text-foreground placeholder:text-muted-foreground-1 block w-full rounded-lg border-neutral-700 bg-[#714B67]/20 px-4 py-2.5 focus:border-[#714B67]/80 focus:ring-[#714B67]/80 disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:text-sm dark:text-white"
                          required
                        />
                      </div>

                      <div>
                        <label
                          for="hs-lastname-hire-us-1"
                          class="text-foreground mb-2 block text-sm font-medium dark:text-neutral-200"
                          >Last Name</label
                        >
                        <input
                          type="text"
                          name="hs-lastname-hire-us-1"
                          id="hs-lastname-hire-us-1"
                          class="text-foreground placeholder:text-muted-foreground-1 block w-full rounded-lg border-neutral-700 bg-[#714B67]/20 px-4 py-2.5 focus:border-[#714B67]/80 focus:ring-[#714B67]/80 disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:text-sm dark:text-white"
                          required
                        />
                      </div>
                    </div>
                    <!-- End Grid -->

                    <div>
                      <label
                        for="hs-work-email-hire-us-1"
                        class="text-foreground mb-2 block text-sm font-medium dark:text-neutral-200"
                        >Email</label
                      >
                      <input
                        type="email"
                        name="hs-work-email-hire-us-1"
                        id="hs-work-email-hire-us-1"
                        autocomplete="email"
                        class="text-foreground placeholder:text-muted-foreground-1 block w-full rounded-lg border-neutral-700 bg-[#714B67]/20 px-4 py-2.5 focus:border-[#714B67]/80 focus:ring-[#714B67]/80 disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:text-sm dark:text-white"
                        required
                      />
                    </div>

                    <!-- Grid -->
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:gap-6">
                      <div>
                        <label
                          for="hs-company-hire-us-1"
                          class="text-foreground mb-2 block text-sm font-medium dark:text-neutral-200"
                          >Your company name</label
                        >
                        <input
                          type="text"
                          name="hs-company-hire-us-1"
                          id="hs-company-hire-us-1"
                          class="text-foreground placeholder:text-muted-foreground-1 block w-full rounded-lg border-neutral-700 bg-[#714B67]/20 px-4 py-2.5 focus:border-[#714B67]/80 focus:ring-[#714B67]/80 disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:text-sm dark:text-white"
                        />
                      </div>

                      <div>
                        <label
                          for="hs-company-website-hire-us-1"
                          class="text-foreground mb-2 block text-sm font-medium dark:text-neutral-200"
                          >Your company website</label
                        >
                        <input
                          type="text"
                          name="hs-company-website-hire-us-1"
                          id="hs-company-website-hire-us-1"
                          class="text-foreground placeholder:text-muted-foreground-1 block w-full rounded-lg border-neutral-700 bg-[#714B67]/20 px-4 py-2.5 focus:border-[#714B67]/80 focus:ring-[#714B67]/80 disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:text-sm dark:text-white"
                        />
                      </div>
                    </div>
                    <!-- End Grid -->

                    <div>
                      <label
                        for="hs-about-hire-us-1"
                        class="text-foreground mb-2 block text-sm font-medium dark:text-neutral-200"
                        >What exactly do you need for your business?</label
                      >
                      <textarea
                        id="hs-about-hire-us-1"
                        name="hs-about-hire-us-1"
                        rows="4"
                        placeholder="Example: I need a module to manage customers by stages, and task assignment process."
                        class="text-foreground placeholder:text-muted-foreground-1 block w-full rounded-lg border-neutral-700 bg-[#714B67]/20 px-4 py-2.5 focus:border-[#714B67]/80 focus:ring-[#714B67]/80 disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:text-sm dark:text-white"
                      ></textarea>
                    </div>
                  </div>
                </form>
                <!-- End Grid -->

                <div class="mt-6 grid">
                  <button
                    type="submit"
                    class="text-primary-foreground focus:bg-primary-focus inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-[#714B67]/80 bg-[#714B67] px-4 py-3 text-sm font-medium hover:bg-[#714B67]/80 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 text-neutral-200"
                    >Send</button
                  >
                </div>

                <div class="mt-3 text-center">
                  <p
                    class="text-muted-foreground-1 text-sm dark:text-neutral-200"
                  >
                    We will contact you as quickly as possible.
                  </p>
                </div>
              </div>
              <!-- End Card -->
            </div>
            <!-- End Col -->
          </div>
          <!-- End Grid -->
        </div>
        <!-- End Hire Us -->
      </div>

      <!-- End Card -->
    </div>
  </section>
  <!-- End Features -->
</MainLayout>
