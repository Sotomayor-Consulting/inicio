  <script>
    const cambio = document.getElementById("siguienteBtn");
    const tabla1 = document.getElementById("tabs-with-card-1");
    const tabla2 = document.getElementById("tabs-with-card-2");
    const boton1 = document.getElementById("tabs-with-card-item-1");
    const boton2 = document.getElementById("tabs-with-card-item-2");
    const span1 = document.getElementById("Detalles");
    const span2 = document.getElementById("formulario");

    cambio?.addEventListener("click", () => {
      tabla1?.classList.remove("block");
      tabla1?.classList.add("hidden");
      tabla2?.classList.remove("hidden");
      tabla2?.classList.add("block");
      boton2?.classList.add(
        "active",
        "bg-neutral-100",
        "hover:border-transparent",
        "dark:bg-white/[.05]",
      );
      boton1?.classList.remove(
        "active",
        "bg-neutral-100",
        "hover:border-transparent",
        "dark:bg-white/[.05]",
      );
      span1?.classList.remove("text-secundario", "dark:text-secundario");
      span1?.classList.add("text-primario-black", "dark:text-neutral-200");
      span2?.classList.add("text-secundario", "dark:text-secundario");
      span2?.classList.remove("text-primario-black", "dark:text-neutral-200");
    });
  </script>
  <script type="module">
    document.addEventListener("DOMContentLoaded", function () {
      function c(t, e) {
        if (t !== e) {
          t.classList.remove(
            "active",
            "bg-neutral-100",
            "hover:border-transparent",
            "dark:bg-white/[.05]",
          );
          const a = t.getAttribute("data-target");
          if (a) {
            const n = document.querySelector(a);
            n && n.classList.add("hidden");
          }
          d(
            t,
            ["text-primario-black", "dark:text-neutral-200"],
            ["text-secundario", "dark:text-secundario"],
          );
        }
      }
      function i(t) {
        t.classList.add(
          "active",
          "bg-neutral-100",
          ",hover:border-transparent",
          "dark:bg-white/[.05]",
        );
        const e = t.getAttribute("data-target");
        if (e) {
          const a = document.querySelector(e);
          a && a.classList.remove("hidden");
        }
        d(
          t,
          ["text-secundario", "dark:text-secundario"],
          ["text-primario-black", "dark:text-neutral-200"],
        );
      }
      function d(t, e, a) {
        let n = t.querySelector("span");
        n && (n.classList.remove(...a), n.classList.add(...e));
      }
      const r = document.querySelectorAll("[data-target]");
      (r.length > 0 && d(r[0], ["text-secundario", "dark:text-secundario"], []),
        r.forEach((t) => {
          t.addEventListener("click", () => {
            (r.forEach((e) => c(e, t)), i(t));
          });
        }));
    });
  </script>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const countrySelect = document.getElementById(
        "hs-inline-leading-select-country",
      );
      const phoneInput = document.getElementById(
        "hs-inline-leading-select-label",
      );

      // Función para actualizar el código de país
      function updateCountryCode() {
        const selectedCountryCode = countrySelect.value;
        const currentPhoneValue = phoneInput.value;

        // Si el valor actual ya empieza con un código de país, lo eliminamos
        const phoneWithoutCode = currentPhoneValue.replace(/^\+\d+\s?/, "");

        // Añadimos el nuevo código de país
        phoneInput.value = selectedCountryCode + " " + phoneWithoutCode;
      }

      // Actualizar cuando cambie la selección
      countrySelect.addEventListener("change", updateCountryCode);

      // Actualizar al cargar la página
      updateCountryCode();
    });
  </script>
