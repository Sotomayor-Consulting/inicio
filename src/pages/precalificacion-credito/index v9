              <input id="currentPropertyValue" name="currentPropertyValue" class="currency-input currency-field" type="text" data-min="0" data-max="25000000" inputmode="numeric" placeholder="$0" />
            </div>

            <div class="field" data-visible-if="loanType:Refinanciar,Retiro de dinero / Cash-out">
              <label for="currentMortgageBalance">Saldo actual de hipoteca</label>
              <input id="currentMortgageBalance" name="currentMortgageBalance" class="currency-input currency-field" type="text" data-min="0" data-max="25000000" inputmode="numeric" placeholder="$0" />
            </div>

            <div class="field" data-visible-if="loanType:Refinanciar,Retiro de dinero / Cash-out">
              <label for="currentMonthlyPayment">Pago mensual actual</label>
              <input id="currentMonthlyPayment" name="currentMonthlyPayment" class="currency-input currency-field" type="text" data-min="0" data-max="500000" inputmode="numeric" placeholder="$0" />
            </div>

            <div class="field" data-visible-if="loanType:Refinanciar,Retiro de dinero / Cash-out">
              <label for="currentRate">Tasa actual aproximada</label>
              <input id="currentRate" name="currentRate" type="number" min="0" step="0.01" placeholder="Tasa actual" />
            </div>

            <div class="field" data-visible-if="loanType:Retiro de dinero / Cash-out">
              <label for="cashOutAmount">Monto que deseas retirar</label>
              <input id="cashOutAmount" name="cashOutAmount" class="currency-input currency-field" type="text" data-min="0" data-max="25000000" inputmode="numeric" placeholder="$0" />
            </div>

            <div class="field full">
              <label>¿Qué tipo de propiedad es?</label>
              <div class="option-grid three">
                <label class="option-card"><input type="radio" name="propertyType" value="Unifamiliar" required /> Unifamiliar</label>
                <label class="option-card"><input type="radio" name="propertyType" value="Multifamiliar 2-4 unidades" required /> Multifamiliar</label>
                <label class="option-card"><input type="radio" name="propertyType" value="Departamento o piso" required /> Departamento o piso</label>
                <label class="option-card"><input type="radio" name="propertyType" value="Townhouse" required /> Townhouse</label>
                <label class="option-card"><input type="radio" name="propertyType" value="Vivienda manufacturada" required /> Manufacturada</label>
                <label class="option-card"><input type="radio" name="propertyType" value="Otro" required /> Otro</label>
