    function money(value){
      const num = Number(value || 0);
      if (!num || num <= 0) return "Pendiente";
      return new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",maximumFractionDigits:0}).format(num);
    }

    function percent(value){
      if (!Number.isFinite(value) || value <= 0) return "Pendiente";
      return `${Math.round(value)}%`;
    }

    function activeQuestions(){
      return questions.filter(q => !q.visible || q.visible(data));
    }

    function currentQuestion(){
      return activeQuestions()[currentIndex];
    }

    function renderCategories(){
      const active = activeQuestions();
      const current = active[currentIndex];
      categoryList.innerHTML = categories.map((cat, idx) => {
        const catQuestions = active.filter(q => q.category === cat.id);
        const answered = catQuestions.filter(q => isAnswered(q)).length;
        const total = catQuestions.length;
        const activeClass = current && current.category === cat.id ? "active" : "";
        const completeClass = total > 0 && answered === total ? "complete" : "";
        const status = total ? `${answered}/${total}` : "—";
        return `<li class="${activeClass} ${completeClass}"><span class="cat-number">${idx+1}</span><span>${cat.label}</span><span class="cat-status">${status}</span></li>`;
      }).join("");
    }

    function isAnswered(q){
      const value = data[q.id];
      if (q.type === "phone") return Boolean(String(data.phoneCountry || "").trim() && String(data.phone || "").trim());
      if (q.type === "checkbox") return Array.isArray(value) && value.length > 0;
      return value !== undefined && value !== null && String(value).trim() !== "";
    }

    function optionIsOther(value){
      return String(value || "").trim().toLowerCase() === "otro";
    }

    function selectedHasOther(q){
      const value = data[q.id];
      if (Array.isArray(value)) return value.some(optionIsOther);
      return optionIsOther(value);
    }

