    function buildZcalUrl(payload) {
      const url = new URL(CONFIG.zcalBaseUrl);
      url.searchParams.set("source", payload.source);
      url.searchParams.set("landing_reference", payload.landing_reference);
      url.searchParams.set("ab_variant", payload.ab_variant);
      url.searchParams.set("conversion_path", payload.conversion_path);
      url.searchParams.set("lead_id", payload.lead_id);
      ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "ttclid"].forEach((key) => {
        if (payload[key]) url.searchParams.set(key, payload[key]);
      });
      Object.entries(CONFIG.zcalQuestionMap).forEach(([zcalParam, payloadKey]) => {
        if (payload[payloadKey]) url.searchParams.set(zcalParam, payload[payloadKey]);
      });
      return url.toString();
    }

    function bindScheduleConfirmationHooks() {
      window.SCITrackSchedule = function (extra = {}) { fireScheduleConversion("external_confirmed", extra); };
      window.addEventListener("message", (event) => {
        const origin = String(event.origin || "");
        if (!origin.includes("zcal.co")) return;
        const rawMessage = typeof event.data === "string" ? event.data : JSON.stringify(event.data || {});
        if (/schedule|scheduled|booking|booked|confirmed|success/i.test(rawMessage)) {
          fireScheduleConversion("zcal_postmessage_confirmed", { zcal_message: rawMessage.slice(0, 160) });
        }
      });
      agendaContainer?.addEventListener("pointerdown", () => {
        const stored = readStoredLead();
        trackEvent("schedule_intent", {
          ...getBaseTrackingPayload(),
          lead_id: stored?.lead_id || agendaContainer.dataset.leadId || "",
          main_goal: stored?.main_goal || "",
          ab_variant: "A",
          conversion_path: "schedule_first"
        });
      }, { once: true });
    }

