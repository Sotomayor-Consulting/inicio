  <script>
    // 1) Configuración opcional para integración con n8n, Zapier, Make, CRM, etc.
    // Pega aquí tu webhook si quieres enviar el resultado automáticamente.
    const WEBHOOK_URL = "https://n8n.sotomayorconsulting.com/webhook/precalificacion-credito";

    const form = document.getElementById("mortgageWizard");
    const steps = Array.from(document.querySelectorAll(".form-step"));
    const stepButtons = Array.from(document.querySelectorAll("[data-step-target]"));
    const progressFill = document.getElementById("progressFill");
    const progressText = document.getElementById("progressText");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const submitBtn = document.getElementById("submitBtn");
    const summaryCard = document.getElementById("summaryCard");
    const leadSummary = document.getElementById("leadSummary");
    const metricsGrid = document.getElementById("metricsGrid");
    const pillRow = document.getElementById("pillRow");
    const submissionStatus = document.getElementById("submissionStatus");
    const estimatedPurchasePriceInput = document.getElementById("estimatedPurchasePrice");
    const phoneCountryCode = document.getElementById("phoneCountryCode");
    const phoneInput = document.getElementById("phone");
    const phoneCountryTrigger = document.getElementById("phoneCountryTrigger");
    const phoneCountryMenu = document.getElementById("phoneCountryMenu");
    const phoneCountryFlag = document.getElementById("phoneCountryFlag");
    const phoneCountryLabel = document.getElementById("phoneCountryLabel");
    const phoneCountryOptions = Array.from(document.querySelectorAll(".phone-country-option"));
    const currencyInputs = Array.from(document.querySelectorAll(".currency-input"));
    const countryResidence = document.getElementById("countryResidence");
    const purchaseEstimateElements = {
      downPayment: document.getElementById("calcDownPayment"),
      loanAmount: document.getElementById("calcLoanAmount"),
      closingCosts: document.getElementById("calcClosingCosts"),
      reserve12: document.getElementById("calcReserve12"),
      requiredFunds: document.getElementById("calcRequiredFunds")
    };
    let currentStep = 0;
    let phoneCountryTouched = false;

    function getFormData() {
      const data = {};
      const formData = new FormData(form);
      for (const [key, value] of formData.entries()) {
        if (data[key]) {
          data[key] = Array.isArray(data[key]) ? [...data[key], value] : [data[key], value];
        } else {
          data[key] = value;
        }
      }
      return data;
    }

    function getFieldValue(name) {
      const data = getFormData();
      return data[name] || "";
    }

    function updateConditionalFields() {
      const data = getFormData();
      document.querySelectorAll("[data-visible-if]").forEach((block) => {
        const rules = block.getAttribute("data-visible-if").split("|");
        const shouldShow = rules.some((rule) => {
          const [field, valuesString] = rule.split(":");
          const acceptedValues = valuesString.split(",").map((value) => value.trim());
          return acceptedValues.includes((data[field] || "").trim());
        });
        block.classList.toggle("visible", shouldShow);
        block.hidden = !shouldShow;
      });
      updatePurchaseEstimatePanel();
    }

    function showError(message) {
      const current = steps[currentStep];
      const errorBox = current.querySelector(".error-box");
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.style.display = "block";
    }

    function clearError() {
      steps.forEach((step) => {
        const errorBox = step.querySelector(".error-box");
        if (errorBox) {
          errorBox.textContent = "";
          errorBox.style.display = "none";
        }
      });
    }

    function isVisible(element) {
      return !element.closest("[hidden]") && !!(element.offsetWidth || element.offsetHeight || element.getClientRects().length);
    }

    function validateCurrentStep() {
      clearError();
      const current = steps[currentStep];
      const requiredFields = Array.from(current.querySelectorAll("input[required], select[required], textarea[required]")).filter(isVisible);

      const groupedRadios = new Set();
      for (const field of requiredFields) {
        if (field.type === "radio") {
          if (groupedRadios.has(field.name)) continue;
          groupedRadios.add(field.name);
          const checked = current.querySelector(`input[name="${field.name}"]:checked`);
          if (!checked) {
            showError("Por favor completa la pregunta obligatoria antes de continuar.");
            return false;
          }
          continue;
        }
        if (field.type === "checkbox" && !field.checked) {
          showError("Para continuar debes aceptar el consentimiento indicado.");
          return false;
        }
        if (!field.value.trim()) {
          field.focus();
          showError("Por favor completa todos los campos obligatorios antes de continuar.");
          return false;
        }
        if (field.type === "number") {
          const value = safeNumber(field.value);
          const max = field.max ? safeNumber(field.max) : 0;
          const min = field.min ? safeNumber(field.min) : 0;
          if (field.max && value > max) {
            field.focus();
            showError("El monto ingresado parece demasiado alto. Revisa que esté expresado en dólares estadounidenses y sin símbolos.");
            return false;
          }
          if (field.min && value < min) {
            field.focus();
            showError("El monto ingresado debe ser mayor o igual a cero.");
            return false;
          }
        }
        if (field.classList.contains("currency-input") && field.value.trim()) {
          const value = safeNumber(field.value);
          const max = field.dataset.max ? safeNumber(field.dataset.max) : 0;
          const min = field.dataset.min ? safeNumber(field.dataset.min) : 0;
          if (max && value > max) {
            field.focus();
            showError("El monto ingresado parece demasiado alto. Revisa que esté expresado en dólares estadounidenses.");
            return false;
          }
          if (min && value < min) {
            field.focus();
            showError(`El valor estimado debe ser al menos ${currencyZero(min)}.`);
            return false;
          }
        }
      }

      const requiredCheckGroups = Array.from(current.querySelectorAll("[data-required-checkgroup]")).filter(isVisible);
      for (const group of requiredCheckGroups) {
        const groupName = group.getAttribute("data-required-checkgroup");
        if (!current.querySelector(`input[name="${groupName}"]:checked`)) {
          showError("Por favor selecciona al menos una opción antes de continuar.");
          return false;
        }
      }

      return true;
    }

    function goToStep(index) {
      currentStep = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, i) => step.classList.toggle("active", i === currentStep));
      stepButtons.forEach((button, i) => button.classList.toggle("active", i === currentStep));
      prevBtn.hidden = currentStep === 0;
      nextBtn.hidden = currentStep === steps.length - 1;
      submitBtn.hidden = currentStep !== steps.length - 1;
      const percentage = Math.round((currentStep / (steps.length - 1)) * 100);
      progressFill.style.width = `${percentage}%`;
      progressText.textContent = `${percentage}%`;
      updateConditionalFields();
      clearError();
      document.getElementById("formulario").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function currency(value) {
      const number = Number(value || 0);
      if (!number) return "No informado";
      return number.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
    }


    function currencyZero(value) {
      const number = Number(value || 0);
      return number.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
    }

    function formatCurrencyInput(input) {
      if (!input) return;
      const numericValue = safeNumber(input.value);
      input.value = numericValue ? currencyZero(numericValue) : "";
      updatePurchaseEstimatePanel();
    }

    function getPurchaseEstimatesFromValue(propertyValue) {
      const value = safeNumber(propertyValue);
      const downPayment = Math.round(value * 0.30);
      const loanAmount = Math.round(value * 0.70);
      const closingCosts = Math.round(value * 0.04);
      const reserve12 = Math.round(loanAmount * 0.0401142857);
      const requiredFunds = downPayment + closingCosts + reserve12;
      return { value, downPayment, loanAmount, closingCosts, reserve12, requiredFunds };
    }

    function getPurchaseEstimates(data) {
      return getPurchaseEstimatesFromValue(data.estimatedPurchasePrice);
    }

    function updatePurchaseEstimatePanel() {
      const estimates = getPurchaseEstimatesFromValue(estimatedPurchasePriceInput ? estimatedPurchasePriceInput.value : 0);
      if (purchaseEstimateElements.downPayment) purchaseEstimateElements.downPayment.textContent = currencyZero(estimates.downPayment);
      if (purchaseEstimateElements.loanAmount) purchaseEstimateElements.loanAmount.textContent = currencyZero(estimates.loanAmount);
      if (purchaseEstimateElements.closingCosts) purchaseEstimateElements.closingCosts.textContent = currencyZero(estimates.closingCosts);
      if (purchaseEstimateElements.reserve12) purchaseEstimateElements.reserve12.textContent = currencyZero(estimates.reserve12);
      if (purchaseEstimateElements.requiredFunds) purchaseEstimateElements.requiredFunds.textContent = currencyZero(estimates.requiredFunds);
    }

    function digitsOnly(value) {
      return String(value || "").replace(/\D/g, "");
    }

    function getSelectedPhoneCountry() {
      return {
        code: phoneCountryCode ? phoneCountryCode.value : "",
        country: phoneCountryCode ? phoneCountryCode.dataset.country || "" : "",
        flag: phoneCountryCode ? phoneCountryCode.dataset.flag || "🌎" : "🌎"
      };
    }

    function updatePhoneCountryDisplay() {
      const selected = getSelectedPhoneCountry();
      if (phoneCountryFlag) phoneCountryFlag.textContent = selected.flag || "🌎";
      if (phoneCountryLabel) phoneCountryLabel.textContent = selected.code || "+";
      phoneCountryOptions.forEach((option) => option.classList.toggle("active", option.dataset.code === selected.code && option.dataset.country === selected.country));
    }

    function setPhoneCountry(code, country, flag, touched = true) {
      if (!phoneCountryCode) return;
      phoneCountryCode.value = code || "";
      phoneCountryCode.dataset.country = country || "";
      phoneCountryCode.dataset.flag = flag || "🌎";
      if (touched) phoneCountryTouched = true;
      updatePhoneCountryDisplay();
      formatWhatsappPhone();
    }

    function normalizeLocalDigitsForCountry(code, localDigits) {
      const codeDigits = digitsOnly(code);
      let digits = String(localDigits || "");
      if (digits.startsWith(codeDigits)) digits = digits.slice(codeDigits.length);
      if (["+593", "+57", "+52", "+56", "+54", "+51", "+58", "+503", "+502", "+504", "+505", "+506", "+507", "+591", "+595", "+598", "+34"].includes(code) && digits.startsWith("0")) {
        digits = digits.slice(1);
      }
      return digits;
    }

    function normalizePhoneE164() {
      const code = phoneCountryCode ? phoneCountryCode.value : "";
      if (!phoneInput || !code) return phoneInput ? phoneInput.value.trim() : "";
      const localDigits = normalizeLocalDigitsForCountry(code, digitsOnly(phoneInput.value));
      return localDigits ? `${code}${localDigits}` : "";
    }

    function groupDigits(digits, groups) {
      const parts = [];
      let cursor = 0;
      groups.forEach((length) => {
        if (digits.length > cursor) parts.push(digits.slice(cursor, cursor + length));
        cursor += length;
      });
      if (digits.length > cursor) parts.push(digits.slice(cursor));
      return parts.filter(Boolean).join(" ");
    }

    function formatWhatsappPhone() {
      if (!phoneInput || !phoneCountryCode) return;
      const code = phoneCountryCode.value;
      if (!code) return;
      const localDigits = normalizeLocalDigitsForCountry(code, digitsOnly(phoneInput.value));
      if (!localDigits) return;

      let formatted = "";
      if (code === "+1" && localDigits.length >= 10) formatted = `${code} (${localDigits.slice(0, 3)}) ${localDigits.slice(3, 6)}-${localDigits.slice(6, 10)}`;
      else if (code === "+593") formatted = `${code} ${groupDigits(localDigits, [2, 3, 4])}`;
      else if (code === "+57") formatted = `${code} ${groupDigits(localDigits, [3, 3, 4])}`;
      else if (code === "+52") formatted = `${code} ${groupDigits(localDigits, [2, 4, 4])}`;
      else if (code === "+56") formatted = `${code} ${groupDigits(localDigits, [1, 4, 4])}`;
      else if (code === "+54") formatted = `${code} ${groupDigits(localDigits, [1, 2, 4, 4])}`;
      else if (code === "+51") formatted = `${code} ${groupDigits(localDigits, [3, 3, 3])}`;
      else if (["+503", "+502", "+504", "+505", "+506", "+507", "+591", "+595", "+598"].includes(code)) formatted = `${code} ${groupDigits(localDigits, [3, 3, 3, 3])}`;
      else if (code === "+34") formatted = `${code} ${groupDigits(localDigits, [3, 3, 3])}`;
      else formatted = `${code} ${localDigits}`;

      phoneInput.value = formatted.trim();
    }

    function togglePhoneCountryMenu(forceOpen) {
      if (!phoneCountryMenu || !phoneCountryTrigger) return;
      const shouldOpen = typeof forceOpen === "boolean" ? forceOpen : phoneCountryMenu.hidden;
      phoneCountryMenu.hidden = !shouldOpen;
      phoneCountryTrigger.setAttribute("aria-expanded", String(shouldOpen));
    }

    function syncPhoneCountryFromResidence() {
      if (!countryResidence || !phoneCountryCode || phoneCountryTouched) return;
      const selectedCountry = countryResidence.value;
      if (!selectedCountry) return;
      const option = phoneCountryOptions.find((item) => item.dataset.country === selectedCountry);
      if (option) setPhoneCountry(option.dataset.code, option.dataset.country, option.dataset.flag, false);
    }

    function safeNumber(value) {
      if (value === null || value === undefined || value === "") return 0;
      if (typeof value === "number") return Number.isFinite(value) ? value : 0;
      const cleaned = String(value)
        .replace(/[^0-9.,-]/g, "")
        .replace(/,/g, "");
      const number = Number(cleaned);
      return Number.isFinite(number) ? number : 0;
    }

    function toArray(value) {
      if (!value) return [];
      return Array.isArray(value) ? value : [value];
    }

    function estimateReferenceValue(data) {
      if (data.loanType === "Compra de vivienda" || data.loanType === "No estoy seguro") {
        return safeNumber(data.estimatedPurchasePrice);
      }
      return safeNumber(data.currentPropertyValue);
    }

    function estimateLoanAmount(data) {
      if (data.loanType === "Compra de vivienda" || data.loanType === "No estoy seguro") return getPurchaseEstimates(data).loanAmount;
      if (data.loanType === "Refinanciar") return safeNumber(data.currentMortgageBalance);
      if (data.loanType === "Retiro de dinero / Cash-out") return safeNumber(data.currentMortgageBalance) + safeNumber(data.cashOutAmount);
      return 0;
    }

    function estimateLTV(data) {
      const loan = estimateLoanAmount(data);
      if (data.loanType === "Compra de vivienda" || data.loanType === "No estoy seguro") {
        const value = safeNumber(data.estimatedPurchasePrice);
        return value && loan ? Math.round((loan / value) * 100) : null;
      }
      const value = safeNumber(data.currentPropertyValue);
      return value && loan ? Math.round((loan / value) * 100) : null;
    }

    function estimateDTI(data) {
      const monthlyIncome = safeNumber(data.monthlyIncome);
      const monthlyDebt = safeNumber(data.monthlyDebt);
      const loan = estimateLoanAmount(data);
      if (!monthlyIncome) return null;
      if (!loan) return Math.round((monthlyDebt / monthlyIncome) * 100);
      const roughMonthlyMortgage = Math.round(loan * 0.0072);
      return Math.round(((monthlyDebt + roughMonthlyMortgage) / monthlyIncome) * 100);
    }

    function estimateDSCR(data) {
      const rent = safeNumber(data.estimatedRent);
      const loan = estimateLoanAmount(data);
      if (data.propertyUse !== "Propiedad de inversión") return "No aplica";
      if (!rent || !loan) return "Pendiente de revisión";
      const payment = Math.round(loan * 0.0072);
      return payment ? (rent / payment).toFixed(2) : "Pendiente de revisión";
    }

    function classifyLead(data) {
      let score = 0;
      const flags = [];
      const employmentTypes = toArray(data.employmentType);
      const fundsOperation = toArray(data.fundsAvailableOperation);
      const identificationTypes = toArray(data.identificationType);

      if (["Inmediatamente, contrato firmado", "En cuanto sea posible, oferta pendiente", "Dentro de 30 días"].includes(data.purchaseTimeline)) score += 25;
      if (["Hoy", "Mañana"].includes(data.contactTiming)) score += 20;
      if (["Sí, están disponibles", "Parcialmente"].includes(data.fundsAvailable) || fundsOperation.length > 0) score += 20;
      if (employmentTypes.length > 0 && safeNumber(data.monthlyIncome) > 0) score += 15;
      if (data.incomeDocumentation && !["No estoy seguro"].includes(data.incomeDocumentation)) score += 10;
      if (data.hasRealtor === "Sí") score += 10;
      if (data.propertySelected === "Sí, tengo dirección") score += 10;

      const isForeignNational = data.countryResidence !== "Estados Unidos" ||
        data.usStatus === "Vivo fuera de EE. UU. y compraré como extranjero" ||
        identificationTypes.some((item) => ["Pasaporte", "Pasaporte + ITIN", "Visa"].includes(item));

      const ltv = estimateLTV(data);
      const dti = estimateDTI(data);
      const dscr = estimateDSCR(data);

      if (isForeignNational) flags.push({ text: "Foreign national / comprador extranjero", type: "warn" });
      if (data.borrowerEntity === "LLC") flags.push({ text: "Revisión a nombre de LLC", type: "warn" });
      if (data.propertyUse === "Propiedad de inversión") flags.push({ text: "Ruta inversión / posible DSCR", type: "ok" });
      if (identificationTypes.includes("Pasaporte") || identificationTypes.includes("Pasaporte + ITIN")) flags.push({ text: "Revisión de identificación y crédito", type: "warn" });
      if (fundsOperation.includes("Efectivo") || fundsOperation.includes("Criptomonedas")) flags.push({ text: "Validar trazabilidad de fondos", type: "danger" });
      if (data.creditEvents && data.creditEvents !== "No") flags.push({ text: "Revisión manual de eventos crediticios", type: "danger" });
      if (ltv !== null && ltv > 80) flags.push({ text: "LTV alto: revisar producto", type: "warn" });
      if (dti !== null && dti > 45) flags.push({ text: "DTI referencial alto", type: "warn" });
      if (data.incomeDocumentation === "Sí, con estados bancarios") flags.push({ text: "Posible bank statement loan", type: "ok" });

      let status = "Lead educativo / nurturing";
      if (score >= 70) status = "Lead caliente";
      else if (score >= 45) status = "Lead activo";
      else if (isForeignNational) status = "Lead foreign national en revisión";

      let suggestedRoute = "Revisión inicial con asesor hipotecario";
      if (data.propertyUse === "Propiedad de inversión") suggestedRoute = "Revisión de inversión / DSCR";
      if (isForeignNational) suggestedRoute = "Revisión foreign national / non-QM";
      if (data.incomeDocumentation === "Sí, con estados bancarios") suggestedRoute = "Revisión bank statement / non-QM";
      if (data.creditEvents && data.creditEvents !== "No") suggestedRoute = "Revisión manual con mortgage professional";

      return { score, status, suggestedRoute, flags, ltv, dti, dscr };
    }

    function buildPayload() {
      const data = getFormData();
      const classification = classifyLead(data);
      const employmentTypes = toArray(data.employmentType);
      const fundsOperation = toArray(data.fundsAvailableOperation);
      const identificationTypes = toArray(data.identificationType);
      const purchaseEstimates = getPurchaseEstimates(data);
      const submittedAt = new Date().toISOString();

      return {
        metadata: {
          formName: "Precalificación hipotecaria Florida",
          formVersion: "v9",
          source: "wizard_precalificacion_mortgage_florida_v9",
          submittedAt,
          pageUrl: window.location.href,
          userAgent: navigator.userAgent
        },
        contacto: {
          nombre: data.firstName || "",
          apellido: data.lastName || "",
          correo: data.email || "",
          codigoPaisTelefono: data.phoneCountryCode || "",
          telefono: data.phone || "",
          telefonoWhatsAppE164: normalizePhoneE164(),
          paisResidencia: data.countryResidence || "",
          idiomaPreferido: data.preferredLanguage || ""
        },
        solicitudPrestamo: {
          tipoPrestamo: data.loanType || "",
          objetivoPrincipal: data.mainGoal || "",
          momentoContacto: data.contactTiming || ""
        },
        compraVivienda: {
          plazoCompra: data.purchaseTimeline || "",
          trabajaConRealtor: data.hasRealtor || "",
          nombreRealtor: data.realtorName || "",
          contactoRealtor: data.realtorContact || "",
          propiedadSeleccionada: data.propertySelected || "",
          direccionCompra: data.purchaseAddress || "",
          ciudadZonaObjetivo: data.targetCity || "",
          valorEstimadoCompra: safeNumber(data.estimatedPurchasePrice),
          entrada30Porciento: purchaseEstimates.downPayment,
          montoCredito70Porciento: purchaseEstimates.loanAmount,
          costosCierre4Porciento: purchaseEstimates.closingCosts,
          reserva12Cuotas: purchaseEstimates.reserve12,
          fondosAproximadosRequeridos: purchaseEstimates.requiredFunds,
          fondosDisponiblesPagoInicial: data.fundsAvailable || "",
          paisFondos: data.fundsCountry || ""
        },
        refinanciamientoCashOut: {
          direccionPropiedadActual: data.currentPropertyAddress || "",
          valorActualPropiedad: safeNumber(data.currentPropertyValue),
          saldoHipotecaActual: safeNumber(data.currentMortgageBalance),
          pagoMensualActual: safeNumber(data.currentMonthlyPayment),
          tasaActual: data.currentRate || "",
          montoRetiroSolicitado: safeNumber(data.cashOutAmount)
        },
        propiedad: {
          tipoPropiedad: data.propertyType || "",
          usoPropiedad: data.propertyUse || "",
          rentaMensualEstimada: safeNumber(data.estimatedRent)
        },
        perfilMigratorioYComprador: {
          ciudadanoEstadounidense: data.usCitizen || "",
          situacionFrenteEEUU: data.usStatus || "",
          documentacionDisponible: identificationTypes,
          visaVigente: data.hasVisa || "",
          notaVisa: "La visa se solicita únicamente con fines informativos y no como requisito obligatorio para la evaluación preliminar.",
          entidadCompradora: data.borrowerEntity || ""
        },
        ingresos: {
          actividadLaboralPrincipal: employmentTypes,
          paisOrigenIngresos: data.incomeCountry || "",
          ingresoMensualBruto: safeNumber(data.monthlyIncome),
          documentacionIngresos: data.incomeDocumentation || "",
          antiguedadLaboralNegocio: data.workHistory || ""
        },
        activosFondosYReservas: {
          fondosDisponiblesOperacion: fundsOperation,
          reservasPosterioresCierre: data.reservesMonths || ""
        },
        creditoYDeudas: {
          deudaMensualAproximada: safeNumber(data.monthlyDebt),
          eventosCrediticiosPrevios: data.creditEvents || ""
        },
        propiedadesActuales: {
          poseePropiedades: data.ownsProperty || "",
          cantidadPropiedades: safeNumber(data.propertyCount),
          ingresosPorRenta: safeNumber(data.rentalIncome)
        },
        consentimientoYCierre: {
          consentimientoContacto: data.consent === "Acepto",
          textoConsentimiento: data.consent || "",
          notaProteccionDatos: "La información será utilizada únicamente para evaluación preliminar y contacto de asesoría, y será tratada de forma confidencial."
        },
        calculosPreliminares: {
          valorReferenciaPropiedad: estimateReferenceValue(data),
          entrada30Porciento: purchaseEstimates.downPayment,
          montoCredito70Porciento: purchaseEstimates.loanAmount,
          costosCierre4Porciento: purchaseEstimates.closingCosts,
          reserva12Cuotas: purchaseEstimates.reserve12,
          fondosAproximadosRequeridos: purchaseEstimates.requiredFunds,
          montoPrestamoEstimado: estimateLoanAmount(data),
          ltvEstimado: classification.ltv,
          dtiReferencial: classification.dti,
          dscrEstimado: classification.dscr,
          notaCalculos: "Los cálculos son referenciales. Para compra, se estima entrada 30%, crédito 70%, costos de cierre 4% y reserva de 12 cuotas. Los montos finales deben ser validados por el lender o mortgage professional."
        },
        clasificacionLead: {
          puntaje: classification.score,
          estado: classification.status,
          rutaSugerida: classification.suggestedRoute,
          alertas: classification.flags
        },
        rawFormData: data
      };
    }

    function metricText(value, suffix = "") {
      if (value === null || value === undefined || value === "") return "Pendiente de revisión";
      if (typeof value === "number" && value === 0) return "Pendiente de revisión";
      return `${value}${suffix}`;
    }

    function renderSummary(payload) {
      const classification = payload.clasificacionLead;
      const calculations = payload.calculosPreliminares;
      const contact = payload.contacto;
      const loanRequest = payload.rawFormData;
      const loanMetric = calculations.montoPrestamoEstimado ? currency(calculations.montoPrestamoEstimado) : "Pendiente de revisión";
      const ltvMetric = calculations.ltvEstimado === null ? "Pendiente de revisión" : `${calculations.ltvEstimado}%`;
      const dtiMetric = calculations.dtiReferencial === null ? "Pendiente de revisión" : `${calculations.dtiReferencial}%`;

      summaryCard.hidden = false;
      leadSummary.innerHTML = `
        <p><strong>${contact.nombre || "Solicitante"} ${contact.apellido || ""}</strong>, tu diagnóstico quedó clasificado como <strong>${classification.estado}</strong>.</p>
        <p>Ruta sugerida: <strong>${classification.rutaSugerida}</strong>. Un asesor debe validar ingresos, fondos, identificación, propiedad, crédito aplicable y condiciones del lender.</p>
      `;
      metricsGrid.innerHTML = `
        <div class="metric"><small>Valor referencia propiedad</small><strong>${currency(calculations.valorReferenciaPropiedad)}</strong></div>
        <div class="metric"><small>Entrada 30%</small><strong>${currencyZero(calculations.entrada30Porciento)}</strong></div>
        <div class="metric"><small>Monto crédito 70%</small><strong>${loanMetric}</strong></div>
        <div class="metric"><small>Costos cierre 4%</small><strong>${currencyZero(calculations.costosCierre4Porciento)}</strong></div>
        <div class="metric"><small>Reserva 12 cuotas</small><strong>${currencyZero(calculations.reserva12Cuotas)}</strong></div>
        <div class="metric"><small>Fondos aproximados</small><strong>${currencyZero(calculations.fondosAproximadosRequeridos)}</strong></div>
        <div class="metric"><small>LTV estimado</small><strong>${ltvMetric}</strong></div>
        <div class="metric"><small>DTI referencial</small><strong>${dtiMetric}</strong></div>
        <div class="metric"><small>DSCR estimado</small><strong>${calculations.dscrEstimado}</strong></div>
        <div class="metric"><small>Tipo préstamo</small><strong>${loanRequest.loanType || "No informado"}</strong></div>
      `;
      pillRow.innerHTML = classification.alertas.length
        ? classification.alertas.map(flag => `<span class="pill ${flag.type}">${flag.text}</span>`).join("")
        : `<span class="pill ok">Sin alertas críticas iniciales</span>`;
      if (submissionStatus) {
        submissionStatus.hidden = false;
        submissionStatus.className = "submission-status";
        submissionStatus.innerHTML = `<strong>Diagnóstico preparado</strong>Estamos enviando tu información para que un asesor pueda revisar el caso.`;
      }
    }

    async function sendPayload(payload) {
      const jsonBody = JSON.stringify(payload);

      // Intento principal: POST JSON normal.
      // Puede fallar por CORS si el dominio del formulario y el dominio de n8n no permiten preflight OPTIONS.
      try {
        const response = await fetch(WEBHOOK_URL, {
          method: "POST",
          mode: "cors",
          credentials: "omit",
          keepalive: true,
          headers: { "Content-Type": "application/json" },
          body: jsonBody
        });
        if (!response.ok) throw new Error(`Webhook respondió con estado ${response.status}`);
        const responsePayload = await response.json().catch(() => ({ ok: true }));
        return { ok: true, confirmed: true, method: "cors-json", response: responsePayload };
      } catch (primaryError) {
        console.warn("Envío JSON con CORS falló. Se intentará envío alternativo sin lectura de respuesta.", primaryError);
      }

      // Fallback 1: sendBeacon. Evita el bloqueo visual por CORS y es útil para webhooks simples.
      // En n8n el body puede llegar como texto; si llega así, parsear con JSON.parse en un nodo Code.
      if (navigator.sendBeacon) {
        const blob = new Blob([jsonBody], { type: "text/plain;charset=UTF-8" });
        const queued = navigator.sendBeacon(WEBHOOK_URL, blob);
        if (queued) return { ok: true, confirmed: false, method: "sendBeacon-text" };
      }

      // Fallback 2: no-cors. El navegador no permite leer la respuesta, pero sí despacha el POST.
      try {
        await fetch(WEBHOOK_URL, {
          method: "POST",
          mode: "no-cors",
          credentials: "omit",
          keepalive: true,
          headers: { "Content-Type": "text/plain;charset=UTF-8" },
          body: jsonBody
        });
        return { ok: true, confirmed: false, method: "no-cors-text" };
      } catch (fallbackError) {
        throw new Error("No fue posible conectar con el webhook. Revisa que el workflow esté activo, que la URL sea de producción y que n8n permita recibir solicitudes externas.");
      }
    }

    currencyInputs.forEach((input) => {
      input.addEventListener("input", () => {
        if (input === estimatedPurchasePriceInput) updatePurchaseEstimatePanel();
      });
      input.addEventListener("blur", () => formatCurrencyInput(input));
      input.addEventListener("focus", () => {
        const value = safeNumber(input.value);
        input.value = value ? String(value) : "";
      });
    });

    if (countryResidence) {
      countryResidence.addEventListener("change", () => {
        syncPhoneCountryFromResidence();
        formatWhatsappPhone();
      });
    }

    if (phoneCountryTrigger) {
      phoneCountryTrigger.addEventListener("click", () => togglePhoneCountryMenu());
    }

    phoneCountryOptions.forEach((option) => {
      option.addEventListener("click", () => {
        setPhoneCountry(option.dataset.code, option.dataset.country, option.dataset.flag, true);
        togglePhoneCountryMenu(false);
        if (phoneInput) phoneInput.focus();
      });
    });

    document.addEventListener("click", (event) => {
      const combo = document.querySelector("[data-phone-combo]");
      if (combo && !combo.contains(event.target)) togglePhoneCountryMenu(false);
    });

    if (phoneInput) {
      phoneInput.addEventListener("blur", formatWhatsappPhone);
      phoneInput.addEventListener("input", () => {
        const code = phoneCountryCode ? phoneCountryCode.value : "";
        if (phoneInput.value.trim().startsWith("+")) formatWhatsappPhone();
        if (code && digitsOnly(phoneInput.value).startsWith(digitsOnly(code))) formatWhatsappPhone();
      });
    }

    updatePhoneCountryDisplay();
    updatePurchaseEstimatePanel();

    form.addEventListener("input", updateConditionalFields);
    form.addEventListener("change", updateConditionalFields);

    stepButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const target = Number(button.dataset.stepTarget);
        if (target <= currentStep || validateCurrentStep()) goToStep(target);
      });
    });

    prevBtn.addEventListener("click", () => goToStep(currentStep - 1));

    nextBtn.addEventListener("click", () => {
      if (!validateCurrentStep()) return;
      goToStep(currentStep + 1);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validateCurrentStep()) return;
      const payload = buildPayload();
      renderSummary(payload);
      submitBtn.textContent = "Enviando diagnóstico...";
      submitBtn.disabled = true;
      try {
        const sendResult = await sendPayload(payload);
        submitBtn.textContent = sendResult.confirmed ? "Diagnóstico enviado" : "Diagnóstico enviado para revisión";
        if (submissionStatus) {
          submissionStatus.hidden = false;
          submissionStatus.className = "submission-status ok";
          submissionStatus.innerHTML = sendResult.confirmed
            ? `<strong>Información enviada correctamente</strong>Recibimos la precalificación inicial. Un asesor podrá revisar los antecedentes y contactarte para continuar con la validación.`
            : `<strong>Información enviada</strong>El diagnóstico fue despachado al webhook. Por seguridad del navegador no se pudo leer la confirmación del servidor; valida la recepción en las ejecuciones de n8n.`;
        }
      } catch (error) {
        submitBtn.textContent = "Reintentar envío";
        submitBtn.disabled = false;
        if (submissionStatus) {
          submissionStatus.hidden = false;
          submissionStatus.className = "submission-status fail";
          submissionStatus.innerHTML = `<strong>No se pudo enviar automáticamente</strong>El diagnóstico fue generado, pero no se logró conectar con el webhook. Revisa la URL productiva, el estado del workflow y la configuración CORS de n8n.`;
        }
        showError("No se pudo enviar al webhook. Revisa n8n y vuelve a intentar.");
      }
    });

    updateConditionalFields();
    updatePurchaseEstimatePanel();
    goToStep(0);
  </script>
</body>
</html>
