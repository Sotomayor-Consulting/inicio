    function readValue(id) { return document.getElementById(id)?.value || ""; }
    function formatPhoneE164(phoneRaw, countryCode) {
      const raw = String(phoneRaw || "").trim();
      if (raw.startsWith("+")) return "+" + raw.replace(/[^\d]/g, "");
      let digits = raw.replace(/\D/g, "");
      digits = digits.replace(/^0+/, "");
      return `${countryCode}${digits}`;
    }
    function isValidE164(phone) { return /^\+[1-9]\d{7,14}$/.test(phone); }
    function isValidEmail(email) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email); }
    function sanitizeText(value) { return String(value || "").replace(/[<>]/g, "").replace(/\s+/g, " ").trim(); }
    function sanitizeEmail(value) { return sanitizeText(value).toLowerCase(); }
    function sanitizePhoneRaw(value) { return String(value || "").replace(/[^\d+\s().-]/g, "").trim(); }
    function clearErrors(root = document) { root.querySelectorAll(".error").forEach((element) => { element.textContent = ""; }); }
    function showErrors(root, errors) { Object.entries(errors).forEach(([field, message]) => { const target = root.querySelector(`[data-error-for="${field}"]`); if (target) target.textContent = message; }); }
    function showState(element) { if (element) element.classList.add("visible"); }
    function hideStates(elements = []) { elements.forEach((element) => element?.classList.remove("visible")); }

    function setButtonLoading(button, isLoading, label) {
      if (!button) return;
      button.disabled = isLoading;
      button.textContent = label;
    }

    async function sha256(value) {
      if (!window.crypto?.subtle) return "";
      const encoder = new TextEncoder();
      const data = encoder.encode(value);
      const hashBuffer = await crypto.subtle.digest("SHA-256", data);
      return Array.from(new Uint8Array(hashBuffer)).map((byte) => byte.toString(16).padStart(2, "0")).join("");
    }

    function bindProcessInteractions() {
      const processSteps = Array.from(document.querySelectorAll('.process-step'));
      const processPanelStep = document.getElementById('process-panel-step');
      const processPanelTitle = document.getElementById('process-panel-title');
      const processPanelBody = document.getElementById('process-panel-body');
      const processPanelList = document.getElementById('process-panel-list');
      processSteps.forEach((button) => {
        button.addEventListener('click', () => {
          processSteps.forEach((item) => { item.classList.remove('is-active'); item.setAttribute('aria-selected', 'false'); });
          button.classList.add('is-active');
          button.setAttribute('aria-selected', 'true');
          const step = button.dataset.processStep || '1';
          const time = button.dataset.time || '';
          const title = button.dataset.title || '';
          const body = button.dataset.body || '';
          const bullets = (button.dataset.bullets || '').split('|').filter(Boolean);
          if (processPanelStep) processPanelStep.textContent = 'Paso ' + String(step).padStart(2, '0') + (time ? ' · ' + time : '');
          if (processPanelTitle) processPanelTitle.textContent = title;
          if (processPanelBody) processPanelBody.textContent = body;
          if (processPanelList) processPanelList.innerHTML = bullets.map((item) => '<li>' + item + '</li>').join('');
          trackEvent('process_step_viewed', { ...getBaseTrackingPayload(), process_step: step, process_title: title });
        });
      });

      const scrollProcess = document.getElementById("scroll-process");
      const scrollSteps = Array.from(document.querySelectorAll(".scroll-step"));
      let lastActiveScrollStep = "1";
      function updateScrollProcess() {
        if (!scrollProcess || !scrollSteps.length) return;
        const rect = scrollProcess.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const start = viewportHeight * 0.68;
        const end = -rect.height + viewportHeight * 0.34;
        const rawProgress = (start - rect.top) / (start - end);
        const progress = Math.max(0, Math.min(1, rawProgress));
        scrollProcess.style.setProperty("--process-progress", progress.toFixed(4));
        const focusLine = viewportHeight * 0.48;
        let closestStep = scrollSteps[0];
        let closestDistance = Infinity;
        scrollSteps.forEach((step) => {
          const stepRect = step.getBoundingClientRect();
          const stepCenter = stepRect.top + stepRect.height / 2;
          const distance = Math.abs(stepCenter - focusLine);
          if (distance < closestDistance) { closestDistance = distance; closestStep = step; }
        });
        scrollSteps.forEach((step) => step.classList.toggle("is-active", step === closestStep));
        const activeStep = closestStep?.dataset.scrollStep || "1";
        if (activeStep !== lastActiveScrollStep) {
          lastActiveScrollStep = activeStep;
          trackEvent("process_scroll_step_viewed", { ...getBaseTrackingPayload(), process_step: activeStep });
        }
      }
      if (scrollProcess && scrollSteps.length) {
        updateScrollProcess();
        window.addEventListener("scroll", updateScrollProcess, { passive: true });
        window.addEventListener("resize", updateScrollProcess);
      }
    }
  </script>
</body>
</html>
