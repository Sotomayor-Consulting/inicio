                      />
                    </div>
                  </div>
                  <!-- Correo -->
                  <div>
                    <label for="profesion" class="sr-only"
                      >Profesión principal</label
                    >
                    <select
                      id="profesion"
                      name="profesion"
                      class="block w-full rounded-lg border-neutral-200 bg-neutral-50 px-4 py-3 pe-9 text-sm focus:border-[#ba8d34] focus:ring-[#ba8d34] disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-700 dark:text-white dark:placeholder:text-neutral-400 dark:focus:ring-neutral-600"
                      required
                    >
                      <option
                        value=""
                        disabled=""
                        selected=""
                        class="text-neutral-400"
                        >What is your main profession?</option
