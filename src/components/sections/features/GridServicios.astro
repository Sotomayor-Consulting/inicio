---
import { Image } from "astro:assets";
import ImagenMock from "@images/mockup.avif";

interface Props {
  title: string;
  description: string;
  link: string;
  grid2: string;
  grid3: string;
  grid3link: string;
  grid4: string;
  grid4link: string;
}

const { grid4, grid4link, grid3, grid3link, grid2, title, description, link } = Astro.props;
