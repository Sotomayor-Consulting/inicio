                      >
                      <option value="Tax advisor"
                        >Tax advisor</option
                      >
                      <option value="Business consultant"
                        >Business consultant</option
                      >
                      <option value="Family office / Wealth manager"
                        >Family office / Wealth manager</option
                      >
                      <option value="Other">Other</option>
                    </select>
                  </div>
                  <!-- Teléfono -->
                  <div>
                    <label
                      for="País_y_ciudad_de_residencia_profesional"
                      class="sr-only">Teléfono</label
                    >
                    <input
                      type="text"
                      name="País_y_ciudad_de_residencia_profesional"
                      id="País_y_ciudad_de_residencia_profesional"
                      required=""
                      placeholder="Country and city of professional residence"
                      class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-black focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700 dark:text-white dark:placeholder:text-neutral-400 dark:focus:ring-1"
                    />
                  </div>
                  <!-- País de visado -->
