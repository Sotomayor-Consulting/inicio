              <input id="currentMonthlyPayment" name="currentMonthlyPayment" type="number" min="0" max="500000" step="50" inputmode="decimal" placeholder="Pago mensual actual" />
            </div>

            <div class="field" data-show-if="loanType=Refinanciar|loanType=Retiro de dinero / Cash-out">
