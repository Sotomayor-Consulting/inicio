            <div class="field" data-show-if="loanType=Refinanciar|loanType=Retiro de dinero / Cash-out">
              <label for="currentPropertyValue">Valor actual estimado</label>
              <input id="currentPropertyValue" name="currentPropertyValue" type="number" min="0" max="25000000" step="1000" inputmode="decimal" placeholder="Valor actual aproximado" />
            </div>

            <div class="field" data-show-if="loanType=Refinanciar|loanType=Retiro de dinero / Cash-out">
              <label for="currentMortgageBalance">Saldo actual de hipoteca</label>
              <input id="currentMortgageBalance" name="currentMortgageBalance" type="number" min="0" max="25000000" step="1000" inputmode="decimal" placeholder="Saldo pendiente aproximado" />
            </div>

            <div class="field" data-show-if="loanType=Refinanciar|loanType=Retiro de dinero / Cash-out">
