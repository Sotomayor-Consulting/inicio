---
// Import the necessary dependencies
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import VideoHero from "@images/Video-hero.webm";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Define props from Astro
const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  titleslide2,
  descriptionslide2,
  dabgeslide3,
  tituloslide3,
  descriptionslide3,
  button1slide3,
  button2slide3
} = Astro.props;

// Define TypeScript interface for props
interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
  src?: any;
  alt?: string;
  titleslide2: string;
  descriptionslide2: string;
  dabgeslide3: string;
  tituloslide3: string;
  descriptionslide3: string;
  button1slide3: string;
  button2slide3: string;
}

const listaEs = [ "Acompañamiento y Seguridad", "Blindaje Legal y Fiscal", "Diseño Estratégico a Medida"]
const ListaEn = ["Support and Security", "Legal and Tax Protection", "Custom Strategic Design"]
const ListaPr = ["Acompanhamento e Segurança", "Proteção Legal e Fiscal", "Design Estratégico Personalizado"]


const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en");
const isPortuguese = pathname.startsWith("/pr");

const Lista = isEnglish ? ListaEn : isPortuguese ? ListaPr : listaEs;
---

<section
  class="mx-auto grid h-180 w-full gap-4 px-4 py-14 sm:px-6 md:items-center md:gap-8 lg:px-8 2xl:max-w-full relative"
>
  <video
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 -z-10 h-full w-full rounded-2xl object-cover opacity-35"
    src={VideoHero}></video>

  <div
    id="hs-carousel"
    class="relative z-20 h-full"
    data-hs-carousel='{"loadingClasses": "opacity-0", "dotsItemClasses": "hs-carousel-active:bg-primary-active hs-carousel-active:border-primary-active size-3 border border-line-4 rounded-full cursor-pointer" , "isAutoPlay": true, "isInfiniteLoop": true}'
  >
    <div
      class="hs-carousel relative max-h-full min-h-full w-full overflow-hidden"
    >
      <!-- Carousel Body -->
      <div
        class="hs-carousel-body absolute start-0 top-0 bottom-0 flex flex-nowrap opacity-0 transition-transform duration-700"
      >
        <div class="hs-carousel-slide flex justify-center">
          <div class="flex w-full flex-col items-center justify-center">
            <div class="max-w-2xl">
              <h1
                class="block text-center text-3xl font-bold tracking-tight text-balance text-primario-black sm:text-5xl lg:leading-tight dark:text-neutral-200"
              >
                <!-- About Fragment: https://docs.astro.build/en/basics/astro-syntax/#fragments -->
                <Fragment set:html={title} />
              </h1>
              {
                subTitle && (
                  <p class="mt-3 text-center text-base leading-relaxed text-pretty text-primario-black md:text-lg dark:text-neutral-200">
                    {subTitle}
                  </p>
                )
              }
            </div>
            <div class="mt-7 flex w-fit gap-3 sm:inline-flex">
              {
                primaryBtn && (
                  <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />
                )
              }
              {
                secondaryBtn && (
                  <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />
                )
              }
            </div>
          </div>
        </div>
        <div class="hs-carousel-slide">
          <div class="bg-surface-1 flex h-full w-full justify-center">
            <!-- Features -->
            <div
              class="mx-auto flex max-w-340 items-center justify-center px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
            >
              <!-- Grid -->
              <div class="flex lg:items-center lg:gap-16">
                <div class="mt-5 sm:mt-10 lg:mt-0">
                  <div class="space-y-6 sm:space-y-8">
                    <!-- Title -->
                    <div class="space-y-2 md:space-y-4">
                      <h2
                        class="text-3xl font-bold text-primario-black lg:text-4xl dark:text-white"
                      >
                        {titleslide2}
                      </h2>
                      <p class="text-primario-black dark:text-neutral-300">
                        {descriptionslide2}
                      </p>
                    </div>
                    <!-- End Title -->

                    <!-- List -->
                    <ul class="space-y-2 sm:space-y-4">
                      {
                        Lista.map((li) => (
                          <li class="flex gap-x-3">
                            <span class="dark:bg-primary-500/20 dark:text-primary-200 mt-0.5 flex size-5 items-center justify-center rounded-full bg-secundario text-white dark:bg-secundario dark:text-white">
                              <Icon
                                name="mingcute:check-line"
                                class="size-3.5 shrink-0"
                              />
                            </span>
                            <div class="grow">
                              <span class="text-sm text-primario-black sm:text-base dark:text-neutral-200">
                                {li}
                              </span>
                            </div>
                          </li>
                        ))
                      }
                    </ul>
                    <!-- End List -->
                  </div>
                </div>
                <div>
                  <Image
                    class="hidden h-full rounded-xl md:block"
                    src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    alt="Una descripción de mi imagen."
                    inferSize={true}
                    loading="eager"
                  />
                </div>
              </div>
              <!-- End Grid -->
            </div>
            <!-- End Features -->
          </div>
        </div>
        <div class="hs-carousel-slide">
          <div class="bg-surface-2 flex h-full w-full justify-center">
            <!-- Hero -->
            <div class="relative w-full overflow-hidden">
              <div class="relative z-10">
                <div
                  class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-16"
                >
                  <div class="mx-auto max-w-full text-center md:max-w-2xl">
                    <p
                      class="dark:from-primary-400 inline-block bg-linear-to-tl from-primario-black to-secundario bg-clip-text text-sm font-medium text-transparent dark:to-secundario dark:from-white"
                    >
                      {dabgeslide3}
                    </p>

                    <!-- Title -->
                    <div class="mt-5 max-w-full md:max-w-2xl">
                      <h1
                        class="block text-3xl font-semibold text-primario-black md:text-5xl lg:text-6xl dark:text-white"
                      >
                        {tituloslide3}
                      </h1>
                    </div>
                    <!-- End Title -->

                    <div class="mt-5 max-w-full md:max-w-3xl">
                      <p class="text-lg text-primario-black dark:text-neutral-200">
                        {descriptionslide3}
                      </p>
                    </div>

                    <!-- Buttons -->
                    <div class="mt-8 flex justify-center gap-3">
                      <a
                        class="inline-flex items-center gap-x-2 rounded-lg bg-secundario px-4 py-3 text-sm font-medium text-white hover:bg-secundario/90 focus:bg-secundario/30 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                        href="#evaluacion"
                      >
                        {button1slide3}
                        <svg
                          class="size-4 shrink-0"
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="m9 18 6-6-6-6"></path></svg
                        >
                      </a>
                      <a
                        class="focus:bg-muted-hover inline-flex items-center gap-x-2 rounded-lg border border-transparent bg-neutral-600 px-4 py-3 text-sm font-medium text-white hover:bg-neutral-500 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                        target="_blank"
                        href="https://zcal.co/t/agendar-asesoria-llc/60min"
                      >
                        <Icon
                          name="mingcute:camcorder-fill"
                          class="size-4 shrink-0 hidden md:block"
                        />
                        {button2slide3}
                      </a>
                    </div>
                    <!-- End Buttons -->
                  </div>
                </div>
              </div>
            </div>
            <!-- End Hero -->
          </div>
        </div>
      </div>
      <!-- End Carousel Body -->
    </div>

    <!-- Arrows -->
    <button
      type="button"
      class="hs-carousel-prev hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default text-layer-foreground hover:bg-layer-hover absolute start-1 top-1/2 -left-55 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full dark:bg-white bg-primario-black shadow-2xs focus:outline-hidden xl:inline-flex text-white dark:text-primario-black hover:scale-105 transition-all delay-100"
    >
      <span class="text-2xl" aria-hidden="true">
        <svg
          class="size-5 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </span>
      <span class="sr-only">Previous</span>
    </button>
    <button
      type="button"
      class="hs-carousel-next hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default text-layer-foreground hover:bg-layer-hover absolute end-2 top-1/2 -right-55 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full dark:bg-white bg-primario-black shadow-2xs focus:outline-hidden xl:inline-flex text-white dark:text-primario-black hover:scale-105 transition-all delay-100"
    >
      <span class="sr-only">Next</span>
      <span class="text-2xl" aria-hidden="true">
        <svg
          class="size-5 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </span>
    </button>
    <!-- End Arrows -->

    <div
      class="hs-carousel-pagination absolute start-0 end-0 bottom-0 flex justify-center gap-x-2"
    >
    </div>
    <!-- End Pagination -->
  </div>
</section>
