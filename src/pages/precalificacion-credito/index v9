                <label class="option-card"><input type="radio" name="propertyUse" value="Residencia primaria" required /> Residencia primaria</label>
                <label class="option-card"><input type="radio" name="propertyUse" value="Casa de vacaciones" required /> Casa de vacaciones</label>
                <label class="option-card"><input type="radio" name="propertyUse" value="Propiedad de inversión" required /> Propiedad de inversión</label>
