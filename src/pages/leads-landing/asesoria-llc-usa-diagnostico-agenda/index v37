    /* =========================================================
      V11 · Scroll process inspirado en Doola
      - Línea vertical que se completa según scroll.
      - Pasos amplios, limpios, sin tarjetas estrechas.
      - Activación automática del paso más visible.
    ========================================================== */
    .scroll-process-section {
      background:
        radial-gradient(circle at 10% 4%, rgba(217,164,65,.10), transparent 28%),
        linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .process-intro {
      margin-bottom: clamp(38px, 6vw, 70px);
    }

    .scroll-process {
      --process-progress: 0;
      position: relative;
      max-width: 1060px;
      margin: 0 auto;
      padding: 6px 0 12px;
    }

    .process-track {
      position: absolute;
      left: 39.5%;
      top: 20px;
      bottom: 20px;
      width: 68px;
      transform: translateX(-50%);
      pointer-events: none;
      z-index: 0;
    }

    .process-track-base,
    .process-track-fill {
      position: absolute;
      left: 50%;
      top: 0;
      width: 2px;
      transform: translateX(-50%);
      border-radius: 999px;
    }

    .process-track-base {
      bottom: 0;
      background: linear-gradient(180deg, rgba(226,232,240,.20), rgba(203,213,225,.95), rgba(226,232,240,.20));
    }

    .process-track-fill {
      height: calc(var(--process-progress) * 100%);
      background: linear-gradient(180deg, var(--gold), #f2c96d);
      box-shadow: 0 0 0 4px rgba(217,164,65,.08), 0 10px 28px rgba(217,164,65,.18);
      transition: height .12s linear;
    }

    .scroll-step {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(220px, .78fr) 68px minmax(0, 1.22fr);
      gap: clamp(18px, 3vw, 34px);
      align-items: center;
      min-height: 260px;
      margin-bottom: clamp(38px, 6vw, 78px);
    }

    .scroll-step:last-child {
      margin-bottom: 0;
    }

    .step-left {
      text-align: right;
      align-self: center;
      padding-right: 2px;
    }

    .step-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 7px 12px;
      border-radius: 10px;
      background: #f1f5f9;
      color: var(--muted);
      font-size: 13px;
      font-weight: 850;
      line-height: 1;
      margin-bottom: 16px;
      transition: .24s ease;
    }

    .step-left h3 {
      margin: 0;
      color: var(--ink);
      font-size: clamp(25px, 3vw, 38px);
      line-height: 1.04;
      letter-spacing: -.048em;
      max-width: 380px;
      margin-left: auto;
      transition: color .24s ease, opacity .24s ease;
    }

    .step-node {
      width: 68px;
      height: 68px;
      display: grid;
      place-items: center;
      border-radius: 24px;
      background: #fff;
      color: var(--muted);
      border: 1px solid var(--line);
      box-shadow: 0 12px 28px rgba(15,23,42,.07);
      font-size: 15px;
      font-weight: 950;
      transition: .24s ease;
    }

    .step-card {
      background: #f6f8fb;
      border: 1px solid #e8edf4;
      border-radius: 32px;
      padding: clamp(26px, 4vw, 38px);
      min-height: 230px;
      display: grid;
      align-content: start;
      box-shadow: 0 12px 34px rgba(15,23,42,.045);
      transform: translateY(12px);
      opacity: .76;
      transition: transform .28s ease, opacity .28s ease, background .28s ease, border-color .28s ease, box-shadow .28s ease;
    }

    .step-card p {
      margin: 0;
      color: #475569;
      font-size: 17px;
      line-height: 1.68;
      max-width: 660px;
    }

    .step-card ul {
      list-style: none;
      padding: 0;
      margin: 24px 0 0;
      display: grid;
      gap: 12px;
    }

    .step-card li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 10px;
      color: #334155;
      line-height: 1.5;
      font-size: 15px;
    }

    .step-card li::before {
      content: "✓";
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--green-soft);
      color: var(--green);
      font-size: 12px;
      font-weight: 950;
    }

    .step-time {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      margin-top: 26px;
      color: var(--gold-dark);
      background: var(--gold-soft);
      border: 1px solid rgba(217,164,65,.20);
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 900;
    }

    .step-time::before {
      content: "◷";
      font-size: 16px;
      line-height: 1;
    }

    .scroll-step.is-active .step-pill {
      background: var(--gold-soft);
      color: var(--gold-dark);
    }

    .scroll-step.is-active .step-left h3 {
      color: var(--blue);
    }

    .scroll-step.is-active .step-node {
      background: linear-gradient(135deg, var(--gold), #f2c96d);
      color: #111827;
      border-color: transparent;
      box-shadow: 0 18px 42px rgba(217,164,65,.25);
      transform: scale(1.04);
    }

    .scroll-step.is-active .step-card {
      transform: translateY(0);
      opacity: 1;
      background: #fff;
      border-color: rgba(217,164,65,.30);
      box-shadow: 0 24px 70px rgba(15,23,42,.09);
    }

    @media(max-width:980px) {
      .process-track {
        left: 34px;
        width: 68px;
      }

      .scroll-step {
        grid-template-columns: 68px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        min-height: auto;
        margin-bottom: 34px;
      }

      .step-left {
        grid-column: 2;
        grid-row: 1;
        text-align: left;
        padding: 0;
      }

      .step-left h3 {
        margin-left: 0;
        max-width: 720px;
      }

      .step-node {
        grid-column: 1;
        grid-row: 1 / span 2;
      }

      .step-card {
        grid-column: 2;
        grid-row: 2;
        min-height: auto;
      }
    }

    @media(max-width:720px) {
      .scroll-process {
        padding-top: 0;
      }

      .process-track {
        left: 22px;
        width: 44px;
        top: 18px;
        bottom: 18px;
      }

      .scroll-step {
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 14px;
        margin-bottom: 30px;
      }

      .step-node {
        width: 44px;
        height: 44px;
        border-radius: 16px;
        font-size: 12px;
      }

      .step-pill {
        margin-bottom: 10px;
      }

      .step-left h3 {
        font-size: clamp(24px, 8vw, 34px);
      }

      .step-card {
        padding: 22px;
        border-radius: 24px;
      }

      .step-card p {
        font-size: 15px;
      }
    }


    /* =========================================================
      V14 · Segunda sección estilo doola con hover elegante
      - Minimalista, clara y elegante.
      - Heading centrado + grilla 3x2.
      - Hover premium al pasar el mouse.
    ========================================================== */
    .smart-start-section {
      background: #ffffff;
    }

    .smart-start-head {
      max-width: 860px;
      margin-bottom: clamp(34px, 6vw, 56px);
    }

    .smart-start-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(26px, 3vw, 42px) clamp(28px, 4vw, 54px);
      align-items: start;
      max-width: 1120px;
      margin: 0 auto;
    }

    .smart-card {
      position: relative;
      padding: 22px 18px 20px;
      min-height: 240px;
      border-radius: 26px;
      border: 1px solid transparent;
      background: transparent;
      transition:
        transform .26s ease,
        background-color .26s ease,
        border-color .26s ease,
        box-shadow .26s ease;
      cursor: default;
      overflow: hidden;
      isolation: isolate;
    }

    .smart-card::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background:
        linear-gradient(180deg, rgba(255,255,255,.95), rgba(248,250,252,.98));
      opacity: 0;
      transition: opacity .26s ease;
      z-index: -1;
    }

    .smart-card::after {
      content: "";
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 0;
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--gold), #f2c96d);
      transform: scaleX(.15);
      transform-origin: left center;
      opacity: 0;
      transition: transform .28s ease, opacity .28s ease;
    }

    .smart-icon {
      display: inline-grid;
      place-items: center;
      width: 40px;
      height: 40px;
      margin-bottom: 18px;
      border-radius: 12px;
      color: var(--ink);
      font-size: 22px;
      line-height: 1;
      transition:
        transform .26s ease,
        color .26s ease,
        background-color .26s ease,
        box-shadow .26s ease;
    }

    .smart-card h3 {
      margin: 0 0 14px;
      max-width: 310px;
      color: var(--ink);
      font-size: clamp(23px, 2.2vw, 26px);
      line-height: 1.14;
      letter-spacing: -.034em;
      transition: color .26s ease;
    }

    .smart-card p {
      margin: 0;
      max-width: 330px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.68;
      transition: color .26s ease;
    }

    .smart-card:hover,
    .smart-card:focus-within {
      transform: translateY(-7px);
      background: #fff;
      border-color: rgba(217,164,65,.18);
      box-shadow: 0 24px 56px rgba(15,23,42,.08);
    }

    .smart-card:hover::before,
    .smart-card:focus-within::before {
      opacity: 1;
    }

    .smart-card:hover::after,
    .smart-card:focus-within::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .smart-card:hover .smart-icon,
    .smart-card:focus-within .smart-icon {
      transform: translateY(-2px);
      background: rgba(217,164,65,.12);
      color: var(--gold-dark);
      box-shadow: inset 0 0 0 1px rgba(217,164,65,.12);
    }

    .smart-card:hover h3,
    .smart-card:focus-within h3 {
      color: var(--blue);
    }

    .smart-card:hover p,
    .smart-card:focus-within p {
      color: #475569;
    }

    @media (max-width: 980px) {
      .smart-start-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .smart-start-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .smart-card {
        min-height: auto;
        padding: 20px 18px 18px;
      }

      .smart-card h3,
      .smart-card p {
        max-width: none;
      }

      .smart-card:hover,
      .smart-card:focus-within {
        transform: translateY(-3px);
      }
    }


