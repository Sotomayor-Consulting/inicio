---
const { title1, subTitle1, alt, title2, subTitle2, link } = Astro.props;
const clases = "size-full absolute top-0 start-0 object-cover";
import imagen from "@images/Acuerdo2.avif"
import { Image } from "astro:assets";
---

<div class="mx-auto mt-10 mb-6 w-full space-y-1 text-center sm:w-1/2 lg:w-1/3">
  <h2
    class="text-2xl leading-tight font-bold text-balance text-primario-black sm:text-3xl dark:text-neutral-200"
  >
    {title1}
  </h2>
  {
    subTitle1 && (
      <p class="leading-tight text-pretty text-primario-black dark:text-neutral-400">
        {subTitle1}
      </p>
    )
  }
</div>

<div class="flex justify-center">
  <a
    href={link}
    class="hover:shadow-white mt-5 lg:w-1/2 rounded-xl border border-gray-200 bg-white shadow-2xs transition hover:scale-101 sm:flex dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70 w-full"
  >
    <div
      class="relative w-full shrink-0 overflow-hidden rounded-t-xl pt-[40%] sm:max-w-60 sm:rounded-s-xl md:max-w-xs md:rounded-se-none"
    >
      <Image class={`${clases}`} src={imagen} alt={alt} />
      
    </div>
    <div class="flex flex-wrap">
      <div class="flex h-full flex-col p-4 sm:p-7">
        <span class="text-white flex justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 24 24">
                <path fill="currentColor" d="M11 6h3l3.29-3.3a1 1 0 0 1 1.42 0l2.58 2.59a1 1 0 0 1 0 1.41L19 9h-8v2a1 1 0 0 1-1 1a1 1 0 0 1-1-1V8a2 2 0 0 1 2-2m-6 5v4l-2.29 2.29a1 1 0 0 0 0 1.41l2.58 2.59a1 1 0 0 0 1.42 0L11 17h4a1 1 0 0 0 1-1v-1h1a1 1 0 0 0 1-1v-1h1a1 1 0 0 0 1-1v-1h-7v1a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9Z" />
            </svg>
        </span>
        <h3 class="text-lg font-bold text-primario-black dark:text-white text-center">
          {title2}
        </h3>
        <p class="mt-1 text-primario-black dark:text-neutral-400">
          {subTitle2}
        </p>
      </div>
    </div>
  </a>
</div>
