---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout>
  <main class="astro-ouamjn2i">
    <section>
      <div class="mx-auto max-w-340 pt-20">
        <nav
          class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
          aria-label="Tabs"
          role="tablist"
        >
          <!-- Tab button element -->
          <button
            type="button"
            class="active flex w-full justify-center rounded-xl border border-transparent bg-neutral-100 p-3 ring-zinc-500 outline-hidden transition duration-300 hover:border-transparent hover:bg-secundario/20 focus-visible:ring-3 md:p-5 dark:bg-white/[.05] dark:ring-zinc-200 dark:hover:bg-secundario/20 dark:focus:outline-hidden"
            id="tabs-with-card-item-1"
            data-target="#tabs-with-card-1"
            role="tab"
          >
            <!-- Tab text -->
            <span
              id="Detalles"
              class="block text-center font-bold text-secundario dark:text-secundario"
            >
              Detalhes do programa de parceiros
            </span></button
          ><!-- Tab button element -->
          <button
            type="button"
            class="flex w-full justify-center rounded-xl border border-transparent p-3 ring-zinc-500 outline-hidden transition duration-300 hover:bg-secundario/20 focus-visible:ring-3 md:p-5 dark:ring-zinc-200 dark:hover:bg-secundario/20 dark:focus:outline-hidden"
            id="tabs-with-card-item-2"
            data-target="#tabs-with-card-2"
            role="tab"
          >
            <!-- Tab text -->
            <span
              id="formulario"
              class="block text-center font-bold text-primario-black dark:text-neutral-200"
            >
              formulário
            </span>
          </button>
        </nav>
        <div class="mt-5">
          <div id="tabs-with-card-1" role="tabpanel">
            <section
              class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
            >
              <!-- Grid -->
              <div class="flex p-10">
                <div class="mt-5 sm:mt-10 lg:col-span-6 lg:mt-0">
                  <div class="space-y-6 sm:space-y-8">
                    <div class="space-y-2 text-pretty md:space-y-4">
                      <h2
                        class="text-center text-3xl font-bold text-balance text-primario-black lg:text-4xl dark:text-neutral-200"
                      >
                        Torne-se parceiro da Sotomayor Consulting Internacional
                      </h2>
                      <p
                        class="text-pretty text-primario-black dark:text-neutral-400"
                      >
                        Na <strong>Sotomayor Consulting International</strong> trabalhamos
                        de mãos dadas com <strong
                          >advogados, contadores e assessores de confiança</strong
                        > que desejam oferecer aos seus clientes soluções sólidas
                        em:
                      </p>
                    </div>
                    <ul class="space-y-2 sm:space-y-4">
                      <li class="flex space-x-3">
                        <svg
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mt-0.5 h-6 w-6 flex-none text-secundario dark:text-secundario"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75 11.25 15 15
                              9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                          >
                          </path></svg
                        >
                        <span
                          class="text-base font-medium text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Estruturas internacionais e LLC nos EUA.
                        </span>
                      </li>
                      <li class="flex space-x-3">
                        <svg
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mt-0.5 h-6 w-6 flex-none text-secundario dark:text-secundario"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75 11.25 15 15
                              9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                          ></path>
                        </svg>
                        <span
                          class="text-base font-medium text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Planejamento patrimonial e fiscal.
                        </span>
                      </li>
                      <li class="flex items-center space-x-3">
                        <svg
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mt-0.5 h-6 w-6 flex-none text-secundario dark:text-secundario"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75 11.25 15 15
                              9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                          ></path>
                        </svg>
                        <span
                          class="text-base font-medium text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Serviços de tecnologia, como implementação de bots com
                          inteligência artificial, integração com plataformas de
                          pagamento digitais e outras soluções que facilitam
                          operar em nível global.
                        </span>
                      </li>
                      <li class="flex space-x-3">
                        <p
                          class="text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Como <strong>parceiro da firma</strong>, você continua
                          sendo o profissional de confiança do seu cliente,
                          enquanto nossa equipe se encarrega do design e da
                          execução técnica tanto na parte legal e fiscal quanto
                          na parte tecnológica.
                        </p>
                      </li>
                      <li class="flex flex-col space-x-3">
                        <p
                          class="font-bold text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Para quem é este programa?
                        </p>
                        <ul
                          class="ml-5 text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Advogado(a)s e escritórios jurídicos.
                        </ul>
                        <ul
                          class="ml-5 text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Contadore(a)s e firmas contábeis.
                        </ul>
                        <ul
                          class="ml-5 text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Assessores financeiros, tributários ou de
                          investimento.
                        </ul>
                        <ul
                          class="ml-5 text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Consultores de negócios, family offices e gestores
                          patrimoniais.
                        </ul>
                        <ul
                          class="mt-5 text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Em resumo, profissionais que acompanham decisões
                          importantes de seus clientes e querem dar a eles
                          acesso a soluções internacionais com suporte legal,
                          contábil e tecnológico especializado.
                        </ul>
                      </li>
                      <li
                        class="flex flex-col space-x-3 text-primario-black dark:text-neutral-400"
                      >
                        <p
                          class="font-bold text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Como cada caso é gerenciado?
                        </p>

                        <p
                          class="text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Para que tudo seja organizado, eficiente e
                          transparente: Você se apresenta perante seu cliente
                          como Partner ou Parceiro da Sotomayor Consulting
                          International LLC. A cada parceiro atribuímos um
                          código de parceiro, que seus clientes utilizarão ao
                          nos contatar ou completar nossos formulários. Dessa
                          forma, cada caso fica corretamente vinculado ao seu
                          escritório. Se você deseja utilizar nosso logo como
                          parceiro dentro de sua página web ou material
                          publicitário, você pode fazê-lo após assinado nosso
                          Acordo de Parceiros. O parceiro terá acesso ao nosso
                          dashboard para parceiros, onde poderá:
                        </p>
                        <p
                          class="text-pretty text-primario-black dark:text-neutral-400"
                        >
                          <ul>- Ver as ordens vinculadas ao seu código.</ul>
                          <ul>
                            - Revisar o <strong>estado de cada processo.</strong
                            >
                          </ul>
                          <ul>
                            - Fazer acompanhamento da evolução de seus clientes
                            dentro da firma.
                          </ul>
                        </p>
                        <p class="text-pretty">
                          Assim, você mantém visibilidade sobre seus clientes, e
                          nós garantizamos um fluxo de trabalho claro e
                          profissional.
                        </p>
                      </li>
                      <li
                        class="flex flex-col space-x-3 text-primario-black dark:text-neutral-400"
                      >
                        <p
                          class="font-bold text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Benefícios de ser Parceiro
                        </p>
                        <ul>
                          - Reforça sua posição como <strong
                            >assessor integral</strong
                          > perante seus clientes.
                        </ul>
                        <ul>
                          - Oferece estruturas internacionais e soluções
                          tecnológicas sem criar uma área interna própria.
                        </ul>
                        <ul>
                          - Conta com o respaldo de uma <strong
                            >firma boutique</strong
                          > especializada em clientes internacionais.
                        </ul>
                        <ul>
                          - Acessa um esquema claro de colaboração e benefícios
                          econômicos pelos clientes que indicar, sempre com
                          processos rastreáveis através de seu código e do
                          dashboard.
                        </ul>
                      </li>
                      <li class="flex space-x-3">
                        <p
                          class="text-pretty text-primario-black dark:text-neutral-400"
                        >
                          Se deseja conhecer as condições completas do programa
                          e receber nosso <strong>Partner Agreement</strong>,
                          escreva para:

                          <a href="mailto:artners@sotomayorconsulting.com">
                            partners@sotomayorconsulting.com</a
                          >
                          ou complete o formulário do <strong
                            >"Programa de Parceiros"</strong
                          > e nossa equipe entrará em contato com você para explicar
                          os detalhes e o próximo passo para se tornar parceiro da
                          <strong>Sotomayor Consulting International LLC</strong
                          >.
                        </p>
                      </li>
                      <li class="flex space-x-3">
                        <button
                          type="button"
                          id="siguienteBtn"
                          class="my-10 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-secundario px-4 py-3 text-sm font-bold text-white ring-zinc-500 outline-hidden transition duration-300 hover:bg-[#b89b62] focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 2xl:text-base dark:ring-zinc-200 dark:focus:outline-hidden"
                        >
                          Preencher formulário
                        </button>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
        <div id="tabs-with-card-2" class="hidden" role="tabpanel">
          <div
            class="mx-auto max-w-340 px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14"
          >
            <div class="grid w-full grid-cols-1 gap-x-16">
              <section
                class="mx-auto my-16 max-w-3xl rounded-2xl bg-[#d4d4d4] p-8 shadow-lg dark:bg-[#262626] dark:text-white"
              >
                <h2 class="mb-4 text-3xl font-bold">
                  Torne-se parceiro da Sotomayor Consulting International
                </h2>
                <p class="mb-8 text-sm dark:text-neutral-400">
                  A consulta e análise da situação individual
                  <span class="font-semibold text-secundario">
                    <b>não tem custo.</b></span
                  > Entraremos em contato com você para agendar uma reunião informativa
                  sobre nosso Programa de Indicações, onde esclareceremos todas as
                  suas dúvidas, confirmaremos sua participação e formalizaremos sua
                  gestão como parceiro estratégico da Sotomayor Consulting International.
                </p>
                <form
                  action="https://api.web3forms.com/submit"
                  method="POST"
                  class="grid gap-6"
                >
                  <input
                    type="hidden"
                    name="access_key"
                    value="a3a0ec9c-e3a4-4000-a7e0-8d6709e5701c"
                  />

                  <div
                    class="border-b border-neutral-200 dark:border-neutral-700"
                  >
                    <h4 class="mb-2">1.-Dados do profissional</h4>
                  </div>
                  <!-- Nombres -->
                  <div class="w-full">
                    <div>
                      <label for="nombre" class="sr-only">Nome completo</label>
                      <input
                        type="text"
                        name="nombre"
                        id="nombre"
                        required=""
                        placeholder="Nome completo"
                        class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-primario-black placeholder:text-black focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700 dark:text-white dark:placeholder:text-neutral-400 dark:focus:ring-1"
                      />
                    </div>
                  </div>
                  <!-- Correo -->
                  <div>
                    <label for="profesion" class="sr-only"
                      >Profissão principal</label
                    >
                    <select
                      id="profesion"
                      name="profesion"
                      class="block w-full rounded-lg border-neutral-200 bg-neutral-50 px-4 py-3 pe-9 text-sm focus:border-secundario focus:ring-secundario disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-700 dark:text-white dark:placeholder:text-neutral-400 dark:focus:ring-neutral-600"
                      required
                    >
                      <option
                        value=""
                        disabled=""
                        selected=""
                        class="text-neutral-400"
                        >Qual é a sua profissão principal?</option
                      >
                      <option value="Abogado / Abogada"
                        >Advogado / Advogada</option
                      >
                      <option value="Contador / Contadora"
                        >Contador / Contadora</option
                      >
                      <option value="Asesor financiero"
                        >Assessor financeiro</option
                      >
                      <option value="Asesor tributario"
                        >Assessor tributário</option
                      >
                      <option value="Consultor de negócios"
                        >Consultor de negócios</option
                      >
                      <option value="Family office / Gestor patrimonial"
                        >Family office / Gestor patrimonial</option
                      >
                      <option value="Outro">Outro</option>
                    </select>
                  </div>
                  <!-- Teléfono -->
                  <div>
                    <label
                      for="País_y_ciudad_de_residencia_profesional"
                      class="sr-only">Teléfono</label
                    >
                    <input
                      type="text"
                      name="País_y_ciudad_de_residencia_profesional"
                      id="País_y_ciudad_de_residencia_profesional"
                      required=""
                      placeholder="País e cidade de residência profissional"
                      class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-primario-black placeholder:text-black focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700 dark:text-white dark:placeholder:text-neutral-400 dark:focus:ring-1"
                    />
                  </div>
                  <!-- País de visado -->
                  <!-- País de visado -->
                  <div>
                    <label
                      for="Nombre_del_despacho_firma_o_empresa"
                      class="sr-only">Nombre completo</label
                    >
                    <input
                      type="text"
                      name="Nombre_del_despacho_firma_o_empresa"
                      id="Nombre_del_despacho_firma_o_empresa"
                      required=""
                      placeholder="Nome do escritório, firma ou empresa"
                      class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-primario-black placeholder:text-black focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700 dark:text-white dark:placeholder:text-neutral-400 dark:focus:ring-1"
                    />
