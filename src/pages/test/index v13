    function sotoGetUrlParam(name) {
      const params = new URLSearchParams(window.location.search);
      const value = params.get(name);
      return value ? value.trim() : '';
    }

    function sotoIsValidTtclid(value) {
      if (!value) return false;

      const normalized = value.trim().toUpperCase();
      const invalidValues = ['__CLICKID__', '_CLICKID_', 'CLICKID', '{{CLICKID}}', '{CLICKID}', 'NULL', 'UNDEFINED'];

      if (invalidValues.includes(normalized)) return false;
      if (value.length < 10) return false;

      return /^[a-zA-Z0-9._-]+$/.test(value);
    }

    function sotoGetCookie(name) {
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? decodeURIComponent(match[2]) : '';
    }

    function sotoSetCookie(name, value, days) {
      const maxAge = days * 24 * 60 * 60;
      document.cookie =
        name + '=' + encodeURIComponent(value) +
        '; Max-Age=' + maxAge +
        '; Path=/' +
        '; SameSite=Lax' +
        '; Secure';
    }

    function sotoGetStoredTtclid() {
      const ttclidFromUrl = sotoGetUrlParam('ttclid');

      if (sotoIsValidTtclid(ttclidFromUrl)) {
        sotoSetCookie('soto_ttclid', ttclidFromUrl, 30);
        localStorage.setItem('soto_ttclid', ttclidFromUrl);
        return ttclidFromUrl;
      }

      const ttclidFromStorage = localStorage.getItem('soto_ttclid') || '';
      if (sotoIsValidTtclid(ttclidFromStorage)) return ttclidFromStorage;

      const ttclidFromCookie = sotoGetCookie('soto_ttclid');
      if (sotoIsValidTtclid(ttclidFromCookie)) return ttclidFromCookie;

      return '';
    }

    function sotoGetOrCreateSessionId() {
      const key = 'soto_session_id';
      let sessionId = localStorage.getItem(key);

      if (!sessionId) {
        sessionId = 'soto_' + Date.now() + '_' + Math.random().toString(36).slice(2);
        localStorage.setItem(key, sessionId);
      }

      return sessionId;
    }

    function sotoCreateEventId(eventName) {
      const randomPart = window.crypto && window.crypto.randomUUID
        ? window.crypto.randomUUID()
        : Date.now() + '_' + Math.random().toString(36).slice(2);

      return 'soto_' + eventName + '_' + randomPart;
    }

    function sotoCollectUtmParams() {
      const params = new URLSearchParams(window.location.search);
      const keys = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_content',
        'utm_term',
        'campaign_id',
        'adgroup_id',
        'ad_id',
        'creative_id',
        'placement'
      ];

      return keys.reduce(function (acc, key) {
        const value = params.get(key);
        if (value) acc[key] = value;
        return acc;
      }, {});
    }

    function sotoBuildTikTokEventsApiPayload(eventName, eventId, eventPayload) {
      const ttclid = sotoGetStoredTtclid();
      const ttp = sotoGetCookie('_ttp') || sotoGetCookie('ttp') || '';

      return {
        destination: 'tiktok_events_api',
        pixel_code: SOTO_TIKTOK_PIXEL_ID,
        event: eventName,
        event_name: eventName,
        event_id: eventId,
        event_time: Math.floor(Date.now() / 1000),
        timestamp_iso: new Date().toISOString(),
        source: 'web',
        event_source: 'thank_you_page_after_tiktok_native_form',
        action_source: 'website',
        test_event_code: '',

        user: {
          ttclid: ttclid,
          ttp: ttp,
          user_agent: navigator.userAgent || '',
          language: navigator.language || '',
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
          soto_session_id: sotoGetOrCreateSessionId()
        },

        page: {
          url: window.location.href,
          path: window.location.pathname,
          referrer: document.referrer || '',
          title: document.title || ''
        },

        properties: {
          ...SOTO_EVENT_BASE,
          ...eventPayload,
          content_id: 'asesoria-llc-post-registro',
          content_type: 'service',
          contents: [
            {
              content_id: 'asesoria-llc-post-registro',
              content_name: 'Asesoria LLC USA',
              content_category: 'LLC USA',
              quantity: 1,
              price: 0
            }
          ]
        },

        attribution: {
          ttclid_present: Boolean(ttclid),
          ttp_present: Boolean(ttp),
          utm: sotoCollectUtmParams()
        },

        server_notes: {
          ip_capture: 'Capturar IP en n8n desde headers: cf-connecting-ip, x-forwarded-for o x-real-ip',
          deduplication: 'Usar pixel_code + event + event_id para deduplicar Pixel y Events API'
        }
      };
    }

    function sotoSendToTikTokEventsApiWebhook(payload) {
      const body = JSON.stringify(payload);
      const blob = new Blob([body], { type: 'text/plain;charset=UTF-8' });

      if (navigator.sendBeacon) {
        const queued = navigator.sendBeacon(SOTO_TIKTOK_EVENTS_API_WEBHOOK, blob);
        if (queued) return;
      }

      fetch(SOTO_TIKTOK_EVENTS_API_WEBHOOK, {
        method: 'POST',
        body: body,
        headers: {
          'Content-Type': 'text/plain;charset=UTF-8'
        },
        keepalive: true,
        mode: 'no-cors'
      }).catch(function () {});
    }

    function sotoTrack(eventName, payload = {}) {
      const config = SOTO_TIKTOK_EVENT_CONFIG[eventName] || {
        send_to_pixel: true,
        send_to_events_api: true,
        dedupe_once_per_session: false
      };

      const sessionDedupeKey = 'soto_event_fired_' + eventName;
      if (config.dedupe_once_per_session && sessionStorage.getItem(sessionDedupeKey)) {
        return;
      }

      const eventId = sotoCreateEventId(eventName);
      const eventPayload = {
        ...SOTO_EVENT_BASE,
        ...payload,
        page_url: window.location.href,
        page_path: window.location.pathname,
        event_id: eventId,
        ttclid: sotoGetStoredTtclid(),
        ttp: sotoGetCookie('_ttp') || sotoGetCookie('ttp') || ''
      };

      window.dataLayer.push({
        event: eventName,
        event_source: 'sotomayor_thank_you_page',
        event_id: eventId,
        ...eventPayload
      });

      if (config.send_to_pixel && window.ttq && typeof window.ttq.track === 'function') {
        window.ttq.track(eventName, eventPayload, { event_id: eventId });
      }

      if (config.send_to_events_api) {
        const eventsApiPayload = sotoBuildTikTokEventsApiPayload(eventName, eventId, eventPayload);
        sotoSendToTikTokEventsApiWebhook(eventsApiPayload);
      }

      if (config.dedupe_once_per_session) {
        sessionStorage.setItem(sessionDedupeKey, eventId);
      }
    }


    function sotoDetectLookupType(rawValue) {
      const value = (rawValue || '').trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i;
      const digits = value.replace(/[^\d]/g, '');

      if (emailRegex.test(value)) return 'email';
      if (digits.length >= 7) return 'phone';

      return '';
    }

    function sotoNormalizeLookupValue(rawValue, lookupType) {
      const value = (rawValue || '').trim();

      if (lookupType === 'email') {
        return value.toLowerCase();
      }

      if (lookupType === 'phone') {
        let phone = value.replace(/[^\d+]/g, '');

        if (phone.startsWith('00')) {
          phone = '+' + phone.slice(2);
        }

        return phone;
      }

      return value;
    }

    function sotoBuildZcalEmbedUrl(url) {
      if (!url) return SOTO_DEFAULT_ZCAL_URL + '?embed=1';

      try {
        const parsed = new URL(url, window.location.origin);

        if (parsed.hostname.includes('zcal.co')) {
          parsed.searchParams.set('embed', '1');
        }

        return parsed.toString();
      } catch (error) {
        return SOTO_DEFAULT_ZCAL_URL + '?embed=1';
      }
    }

