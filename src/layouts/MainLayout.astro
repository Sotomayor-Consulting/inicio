    <!-- TikTok Pixel Code End -->
     
  </head>
  <body
    class="flex min-h-screen flex-col bg-neutral-200 selection:bg-[#171717] selection:text-neutral-200 dark:bg-[#171717] dark:selection:bg-[#ba8d34] dark:selection:text-neutral-700"
  >
    {
      /*
    Setting up the main structure of the page.
    The Navbar is placed at the top, with a slot for the main content and FooterSection at the bottom.
    */
    }
    <div
      class="mx-auto w-full max-w-(--breakpoint-2xl) grow px-4 sm:px-6 lg:px-8"
    >
      <Navbar />
      <BotonWhatsapp />
      <main>
        <slot />
      </main>
    </div>
    <FooterSection />
    <script>
      import "node_modules/.pnpm/preline@4.1.2/node_modules/preline/dist/preline";
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
