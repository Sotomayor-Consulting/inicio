---
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import Icon from "@components/ui/icons/Icon.astro";

const { pricing } = Astro.props;

const plans = [
  {
    title: pricing.professionalToolbox.name,
    description: pricing.professionalToolbox.description,
    price: pricing.professionalToolbox.price,
    cents: pricing.professionalToolbox.cents,
    billingFrequency: pricing.professionalToolbox.billingFrequency,
    features: pricing.professionalToolbox.bussines,
    ctaLabel: pricing.professionalToolbox.purchaseBtnTitle,
    ctaHref: pricing.professionalToolbox.purchaseLink,
    ctaId: "openModaldos",
    tone: "featured",
    featured: true,
    eyebrow: pricing.badge,
    label: pricing.professionalToolbox.features,
  },
  {
    title: pricing.planestandar.name,
    description: pricing.planestandar.description,
    price: pricing.planestandar.price,
    cents: pricing.planestandar.cents,
    billingFrequency: pricing.planestandar.billingFrequency,
    features: pricing.planestandar.features,
    ctaLabel: pricing.planestandar.purchaseBtnTitle,
    ctaHref: pricing.planestandar.purchaseLink,
    ctaId: "estandar",
    tone: "default",
    featured: false,
    eyebrow: null,
    label: pricing.planestandar.label,
  },
  {
    title: pricing.starterKit.name,
    description: pricing.starterKit.description,
    price: pricing.starterKit.price,
    cents: pricing.starterKit.cents,
    billingFrequency: pricing.starterKit.billingFrequency,
    features: pricing.starterKit.features,
    ctaLabel: pricing.starterKit.purchaseBtnTitle,
    ctaHref: pricing.starterKit.purchaseLink,
    ctaId: "openModaltres",
    tone: "default",
    featured: false,
    eyebrow: null,
    label: null,
  },
  {
    title: pricing.planUpgrade.title,
    description: pricing.planUpgrade.description,
    price: pricing.planUpgrade.price,
    cents: pricing.planUpgrade.cents,
    billingFrequency: pricing.planUpgrade.billing,
    features: pricing.planUpgrade.lista,
    ctaLabel: pricing.planUpgrade.button,
    ctaHref: pricing.planUpgrade.link,
    tone: "default",
    featured: false,
    eyebrow: "Upgrade",
  },
];
---

<section
  class="mx-auto w-full px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
  id="precios"
>
  <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
    
    <h2
      class="mt-4 text-3xl font-semibold tracking-tight text-balance text-primario-black sm:text-4xl lg:text-5xl dark:text-neutral-100"
    >
      {pricing.title}
    </h2>
    <p
      class="mx-auto mt-3 max-w-2xl text-pretty text-base leading-7 text-neutral-600 dark:text-neutral-400"
    >
      {pricing.subTitle}
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
    {
      plans.map((plan) => {
        const cardClasses =
          plan.tone === "featured"
            ? "border-secundario border-2 bg-background/95 text-card-foreground shadow-xl shadow-secundario dark:border-secundario/80 dark:bg-neutral-900/80 dark:text-neutral-100 dark:shadow-secundario/30 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 ease-in-out"
            : plan.tone === "accent"
              ? "border-amber-200/80 bg-secundario/80 text-neutral-900 shadow-lg shadow-amber-100/40 dark:border-amber-700/40 dark:bg-secundario/20 dark:text-neutral-100"
              : "border-neutral-400 bg-background/95 text-card-foreground shadow-lg shadow-black/5 dark:border-neutral-500 dark:bg-neutral-900/80 dark:text-neutral-100 dark:shadow-white/5 hover:shadow-xl hover:shadow-secundario hover:-translate-y-2 transition-all duration-300 ease-in-out hover:dark:shadow-secundario/30";

        const descriptionClasses =
          plan.tone === "featured"
            ? "text-neutral-600 dark:text-neutral-400"
            : plan.tone === "accent"
              ? "text-amber-900/80 dark:text-amber-100/80"
              : "text-neutral-600 dark:text-neutral-400";

        const billingClasses =
          plan.tone === "featured"
            ? "text-neutral-500 dark:text-neutral-400"
            : plan.tone === "accent"
              ? "text-amber-900/70 dark:text-amber-100/70"
              : "text-neutral-500 dark:text-neutral-400";

        const priceClasses =
          plan.tone === "featured"
            ? "text-primario-black dark:text-white"
            : "text-primario-black dark:text-white";

        const listClasses =
          plan.tone === "featured"
            ? "text-neutral-700 dark:text-neutral-300"
            : plan.tone === "accent"
              ? "text-amber-950 dark:text-amber-100"
              : "text-neutral-700 dark:text-neutral-300";

        const iconName = plan.tone === "featured" ? "estrella" : "checkCircle";

        return (
          <article
            class={`relative flex h-full flex-col overflow-hidden rounded-2xl border p-6 sm:p-7 ${cardClasses}`}
          >
            <div class="flex flex-col min-h-16 items-start justify-center gap-4">
              <div>
                {plan.eyebrow && (
                <span
                  class={`relative isolate inline-flex shrink-0 rounded-full border px-2.5 py-1 text-[11px] font-semibold tracking-[0.14em] uppercase ${plan.tone === "featured" ? "border-white/15 dark:bg-secundario/80 bg-secundario text-black dark:text-white before:pointer-events-none before:absolute before:inset-[-4px] before:-z-10 before:rounded-full before:bg-secundario/35 before:content-[''] before:animate-[badgePulse_1.8s_ease-in-out_infinite] after:pointer-events-none after:absolute after:inset-0 after:-z-10 after:rounded-full after:bg-white/10 after:content-['']" : plan.tone === "accent" ? "border-amber-300/80 bg-white/70 text-amber-900 dark:border-amber-600/50 dark:bg-amber-100/10 dark:text-amber-100" : "border-border bg-muted/70 text-muted-foreground dark:border-neutral-700 dark:bg-neutral-800/80 dark:text-neutral-300"}`}
                >
                  {plan.eyebrow}
                </span>
              )}
              </div>
              <div>
                <p class={`text-sm font-medium ${descriptionClasses}`}>
                  {plan.description}
                </p>
                <h3 class="mt-3 text-2xl font-semibold tracking-tight">
                  {plan.title}
                </h3>
              </div>

              
            </div>

            <div class="mt-8 flex items-end gap-1">
              <span class={`text-5xl font-semibold tracking-tight ${priceClasses}`}>
                {plan.price}
              </span>
              <span class={`pb-1 text-lg font-semibold ${priceClasses}`}>
                {plan.cents}
              </span>
              <span class={`pb-2 pl-2 text-sm font-medium ${billingClasses}`}>
                {plan.billingFrequency}
              </span>
            </div>

            <ul class={`mt-8 space-y-3 text-sm leading-6 ${listClasses}`}>
              {
                plan.label && (
                  <li class="flex items-start gap-3">
                    <span>{plan.label}</span>
                  </li>
                )
              }
              {plan.features.map((feature: string) => (
                <li class="flex items-start gap-3">
                  <span
                    class={`mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${plan.tone === "featured" ? "bg-secundario/30 text-secundario" : plan.tone === "accent" ? "bg-amber-200/70 text-amber-900 dark:bg-amber-500/20 dark:text-amber-100" : "bg-muted text-foreground dark:bg-neutral-800 dark:text-neutral-200"}`}
                  >
                    <Icon name={iconName} />
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
              
            </ul>

            <div class="mt-8 flex-1"></div>

            {plan.ctaHref ? (
              <a
                href={plan.ctaHref}
                class={`mt-8 inline-flex w-full items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold transition duration-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-hidden ${plan.tone === "featured" ? "bg-secundario text-white hover:bg-secundario/80 focus-visible:ring-amber-500 dark:bg-secundario dark:text-neutral-950 dark:hover:bg-amber-300" : "bg-neutral-900 text-white hover:bg-neutral-800 focus-visible:ring-neutral-500 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200"}`}
              >
                {plan.ctaLabel}
              </a>
            ) : (
              <button
                id={plan.ctaId}
                class={`mt-8 inline-flex w-full items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold transition duration-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-hidden ${plan.tone === "featured" ? "bg-neutral-900 text-white hover:bg-neutral-800 focus-visible:ring-neutral-500 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200" : "bg-neutral-900 text-white hover:bg-neutral-800 focus-visible:ring-neutral-500 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200"}`}
              >
                {plan.ctaLabel}
              </button>
            )}
          </article>
        );
      })
    }
  </div>

  <div class="mt-10 flex items-center justify-center gap-x-3 md:mt-12">
    <p class="text-sm text-primario-black dark:text-neutral-400">
      {pricing.thirdOption}
    </p>
    <SecondaryCTA title={pricing.btnText} url={pricing.linkServicios} alternative={true} />
  </div>
</section>


<style>
  @keyframes badgePulse {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(1);
    }

    50% {
      opacity: 0.65;
      transform: scale(1.14);
    }
  }
</style>
