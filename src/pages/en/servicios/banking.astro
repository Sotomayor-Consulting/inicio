---
import { dataBanking } from "src/data_files/en/data-de-servicios";
import MainLayout from "@/layouts/MainLayoutv2.astro";
import { Icon } from "astro-icon/components";


---

<MainLayout
  title={dataBanking.titulo}
  customDescription={dataBanking.titulo}
  customOgTitle={dataBanking.titulo}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `https://sotomayorconsulting.com/inicio/servicios/${dataBanking.categoria.toLowerCase().replace(/\s+/g, "-")}`,
    name: dataBanking.titulo,
    description: dataBanking.descripcion,
    brand: {
      "@type": "Brand",
      name: "Sotomayor Consulting",
    },
  }}
>
  <section
    class="mx-auto flex max-w-340 flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <div class="relative z-10">
        <div class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
          <div class="mx-auto max-w-2xl text-center">
            <p
              class="inline-block bg-linear-to-l from-secundario to-white bg-clip-text text-sm font-medium text-transparent dark:from-secundario dark:to-white"
            >
              Sotomayor Consulting International
            </p>

            <!-- Title -->
            <div class="mt-5 max-w-2xl">
              <h1
                class="block text-4xl font-semibold text-primario-black md:text-5xl lg:text-6xl dark:text-neutral-200"
              >
                {dataBanking.titulo}
              </h1>
            </div>
            <!-- End Title -->

            <div class="mt-5 max-w-3xl">
              <p class="text-lg text-primario-black dark:text-neutral-400">
                {dataBanking.descripcion}
              </p>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex justify-center gap-3">
              <a
                class="inline-flex items-center gap-x-2 rounded-lg border border-transparent bg-secundario px-4 py-3 text-sm font-medium text-white hover:bg-secundario/80 focus:bg-blue-700 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                target="_blank"
                href="https://zcal.co/t/agendar-asesoria-llc/60min"
              >
                Schedule a meeting
                <svg
                  class="size-4 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                >
              </a>
            </div>
            <!-- End Buttons -->
          </div>
        </div>
      </div>
    </div>
    <!-- End Hero -->

    <!-- Card Blog -->
    <div class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <!-- Grid -->
      <div class="grid gap-6">
        {
          dataBanking.TarjetasFeatures.map((f) =>
            f.pocision === "left" ? (
              <div class="grid md:grid-cols-2 gap-6 border md:border-0 p-4 rounded-2xl dark:border-neutral-600 border-neutral-400">
                <div class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white shadow-2xs dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70">
                  <div class="flex h-52 flex-col items-center justify-center rounded-t-xl bg-black dark:bg-white">
                    <Icon
                      name={f.svg}
                      class="text-5xl text-white md:text-7xl dark:text-black"
                    />
                  </div>
                  <div class="p-4 md:p-6">
                    <h3 class="text-xl font-semibold text-primario-black dark:text-neutral-300 dark:hover:text-white">
                      {f.titulo}
                    </h3>
                    <p class="mt-3 text-primario-black dark:text-neutral-500">
                      {f.descripcion}
                    </p>
                  </div>
                </div>

                <div class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white shadow-2xs dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70">
                  <div class="p-4 md:p-6">
                    <span class="mb-2 inline-flex items-center gap-x-1.5 rounded-full border border-[#0e2637] px-3 py-1.5 text-xs font-medium text-[#0e2637] dark:border-secundario dark:text-secundario">
                      One-time payment
                    </span>
                    <div class="grid grid-cols-2 items-center justify-end">
                      <h3 class="text-xl font-semibold text-primario-black dark:text-neutral-300 dark:hover:text-white">
                        {f.titulo2}
                      </h3>
                      <div class="text-left text-black sm:text-right dark:text-white">
                        <>
                          <span class="font-display text-foreground text-4xl font-bold md:text-5xl">
                            ${f.precio}
                          </span>
                          <span class="text-muted-foreground ml-1 text-base">
                            USD
                          </span>
                        </>
                      </div>
                    </div>

                    <a
                      href={f.link}
                      target="_blank"
                      class="mt-5 flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-secundario px-4 py-3 text-center text-sm font-medium text-white hover:bg-secundario/80 focus:bg-secundario/80 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                    >
                      <Icon name="mingcute:message-2-line" />
                      {f.boton}
                    </a>
                  </div>
                  <div class="flex justify-center">
                    <hr class="w-4/5 border-neutral-300 dark:border-neutral-800" />
                  </div>

                  <div class="flex flex-col p-4 md:p-6">
                    <p class="mt-3 text-primario-black dark:text-white">
                      What you get:
                    </p>
                    <ul>
                      {f.lista.map((li) => (
                        <li class="mt-2 flex items-center gap-x-2 text-primario-black dark:text-white">
                          <Icon
                            name="mingcute:check-circle-fill"
                            class="text-lg text-green-500"
                          />
                          {li}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ) : (
              <div class="grid md:grid-cols-2 gap-6 border md:border-0 p-4 rounded-2xl dark:border-neutral-600 border-neutral-400">
                <div class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white shadow-2xs dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70 row-start-2 md:row-start-1 md:col-start-1">
                  <div class="p-4 md:p-6">
                    <span class="mb-2 inline-flex items-center gap-x-1.5 rounded-full border border-[#0e2637] px-3 py-1.5 text-xs font-medium text-[#0e2637] dark:border-secundario dark:text-secundario">
                      One-time payment
                    </span>
                    <div class="grid grid-cols-2 items-center justify-end">
                      <h3 class="text-xl font-semibold text-primario-black dark:text-neutral-300 dark:hover:text-white">
                        {f.titulo2}
                      </h3>
                      <div class="text-left text-black sm:text-right dark:text-white">
                        <>
                          <span class="font-display text-foreground text-4xl font-bold md:text-5xl">
                            ${f.precio}
                          </span>
                          <span class="text-muted-foreground ml-1 text-base">
                            USD
                          </span>
                        </>
                      </div>
                    </div>

                    <a
                      href={f.link}
                      target="_blank"
                      class="mt-5 flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-secundario px-4 py-3 text-center text-sm font-medium text-white hover:bg-secundario/80 focus:bg-secundario/80 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                    >
                      <Icon name="mingcute:message-2-line" />
                      {f.boton}
                    </a>
                  </div>
                  <div class="flex justify-center">
                    <hr class="w-4/5 border-neutral-300 dark:border-neutral-800" />
                  </div>

                  <div class="flex flex-col p-4 md:p-6">
                    <p class="mt-3 text-primario-black dark:text-white">
                      What you get:
                    </p>
                    <ul>
                      {f.lista.map((li) => (
                        <li class="mt-2 flex items-center gap-x-2 text-primario-black dark:text-white">
                          <Icon
                            name="mingcute:check-circle-fill"
                            class="text-lg text-green-500"
                          />
                          {li}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white shadow-2xs dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70">
                  <div class="flex h-52 flex-col items-center justify-center rounded-t-xl bg-black dark:bg-white">
                    <Icon
                      name={f.svg}
                      class="text-9xl text-white dark:text-black"
                    />
                  </div>
                  <div class="p-4 md:p-6">
                    <h3 class="text-xl font-semibold text-primario-black dark:text-neutral-300 dark:hover:text-white">
                      {f.titulo}
                    </h3>
                    <p class="mt-3 text-primario-black dark:text-neutral-500">
                      {f.descripcion}
                    </p>
                  </div>
                </div>
              </div>
            ),
          )
        }

        <!-- End Card -->
      </div>
      <!-- End Grid -->
    </div>
    <!-- End Card Blog -->
  </section>
</MainLayout>
