    function sotoUpdateCalendarUrl(url, sourceContext) {
      const safeUrl = url || SOTO_DEFAULT_ZCAL_URL;
      const frame = document.getElementById('zcalFrame');
      const externalLink = document.getElementById('calendarExternalLink');
      const fallbackLink = document.getElementById('calendarFallbackLink');
      const calendarTitle = document.getElementById('calendarTitle');

      if (frame) frame.src = sotoBuildZcalEmbedUrl(safeUrl);
      if (externalLink) externalLink.href = safeUrl;
      if (fallbackLink) fallbackLink.href = safeUrl;

      if (calendarTitle && sourceContext === 'prefilled') {
        calendarTitle.textContent = 'Agenda preparada con tu registro';
      }

      if (sourceContext === 'prefilled') {
        sotoShowCalendar(true);
      }

      window.dataLayer.push({
        event: 'zcal_url_updated',
        source_context: sourceContext || 'manual',
        schedule_url: safeUrl
      });
    }

    function sotoSetLookupLoading(isLoading) {
      const overlay = document.getElementById('lookupLoadingOverlay');
      const submitButton = document.querySelector('#leadLookupForm button[type="submit"]');

      if (overlay) {
        overlay.classList.toggle('is-active', Boolean(isLoading));
        overlay.setAttribute('aria-hidden', isLoading ? 'false' : 'true');
      }

      if (submitButton) {
        submitButton.disabled = Boolean(isLoading);
        submitButton.textContent = isLoading ? 'Preparando...' : 'Continuar con mi agenda';
      }
    }

    function sotoSetLookupFeedback(type, title, message, actionUrl, actionText) {
      const feedback = document.getElementById('lookupFeedback');
      if (!feedback) return;

      feedback.className = 'lookup-feedback is-visible is-' + type;
      feedback.innerHTML =
        '<strong>' + title + '</strong>' +
        '<span>' + message + '</span>' +
        (actionUrl ? '<br><a href="' + actionUrl + '" target="_blank" rel="noopener" data-track-schedule>' + (actionText || 'Elegir horario') + '</a>' : '');

      feedback.querySelectorAll('[data-track-schedule]').forEach(function (element) {
        element.addEventListener('click', function () {
          sotoTrack('Schedule', {
            description: SOTO_TIKTOK_EVENT_CONFIG.Schedule.description,
            schedule_url: element.getAttribute('href') || SOTO_DEFAULT_ZCAL_URL,
            schedule_context: 'lookup_result_cta'
          });
        });
      });
    }

    function sotoReadLookupResult(data) {
      const result = data || {};
      const nested = result.result || result.data || {};

      const url =
        result.zcal_prefill_url ||
        result.zcal_url ||
        result.calendar_url ||
        result.url ||
        nested.zcal_prefill_url ||
        nested.zcal_url ||
        nested.calendar_url ||
        nested.url ||
        '';

      const status = String(result.status || nested.status || '').toLowerCase();
      const found =
        result.found === true ||
        nested.found === true ||
        status === 'found' ||
        status === 'ok' ||
        status === 'success' ||
        Boolean(url);

      return {
        found: found,
        url: url,
        lead_token: result.lead_token || nested.lead_token || '',
        message: result.message || nested.message || ''
      };
    }

