---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout>
  <main class="astro-ouamjn2i">
    <section>
      <div class="mx-auto max-w-340 pt-20">
        <nav
          class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
          aria-label="Tabs"
          role="tablist"
        >
          <!-- Tab button element -->
          <button
            type="button"
            class="active flex w-full justify-center rounded-xl border border-transparent bg-neutral-100 p-3 ring-zinc-500 outline-hidden transition duration-300 hover:border-transparent hover:bg-[#ba8d34]/20 focus-visible:ring-3 md:p-5 dark:bg-white/[.05] dark:ring-zinc-200 dark:hover:bg-[#ba8d34]/20 dark:focus:outline-hidden"
            id="tabs-with-card-item-1"
            data-target="#tabs-with-card-1"
            role="tab"
          >
            <!-- Tab text -->
            <span
              id="Detalles"
              class="block text-center font-bold text-[#ba8d34] dark:text-[#ba8d34]"
            >
              Partner program details
            </span></button><!-- Tab button element -->
          <button
            type="button"
            class="flex w-full justify-center rounded-xl border border-transparent p-3 ring-zinc-500 outline-hidden transition duration-300 hover:bg-[#ba8d34]/20 focus-visible:ring-3 md:p-5 dark:ring-zinc-200 dark:hover:bg-[#ba8d34]/20 dark:focus:outline-hidden"
            id="tabs-with-card-item-2"
            data-target="#tabs-with-card-2"
            role="tab"
          >
            <!-- Tab text -->
            <span
              id="formulario"
              class="block text-center font-bold text-neutral-800 dark:text-neutral-200"
            >
              Form
            </span>
          </button>
        </nav>
        <div class="mt-5">
          <div id="tabs-with-card-1" role="tabpanel">
            <section
              class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
            >
              <!-- Grid -->
              <div class="flex p-10">
                <div class="mt-5 sm:mt-10 lg:col-span-6 lg:mt-0">
                  <div class="space-y-6 sm:space-y-8">
                    <div class="space-y-2 text-pretty md:space-y-4">
                      <h2
                        class="text-center text-3xl font-bold text-balance text-neutral-800 lg:text-4xl dark:text-neutral-200"
                      >
                        Become a partner of Sotomayor Consulting
                        International
                      </h2>
                      <p
                        class="text-pretty text-neutral-600 dark:text-neutral-400"
                      >
                        At <strong>Sotomayor Consulting International</strong> we work
                        hand in hand with <strong
                          >trusted lawyers, accountants and advisors</strong
                        > who want to offer their clients solid solutions in:
                      </p>
                    </div>
                    <ul class="space-y-2 sm:space-y-4">
                      <li class="flex space-x-3">
                        <svg
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mt-0.5 h-6 w-6 flex-none text-[#ba8d34] dark:text-[#ba8d34]"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75 11.25 15 15
                              9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                          >
                          </path></svg
                        >
                        <span
                          class="text-base font-medium text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          International structures and LLCs in the U.S.
                        </span>
                      </li>
                      <li class="flex space-x-3">
                        <svg
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mt-0.5 h-6 w-6 flex-none text-[#ba8d34] dark:text-[#ba8d34]"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75 11.25 15 15
                              9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                          ></path>
                        </svg>
                        <span
                          class="text-base font-medium text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Estate and tax planning.
                        </span>
                      </li>
                      <li class="flex items-center space-x-3">
                        <svg
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mt-0.5 h-6 w-6 flex-none text-[#ba8d34] dark:text-[#ba8d34]"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75 11.25 15 15
                              9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                          ></path>
                        </svg>
                        <span
                          class="text-base font-medium text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Technology services, such as implementation of bots
                          con inteligencia artificial, integración con
                          plataformas de pago digitales y otras soluciones que
                          facilitate operating globally.
                        </span>
                      </li>
                      <li class="flex space-x-3">
                        <p
                          class="text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          As a <strong>firm associate</strong>, you
                          sigue siendo el profesional de confianza de su
                          cliente, mientras nuestro equipo se encarga del diseño
                          y la ejecución técnica tanto en la parte legal y
                          fiscal como en la parte tecnológica.
                        </p>
                      </li>
                      <li class="flex flex-col space-x-3">
                        <p
                          class="font-bold text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Who is this program for?
                        </p>
                        <ul
                          class="ml-5 text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Lawyers and law firms.
                        </ul>
                        <ul
                          class="ml-5 text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Accountants and accounting firms.
                        </ul>
                        <ul
                          class="ml-5 text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Financial, tax or investment advisors.
                        </ul>
                        <ul
                          class="ml-5 text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Business consultants, family offices and wealth managers.
                        </ul>
                        <ul
                          class="mt-5 text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          In summary, professionals who accompany clients' important decisions
                          importantes de sus clientes y quieren darles acceso a
                          soluciones internacionales con soporte legal, contable
                          y tecnológico especializado.
                        </ul>
                      </li>
                      <li
                        class="flex flex-col space-x-3 text-neutral-600 dark:text-neutral-400"
                      >
                        <p
                          class="font-bold text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          How is each case managed?
                        </p>
                        
                        <p
                          class="text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                        So that everything is orderly, efficient and transparent:
                        You present yourself to your client as a Partner or Associate of Sotomayor Consulting International LLC. Each partner is assigned a partner code, which their clients will use when contacting us or completing our forms. This way, each case is correctly linked to your firm.
                        If you want to use our logo as an associate on your website or advertising materials, you can do so once our Partner Agreement is signed.
                        The partner will have access to our partner dashboard, where they can:
                        </p>
                        <p
                          class="text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          <ul>- See the orders linked to your code.</ul>
                          <ul>
                            - Review the <strong>status of each process.</strong>
                          </ul>
                          <ul>
                            - Follow up on the evolution of their clients
                            within the firm.
                          </ul>
                        </p>
                        <p class="text-pretty">
                          This way, you maintain visibility over your clients, and
                          we guarantee a clear and
                          professional workflow.
                        </p>
                      </li>
                      <li
                        class="flex flex-col space-x-3 text-neutral-600 dark:text-neutral-400"
                      >
                        <p
                          class="font-bold text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          Partner Benefits
                        </p>
                        <ul>
                          - Strengthens your position as a <strong
                            >comprehensive advisor</strong
                          > to your clients.
                        </ul>
                        <ul>
                          - Offers international structures and technological
                          solutions without creating your own internal department.
                        </ul>
                        <ul>
                          - Has the support of a <strong
                            >boutique firm</strong
                          > specialized in international clients.
                        </ul>
                        <ul>
                          - Access to a clear collaboration scheme and
                          economic benefits for the clients you refer,
                          always with traceable processes through your code and
                          the dashboard.
                        </ul>
                      </li>
                      <li class="flex space-x-3">
                        <p
                          class="text-pretty text-neutral-600 dark:text-neutral-400"
                        >
                          If you want to know the complete conditions of the
                          program and receive our <strong
                            >Partner Agreement</strong
                          >, write to us at:

                          <a href="mailto:artners@sotomayorconsulting.com">
                            partners@sotomayorconsulting.com</a
                          >
                          or complete the <strong
                            >"Partner Program"</strong
                          > form and our team will contact you to
                          explain the details and the next step to become a partner of <strong
                            >Sotomayor Consulting International LLC</strong
                          >.
                        </p>
                      </li>
                      <li class="flex space-x-3">
                        <button
                          type="button"
                          id="siguienteBtn"
                          class="my-10 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-[#ba8d34] px-4 py-3 text-sm font-bold text-white ring-zinc-500 outline-hidden transition duration-300 hover:bg-[#b89b62] focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 2xl:text-base dark:ring-zinc-200 dark:focus:outline-hidden"
                        >
                          Complete form
                        </button>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
