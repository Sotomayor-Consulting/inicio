      const otherHtml = country === "Otro" ? `<div class="other-detail"><label for="phoneCountryOtherDetail">Indica país y código</label><textarea id="phoneCountryOtherDetail" placeholder="Ejemplo: Guatemala, código +502">${escapeHtml(data.phoneCountryOtherDetail || "")}</textarea></div>` : "";
