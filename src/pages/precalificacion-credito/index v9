              <select id="fundsCountry" name="fundsCountry">
                <option value="">Selecciona una opción</option>
                <option>Estados Unidos</option>
                <option>País de residencia</option>
                <option>Otro país</option>
                <option>Varias cuentas</option>
              </select>
            </div>

            <div class="field full" data-visible-if="loanType:Refinanciar,Retiro de dinero / Cash-out">
              <label for="currentPropertyAddress">Dirección de la propiedad actual</label>
              <input id="currentPropertyAddress" name="currentPropertyAddress" type="text" placeholder="Dirección, ciudad y código postal" />
            </div>

            <div class="field" data-visible-if="loanType:Refinanciar,Retiro de dinero / Cash-out">
