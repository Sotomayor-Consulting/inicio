---
// Import section components
import MainLayout from "@/layouts/MainLayout.astro";
import Btn404 from "@components/ui/buttons/Btn404.astro";
import { SITE } from "@data/constants";

// Define types for translations
type TranslationKeys = "en" | "pr" | "es";
type Translations = {
  [key in TranslationKeys]: {
    pageTitle: string;
    subTitle: string;
    content: string;
    btnTitle: string;
  };
};

// Define variables for page content
const defaultLang: TranslationKeys = "es";
const translations: Translations = {
  en: {
    pageTitle: `Page Not Found | ${SITE.title}`,
    subTitle: "Oops, this isn't the tool you were looking for!",
    content:
      "Don't let this hiccup slow you down. Let's get you back to building your masterpiece.",
    btnTitle: "Go Back",
  },
  pr: {
    pageTitle: `Página Não Encontrada | ${SITE.title}`,
    subTitle: "Oops, aqui não está o que você estava procurando!",
    content:
      "Não deixe que esse contratempo te freie. Com nossa ajuda, em breve você voltará a construir seu futuro.",
    btnTitle: "Voltar",
  },
  es: {
    pageTitle: `Pagina no funciona | ${SITE.title}`,
    subTitle: "¡Oops, aquí no esta lo que estabas buscando!",
    content:
      "No permitas que este contratiempo te frene. Con nuestra ayuda, pronto volverás a construir tu futuro.",
    btnTitle: "Regresar",
  },
};

// Determine language from the URL
const pathname = Astro.url.pathname;
const lang: TranslationKeys = pathname.startsWith("/pr") ? "pr" : "en";

const { pageTitle, subTitle, content, btnTitle } = translations[lang];
---

<MainLayout title={pageTitle}>
  <section class="grid h-svh place-content-center">
    <div class="mx-auto max-w-(--breakpoint-xl) px-4 py-8 lg:px-6 lg:py-16">
      <div class="mx-auto max-w-(--breakpoint-sm) text-center">
        <h1
          class="text-dark mb-4 text-7xl font-extrabold text-yellow-500 dark:text-yellow-400 lg:text-9xl"
        >
          404
        </h1>
        <p
          id="subtitle"
          class="mb-4 text-balance text-3xl font-bold tracking-tight text-primario-black dark:text-neutral-300 md:text-4xl"
        >
          {subTitle}
        </p>
        <p
          id="content"
          class="mb-4 text-pretty text-lg text-primario-black dark:text-neutral-400"
        >
          {content}
        </p>
        <!-- Display a button that navigates user back to the previous page -->
        <Btn404 title={btnTitle} id="go-back" />
      </div>
    </div>
  </section>
</MainLayout>

<!-- JavaScript code to handle going back to the previous page -->
<script>
  const goBackButton = document.getElementById("go-back") as HTMLButtonElement;

  goBackButton.addEventListener("click", () => {
    history.back();
  });
</script>
