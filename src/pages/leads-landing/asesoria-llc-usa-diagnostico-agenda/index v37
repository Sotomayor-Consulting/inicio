    const agendaContainer = document.getElementById("zcal-agenda-container");
    const zcalFallbackMessage = document.getElementById("zcal-fallback-message");
    const zcalOpenNewTab = document.getElementById("zcal-open-new-tab");
    const agendaGoalSummary = document.getElementById("agenda-goal-summary");

    const scheduleForm = document.getElementById("schedule-diagnostic-form");
    const scheduleNextStep = document.getElementById("schedule-next-step");
    const scheduleBackStep = document.getElementById("schedule-back-step");
    const scheduleSubmitButton = document.getElementById("schedule-submit-button");
    const scheduleLoadingState = document.getElementById("schedule-loading-state");
    const scheduleSuccessState = document.getElementById("schedule-success-state");
    const scheduleWarningState = document.getElementById("schedule-warning-state");
    const scheduleStepLabel = document.getElementById("schedule-step-label");
    const scheduleStepName = document.getElementById("schedule-step-name");

    const leadForm = document.getElementById("lead-registration-form");
    const leadSubmitButton = document.getElementById("lead-submit-button");
    const leadLoadingState = document.getElementById("lead-loading-state");
    const leadSuccessState = document.getElementById("lead-success-state");
    const leadWarningState = document.getElementById("lead-warning-state");
    const leadStepLabel = document.getElementById("lead-step-label");
    const leadStepName = document.getElementById("lead-step-name");
    const leadNextStep = document.getElementById("lead-next-step");
    const leadBackStep = document.getElementById("lead-back-step");

    const activeVariant = assignAbVariant();
    let formStarted = false;
    let leadCurrentStep = 1;
    let scheduleSubmitInFlight = false;

    initAbVisibility(activeVariant);
    relocateWizardForViewport();
    bindGlobalTracking();
    bindScheduleFlow();
    bindLeadFlow();
    bindProcessInteractions();
    bindScheduleConfirmationHooks();

    window.addEventListener("resize", relocateWizardForViewport);
    window.addEventListener("orientationchange", relocateWizardForViewport);

    document.addEventListener("DOMContentLoaded", () => {
      trackAdsEvent("ViewContent", {
        ...getServiceAdsPayload(),
        ...getBaseTrackingPayload(),
        event_stage: "page_view"
      });
      trackEvent("ab_variant_assigned", {
        ...getBaseTrackingPayload(),
        ab_variant: activeVariant,
        conversion_path: activeVariant === "A" ? "schedule_first" : "lead_registration"
      });

      const scheduleParams = new URLSearchParams(window.location.search);
      if (["success", "confirmed", "true"].includes(String(scheduleParams.get("schedule") || "").toLowerCase()) || String(scheduleParams.get("event") || "").toLowerCase() === "schedule") {
        fireScheduleConversion("url_confirmation", { schedule_url_flag: scheduleParams.get("schedule") || scheduleParams.get("event") || "" });
      }
    });

    function assignAbVariant() {
      const params = new URLSearchParams(window.location.search);
      const forced = String(params.get("ab") || params.get("variant") || "").trim().toUpperCase();
      if (["A", "B"].includes(forced)) {
        try { localStorage.setItem(CONFIG.variantStorageKey, forced); } catch {}
        return forced;
      }
      try {
        const stored = localStorage.getItem(CONFIG.variantStorageKey);
        if (["A", "B"].includes(stored)) return stored;
        const randomVariant = Math.random() < 0.5 ? "A" : "B";
        localStorage.setItem(CONFIG.variantStorageKey, randomVariant);
        return randomVariant;
      } catch {
        return Math.random() < 0.5 ? "A" : "B";
      }
    }

    function initAbVisibility(variant) {
      document.documentElement.dataset.abVariant = variant;
      document.querySelectorAll(".ab-variant").forEach((element) => {
        element.hidden = element.dataset.abVariant !== variant;
      });
      if (abVariantLabel) abVariantLabel.textContent = variant === "A" ? "Agenda de asesoría gratuita" : "Registro empresarial";
      const heroCta = document.querySelector('[data-cta-location="hero_primary"]');
      if (heroCta) heroCta.textContent = variant === "A" ? "Agendar asesoría gratuita" : "Evaluar mi objetivo";
      document.querySelectorAll('.confidence-cta .btn').forEach((btn) => {
        btn.textContent = variant === "A" ? "Agendar asesoría gratuita" : "Evaluar mi objetivo";
      });
    }

    /* Reubicación responsive del formulario sin duplicar componentes */
    function relocateWizardForViewport() {
      const wizardCard = document.querySelector(".wizard-card");
      const mobileWizardSlot = document.getElementById("mobile-wizard-slot");
      if (!wizardCard || !mobileWizardSlot) return;
      let marker = document.getElementById("wizard-original-position-marker");
      if (!marker) {
        marker = document.createElement("span");
        marker.id = "wizard-original-position-marker";
        marker.style.display = "none";
        wizardCard.parentNode.insertBefore(marker, wizardCard);
      }
      const isMobile = window.matchMedia("(max-width: 720px)").matches;
      if (isMobile && wizardCard.parentNode !== mobileWizardSlot) mobileWizardSlot.appendChild(wizardCard);
      if (!isMobile && wizardCard.parentNode === mobileWizardSlot) marker.parentNode.insertBefore(wizardCard, marker.nextSibling);
    }

    function scrollToActiveWizardCta(formElement) {
      const form = formElement || document.querySelector(`.ab-variant[data-ab-variant="${activeVariant}"]:not([hidden]) form`);
      if (!form) return;
      const primaryButton = form.querySelector('.wizard-actions .btn.btn-primary:not([hidden]):not([disabled]), .lead-wizard-controls .btn.btn-primary:not([hidden]):not([disabled])');
      if (!primaryButton) return;
      primaryButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function bindGlobalTracking() {
      document.querySelectorAll(".js-scroll-cta").forEach((cta) => {
        cta.addEventListener("click", () => {
          trackEvent("click_cta", {
            ...getBaseTrackingPayload(),
            cta_location: cta.dataset.ctaLocation || "unknown"
          });
        });
      });

      document.querySelectorAll(".js-select-goal").forEach((cta) => {
        cta.addEventListener("click", () => {
          const goal = cta.dataset.goal || "";
          preselectGoal(goal);
          setTimeout(() => abCard?.scrollIntoView({ behavior: "smooth", block: "start" }), 60);
        });
      });

      [scheduleForm, leadForm].filter(Boolean).forEach((form) => {
        form.addEventListener("focusin", () => {
          if (!formStarted) {
            formStarted = true;
            trackEvent("form_started", {
              ...getBaseTrackingPayload(),
              ab_variant: activeVariant,
              conversion_path: activeVariant === "A" ? "schedule_first" : "lead_registration"
            });
          }
        });
      });
    }

    function preselectGoal(goal) {
      if (!goal) return;
      const inputName = activeVariant === "A" ? "main_goal_a" : "main_goal_b";
      const input = document.querySelector(`input[name="${inputName}"][value="${goal}"]`);
      if (input) {
        input.checked = true;
        input.dispatchEvent(new Event("change", { bubbles: true }));
        if (activeVariant === "A") {
          setTimeout(() => scheduleForm?.scrollIntoView({ behavior: "smooth", block: "center" }), 80);
        } else {
          goLeadStep(2);
        }
      }
    }

    function bindScheduleFlow() {
      if (!scheduleForm) return;
      document.querySelectorAll('input[name="main_goal_a"]').forEach((input) => {
        input.addEventListener("change", () => {
          clearErrors(scheduleForm);
          trackEvent("select_main_goal", { ...getBaseTrackingPayload(), ab_variant: "A", main_goal: input.value });
          setTimeout(() => scrollToActiveWizardCta(scheduleForm), 160);
        });
      });

      scheduleForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (scheduleSubmitInFlight) return;
        clearErrors(scheduleForm);
        hideStates([scheduleLoadingState, scheduleSuccessState, scheduleWarningState]);

        const formData = readScheduleForm();
        const validation = validateScheduleForm(formData);
        if (!validation.isValid) {
          showErrors(scheduleForm, validation.errors);
          trackEvent("form_error", { ...getBaseTrackingPayload(), ab_variant: "A", error_fields: Object.keys(validation.errors).join(",") });
          return;
        }

        scheduleSubmitInFlight = true;
        const leadId = getOrCreateLeadId();
        const payload = buildSchedulePayload(formData, leadId, getUtmParams());
        persistLead(payload);
        trackEvent("ab_schedule_goal_selected", buildSafeEventPayload(payload));
        trackAdsEvent("SubmitForm", {
          ...getServiceAdsPayload(),
          ...buildSafeEventPayload(payload),
          event_stage: "schedule_goal_selected",
          form_type: "schedule_goal_only"
        });

        setButtonLoading(scheduleSubmitButton, true, "Abriendo agenda...");
        showState(scheduleLoadingState);
        showAgenda(payload);
        hideStates([scheduleLoadingState, scheduleSuccessState, scheduleWarningState]);
        showState(scheduleSuccessState);
        sendLeadToWebhook(payload).then((delivered) => {
          trackEvent(delivered ? "schedule_goal_webhook_success" : "schedule_goal_webhook_error", buildSafeEventPayload(payload));
          if (!delivered) showState(scheduleWarningState);
        });
        setButtonLoading(scheduleSubmitButton, false, "Agendar asesoría gratuita");
        setTimeout(() => { scheduleSubmitInFlight = false; }, 900);
      });
    }

    function bindLeadFlow() {
      if (!leadForm) return;
      document.querySelectorAll('input[name="main_goal_b"]').forEach((input) => {
        input.addEventListener("change", () => {
          clearErrors(leadForm);
          trackEvent("select_main_goal", { ...getBaseTrackingPayload(), ab_variant: "B", main_goal: input.value });
          setTimeout(() => scrollToActiveWizardCta(leadForm), 160);
        });
      });
      document.querySelectorAll('input[name="wants_zoom_meeting"]').forEach((input) => {
        input.addEventListener("change", () => {
          clearErrors(leadForm);
          trackEvent("select_zoom_meeting_preference", { ...getBaseTrackingPayload(), ab_variant: "B", wants_zoom_meeting: input.value });
          setTimeout(() => scrollToActiveWizardCta(leadForm), 160);
        });
      });
      document.getElementById("b_business_objective")?.addEventListener("change", (event) => {
        clearErrors(leadForm);
        trackEvent("select_business_objective", { ...getBaseTrackingPayload(), ab_variant: "B", business_objective: event.target.value });
        setTimeout(() => scrollToActiveWizardCta(leadForm), 160);
      });

      leadNextStep?.addEventListener("click", () => {
        clearErrors(leadForm);
        const validation = validateLeadStep(leadCurrentStep, readLeadForm());
        if (!validation.isValid) {
          showErrors(leadForm, validation.errors);
          trackEvent("wizard_step_error", { ...getBaseTrackingPayload(), ab_variant: "B", step: leadCurrentStep, error_fields: Object.keys(validation.errors).join(",") });
          return;
        }
        trackEvent("wizard_step_completed", { ...getBaseTrackingPayload(), ab_variant: "B", step: leadCurrentStep });
        goLeadStep(Math.min(4, leadCurrentStep + 1));
      });

      leadBackStep?.addEventListener("click", () => {
        clearErrors(leadForm);
        goLeadStep(Math.max(1, leadCurrentStep - 1));
      });

      leadForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearErrors(leadForm);
        hideStates([leadLoadingState, leadSuccessState, leadWarningState]);

        const formData = readLeadForm();
        const validation = validateLeadForm(formData);
        if (!validation.isValid) {
          showErrors(leadForm, validation.errors);
          const firstInvalidStep = getFirstInvalidLeadStep(validation.errors);
          goLeadStep(firstInvalidStep);
          trackEvent("form_error", { ...getBaseTrackingPayload(), ab_variant: "B", error_fields: Object.keys(validation.errors).join(",") });
          return;
        }

        const leadId = getOrCreateLeadId();
        const payload = buildLeadPayload(formData, leadId, getUtmParams());
        persistLead(payload);
        const safePayload = await buildSafeTrackingPayload(payload);
        trackEvent("ab_lead_registration_submit", safePayload);
        trackAdsEvent("SubmitForm", {
          ...getServiceAdsPayload(),
          ...safePayload,
          event_stage: "lead_registration_submit",
          form_type: "lead_registration_wizard"
        });

        setButtonLoading(leadSubmitButton, true, "Registrando...");
        showState(leadLoadingState);
        const delivered = await sendLeadToWebhook(payload);
        setButtonLoading(leadSubmitButton, false, "Registrar mi objetivo");
        hideStates([leadLoadingState, leadSuccessState, leadWarningState]);
        showState(delivered ? leadSuccessState : leadWarningState);
        trackEvent(delivered ? "lead_registration_webhook_success" : "lead_registration_webhook_error", await buildSafeTrackingPayload(payload));
      });
      goLeadStep(1);
    }

    function goScheduleStep(step) {
      document.querySelectorAll("[data-a-step]").forEach((element) => element.classList.toggle("is-active", Number(element.dataset.aStep) === step));
      document.querySelectorAll("[data-a-progress]").forEach((element) => element.classList.toggle("is-active", Number(element.dataset.aProgress) <= step));
      if (scheduleStepLabel) scheduleStepLabel.textContent = `Paso ${step} de 1`;
      if (scheduleStepName) scheduleStepName.textContent = "Objetivo";
    }

    function goLeadStep(step) {
      leadCurrentStep = step;
      document.querySelectorAll("[data-b-step]").forEach((element) => element.classList.toggle("is-active", Number(element.dataset.bStep) === step));
      document.querySelectorAll("[data-b-progress]").forEach((element) => element.classList.toggle("is-active", Number(element.dataset.bProgress) <= step));
      const names = { 1: "Uso principal", 2: "Datos de contacto", 3: "Objetivo empresarial", 4: "Agenda Zoom" };
      if (leadStepLabel) leadStepLabel.textContent = `Paso ${step} de 4`;
      if (leadStepName) leadStepName.textContent = names[step] || "Registro";
      if (leadBackStep) leadBackStep.hidden = step === 1;
      if (leadNextStep) leadNextStep.hidden = step === 4;
      if (leadSubmitButton) leadSubmitButton.hidden = step !== 4;
      setTimeout(() => scrollToActiveWizardCta(leadForm), 120);
    }

    function validateLeadStep(step, data) {
      const errors = {};
      if (step === 1 && !data.main_goal) errors.main_goal_b = "Selecciona una opción.";
      if (step === 2) {
        if (!data.first_name || data.first_name.length < 2) errors.b_first_name = "Ingresa tu nombre.";
        if (!data.last_name || data.last_name.length < 2) errors.b_last_name = "Ingresa tu apellido.";
        if (!isValidEmail(data.email)) errors.b_email = "Ingresa un correo válido.";
        const phoneE164 = formatPhoneE164(data.phone_raw, data.country_code);
        if (!isValidE164(phoneE164)) errors.b_phone = "Ingresa un WhatsApp válido.";
      }
      if (step === 3 && !data.business_objective) errors.b_business_objective = "Selecciona el objetivo principal.";
      if (step === 4 && !data.wants_zoom_meeting) errors.wants_zoom_meeting = "Selecciona una opción.";
      return { isValid: Object.keys(errors).length === 0, errors };
    }

    function getFirstInvalidLeadStep(errors) {
      if (errors.main_goal_b) return 1;
      if (errors.b_first_name || errors.b_last_name || errors.b_email || errors.b_phone) return 2;
      if (errors.b_business_objective) return 3;
      if (errors.wants_zoom_meeting) return 4;
      return 1;
    }

    function readScheduleForm() {
      const selectedGoal = document.querySelector('input[name="main_goal_a"]:checked');
      return {
        main_goal: selectedGoal ? selectedGoal.value : ""
      };
    }

    function readLeadForm() {
      const selectedGoal = document.querySelector('input[name="main_goal_b"]:checked');
      const selectedZoom = document.querySelector('input[name="wants_zoom_meeting"]:checked');
      return {
        main_goal: selectedGoal ? selectedGoal.value : "",
        first_name: sanitizeText(readValue("b_first_name")),
        last_name: sanitizeText(readValue("b_last_name")),
        country_code: readValue("b_country_code") || "+593",
        phone_raw: sanitizePhoneRaw(readValue("b_phone")),
        email: sanitizeEmail(readValue("b_email")),
        business_objective: readValue("b_business_objective"),
        wants_zoom_meeting: selectedZoom ? selectedZoom.value : ""
      };
    }

    function validateScheduleForm(data) {
      const errors = {};
      if (!data.main_goal) errors.main_goal_a = "Selecciona una opción para avanzar.";
      return { isValid: Object.keys(errors).length === 0, errors };
    }

    function validateLeadForm(data) {
      const errors = {};
      [1, 2, 3, 4].forEach((step) => Object.assign(errors, validateLeadStep(step, data).errors));
      return { isValid: Object.keys(errors).length === 0, errors };
    }

