  <script>
    const CONFIG = {
      webhookUrl: "https://n8n.sotomayorconsulting.com/webhook/leads-directos-tiktok-landing",
      zcalBaseUrl: "https://zcal.co/t/agendar-asesoria-llc/60min",
      storageKey: "sci_landing_business_structure_ab_v37",
      variantStorageKey: "sci_landing_business_structure_ab_variant_v37",
      source: "tiktok_landing_directa",
      landingReference: "landing_soluciones_empresariales_tributarias_eeuu_produccion_v37_tracking",
      // Mapeo para preguntas personalizadas de Zcal en la ruta de agenda.
      // Configurar en Zcal el mismo orden: a0 objetivo principal, a1 lead_id.
      zcalQuestionMap: {
        a0: "main_goal_label",
        a1: "lead_id"
      }
    };

    const abCard = document.getElementById("ab-conversion-card");
    const abVariantLabel = document.getElementById("ab-variant-label");
