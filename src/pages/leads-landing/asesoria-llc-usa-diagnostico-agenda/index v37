    async function buildSafeTrackingPayload(payload) {
      const phoneHash = payload.phone_e164 ? await sha256(payload.phone_e164) : "";
      const emailHash = payload.email ? await sha256(payload.email.toLowerCase()) : "";
      return {
        ...buildSafeEventPayload(payload),
        email_hash: emailHash,
        phone_hash: phoneHash
      };
    }

    function buildEventId(eventName, payload = {}) {
      const leadPart = payload.lead_id || readStoredLead()?.lead_id || "anonymous";
      if (["ViewContent", "SubmitForm", "Schedule"].includes(eventName)) {
        return `${eventName}_${payload.ab_variant || activeVariant}_${leadPart}`.replace(/[^a-zA-Z0-9_/-]/g, "_");
      }
      return `${eventName}_${payload.ab_variant || activeVariant}_${leadPart}_${Date.now()}`;
    }

    function sanitizeTikTokEventPayload(payload = {}) {
      const allowedKeys = [
        "content_type", "content_id", "content_ids", "content_name", "description", "currency", "value", "quantity",
        "lead_id", "main_goal", "business_objective", "wants_zoom_meeting", "ab_variant", "conversion_path", "utm_source", "utm_campaign", "ttclid", "page_url"
      ];
      return allowedKeys.reduce((acc, key) => {
        if (payload[key] !== undefined && payload[key] !== "") acc[key] = payload[key];
        return acc;
      }, {});
    }

    function trackAdsEvent(eventName, payload = {}) {
      const eventId = payload.event_id || buildEventId(eventName, payload);
      const eventPayload = {
        event: eventName,
        event_id: eventId,
        event_source: "sci_landing_web",
        event_platform: "web",
        event_family: "ads_conversion",
        tiktok_event_name: eventName,
        google_ads_event_name: eventName,
        ...payload
      };
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(eventPayload);
      if (window.ttq && typeof window.ttq.track === "function") {
        try { window.ttq.track(eventName, sanitizeTikTokEventPayload(eventPayload), { event_id: eventId }); }
        catch (error) {
          try { window.ttq.track(eventName, sanitizeTikTokEventPayload(eventPayload)); }
          catch (innerError) { console.warn("No se pudo enviar evento estándar a TikTok Pixel:", innerError); }
        }
      }
      if (window.SCI_TRACKING_CONFIG?.debug) console.info("Ads tracking event:", eventPayload);
    }

    function trackEvent(eventName, payload = {}) {
      const eventPayload = { event: eventName, ...payload };
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(eventPayload);
      if (window.SCI_TRACKING_CONFIG?.debug) console.info("Tracking event:", eventPayload);
    }

