---
const {
  label = "Search",
  title = Astro.currentLocale === "fr" ? "S'abonner" : "Suscríbete",
  id = "footer-input",
} = Astro.props;

interface Props {
  label?: string;
  title?: string;
  id?: string;
}

const placeholder = Astro.currentLocale === "fr" ? "Entrez votre email" : "Ingresa tu email";
---

<div
  class="mt-4 flex flex-col items-center gap-2 rounded-lg bg-neutral-200 p-2 dark:bg-[#171717] sm:flex-row sm:gap-3"
>
  <div class="w-full">
    <input type="hidden" name="access_key" value="a3a0ec9c-e3a4-4000-a7e0-8d6709e5701c">
    <label for={id} class="sr-only">{label}</label>
    <input
      type="text"
      id={id}
      name="footer-input"
      class="block w-full rounded-lg border-transparent bg-neutral-100 px-4 py-3 text-sm text-neutral-600 focus:border-[#ba8d34] focus:ring-[#ba8d34] disabled:pointer-events-none disabled:opacity-50 dark:border-transparent dark:bg-[#12334a] dark:text-gray-300 dark:placeholder:text-neutral-300 caret-[#ba8d34]"
      placeholder={placeholder}
    />
  </div>
  <a
    class="inline-flex w-full items-center justify-center gap-x-2 whitespace-nowrap rounded-lg border border-transparent bg-[#ba8d34] p-3 text-sm font-bold text-neutral-50 outline-hidden ring-zinc-500 transition duration-300 hover:bg-[#dfb96c] focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 dark:ring-zinc-200 dark:focus:outline-hidden dark:focus:ring-1 sm:w-auto"
    href="#"
  >
    {title}
  </a>
</div>
