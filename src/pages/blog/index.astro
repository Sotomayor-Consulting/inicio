---
import BlogListingPage from "@/components/blog/BlogListingPage.astro";
import {
  BLOG_PAGE_SIZE,
  buildPagination,
  getBlogBasePath,
  getBlogPageMeta,
  getInsightPosts,
} from "@/utils/blogPages";

const langPrefix = "es";
const insightPosts = await getInsightPosts(langPrefix);
const totalPages = Math.max(1, Math.ceil(insightPosts.length / BLOG_PAGE_SIZE));
const meta = getBlogPageMeta(langPrefix);
const pagination = buildPagination(getBlogBasePath(langPrefix), 1, totalPages);
---

<BlogListingPage
  {...meta}
  langPrefix={langPrefix}
  entries={insightPosts.slice(0, BLOG_PAGE_SIZE)}
  pagination={pagination}
/>
