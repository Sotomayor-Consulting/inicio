<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Precalificación Hipotecaria Florida | Sotomayor Consulting</title>
  <meta name="description" content="Formulario tipo wizard para una evaluación preliminar de crédito hipotecario en Florida para compradores locales y extranjeros." />
  <style>
    :root {
      --bg: #f7f3ec;
      --bg-soft: #fbf8f2;
      --ink: #111827;
      --muted: #6b7280;
      --line: #ddcfbb;
      --line-soft: rgba(17, 24, 39, 0.12);
      --navy: #101827;
      --gold: #b9853b;
      --gold-dark: #8a5d23;
      --green: #0f766e;
      --red: #b42318;
      --white: #ffffff;
      --shadow: 0 24px 70px rgba(17, 24, 39, 0.12);
      --radius-lg: 28px;
      --radius-md: 18px;
      --radius-sm: 12px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--ink);
      background:
        linear-gradient(90deg, rgba(185, 133, 59, 0.08) 1px, transparent 1px),
        linear-gradient(rgba(185, 133, 59, 0.07) 1px, transparent 1px),
        var(--bg);
      background-size: 64px 64px;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    .page-shell {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
    }

    .topbar {
      padding: 24px 0 0;
    }

    .brand-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.78rem;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: inline-grid;
      place-items: center;
      color: var(--white);
      background: var(--navy);
      box-shadow: 0 8px 20px rgba(17, 24, 39, 0.18);
    }

    .top-note {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .hero {
      padding: 72px 0 52px;
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 56px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--gold-dark);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .eyebrow::before {
      content: "";
      width: 36px;
      height: 1px;
      background: var(--gold);
    }

    h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.7rem, 6vw, 6rem);
      line-height: 0.95;
      margin: 0;
      letter-spacing: -0.06em;
      font-weight: 500;
    }

    .hero-copy {
      margin: 24px 0 0;
      max-width: 660px;
      color: #374151;
      font-size: clamp(1rem, 1.7vw, 1.2rem);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 34px;
    }

    .btn {
      border: 0;
      border-radius: 999px;
      padding: 14px 22px;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
    }

    .btn:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    .btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .btn-primary {
      background: var(--gold);
      color: var(--white);
      box-shadow: 0 14px 34px rgba(185, 133, 59, 0.28);
    }

    .btn-primary:hover:not(:disabled) {
      background: var(--gold-dark);
    }

    .btn-blue {
      background: var(--navy);
      color: var(--white);
      box-shadow: 0 12px 28px rgba(17, 24, 39, 0.2);
    }

    .btn-ghost {
      background: transparent;
      color: var(--navy);
      border: 1px solid var(--line);
    }

    .hero-panel {
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 30px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(14px);
    }

    .hero-panel h2 {
      margin: 0 0 14px;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.11em;
    }

    .hero-list {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 16px;
    }

    .hero-list li {
      display: flex;
      gap: 12px;
      color: #374151;
      font-size: 0.97rem;
    }

    .hero-list li::before {
      content: "";
      flex: 0 0 8px;
      width: 8px;
      height: 8px;
      margin-top: 8px;
      border-radius: 50%;
      background: var(--gold);
    }

    .info-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      margin-bottom: 44px;
    }

    .info-item {
      padding: 26px;
      border-right: 1px solid var(--line);
    }

    .info-item:last-child {
      border-right: 0;
    }

    .info-item strong {
      display: block;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.88rem;
    }

    .info-item span {
      color: #4b5563;
      font-size: 0.95rem;
    }

    .wizard-wrap {
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      overflow: hidden;
      margin-bottom: 42px;
    }

    .wizard-header {
      display: grid;
      grid-template-columns: 0.82fr 1.18fr;
      gap: 32px;
      padding: 34px;
      background: linear-gradient(135deg, rgba(16, 24, 39, 0.98), rgba(31, 41, 55, 0.98));
      color: var(--white);
    }

    .wizard-header h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.9rem, 3vw, 3rem);
      line-height: 1.04;
      letter-spacing: -0.04em;
      margin: 0;
      font-weight: 500;
    }

    .wizard-header p {
      margin: 8px 0 0;
      color: rgba(255, 255, 255, 0.72);
    }

    .progress-box {
      align-self: end;
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.88rem;
      margin-bottom: 10px;
    }

    .progress-track {
      height: 8px;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.15);
      overflow: hidden;
    }

    .progress-fill {
      width: 0;
      height: 100%;
      background: var(--gold);
      transition: width 0.28s ease;
    }

    .step-nav {
      display: flex;
      overflow-x: auto;
      gap: 0;
      border-bottom: 1px solid var(--line);
      background: rgba(251, 248, 242, 0.92);
    }

    .step-nav button {
      appearance: none;
      border: 0;
      background: transparent;
      color: var(--muted);
      padding: 16px 18px;
      min-width: max-content;
      border-right: 1px solid var(--line-soft);
      cursor: pointer;
      font-weight: 750;
      font-size: 0.82rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .step-nav button.active {
      color: var(--navy);
      background: var(--white);
      box-shadow: inset 0 -3px 0 var(--gold);
    }

    form {
      padding: 34px;
    }

    .form-step {
      display: none;
      animation: fadeIn 0.25s ease;
    }

    .form-step.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .step-kicker {
      color: var(--gold-dark);
      font-size: 0.76rem;
      font-weight: 850;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .form-step h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.8rem, 3vw, 2.8rem);
      letter-spacing: -0.04em;
      line-height: 1.05;
      font-weight: 500;
    }

    .form-step > p {
      color: #4b5563;
      max-width: 760px;
      margin: 12px 0 28px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .field {
      display: grid;
      gap: 8px;
    }

    .field.full,
    .conditional-box {
      grid-column: 1 / -1;
    }

    label {
      font-size: 0.92rem;
      font-weight: 780;
      color: var(--navy);
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="number"],
    select,
    textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 14px 14px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.85);
      outline: none;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--gold);
      background: var(--white);
      box-shadow: 0 0 0 4px rgba(185, 133, 59, 0.12);
    }

    input::placeholder,
    textarea::placeholder {
      color: #9ca3af;
    }

    .hint,
    .field-note {
      color: var(--muted);
      font-size: 0.82rem;
    }

    .field-note {
      padding: 12px 14px;
      border-left: 3px solid var(--gold);
      background: rgba(185, 133, 59, 0.08);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }

    .option-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .option-grid.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .option-card {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      min-height: 58px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.72);
      color: var(--ink);
      cursor: pointer;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease, background 0.18s ease;
      font-weight: 760;
    }

    .option-card:hover {
      transform: translateY(-1px);
      border-color: rgba(185, 133, 59, 0.65);
      background: var(--white);
    }

    .option-card input {
      margin-top: 4px;
      accent-color: var(--gold);
      flex: 0 0 auto;
    }

    .option-card:has(input:checked) {
      border-color: var(--gold);
      background: rgba(185, 133, 59, 0.08);
      box-shadow: 0 10px 22px rgba(185, 133, 59, 0.12);
    }

    .option-card .option-title {
      display: block;
      font-weight: 850;
      line-height: 1.3;
    }

    .option-card .option-desc {
      display: block;
      color: #6b7280;
      font-size: 0.82rem;
      font-weight: 500;
      margin-top: 4px;
      line-height: 1.35;
    }

    .conditional-box {
      display: none;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: rgba(251, 248, 242, 0.72);
    }

    .conditional-box.visible {
      display: block;
    }

    .subsection-title {
      margin: 0 0 14px;
      font-size: 0.84rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--navy);
    }

    .wizard-actions {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding-top: 30px;
      margin-top: 30px;
      border-top: 1px solid var(--line);
    }

    .wizard-actions .btn {
      min-width: 152px;
    }

    .error-box {
      display: none;
      margin-top: 18px;
      padding: 14px 16px;
      border-left: 4px solid var(--red);
      color: #7f1d1d;
      background: #fff1f2;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      font-weight: 650;
    }

    .summary-card {
      margin-top: 28px;
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--white);
      box-shadow: 0 18px 40px rgba(17, 24, 39, 0.08);
    }

    .summary-card p {
      margin: 0 0 12px;
      color: #374151;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .metric {
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: rgba(251, 248, 242, 0.72);
    }

    .metric small {
      display: block;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 850;
      font-size: 0.7rem;
      margin-bottom: 8px;
    }

    .metric strong {
      display: block;
      font-size: 1.05rem;
      line-height: 1.2;
    }

    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 8px 12px;
      font-weight: 820;
      font-size: 0.82rem;
      border: 1px solid rgba(185, 133, 59, 0.38);
      color: #92400e;
      background: #fffbeb;
    }

    .pill.ok {
      color: #047857;
      border-color: rgba(16, 185, 129, 0.28);
      background: #ecfdf5;
    }

    .pill.warn {
      color: #92400e;
      border-color: rgba(245, 158, 11, 0.35);
      background: #fffbeb;
    }

    .pill.danger {
      color: #b42318;
      border-color: rgba(244, 63, 94, 0.28);
      background: #fff1f2;
    }

    .submission-status {
      margin-top: 18px;
      padding: 14px 16px;
      border-left: 4px solid var(--gold);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      background: rgba(185, 133, 59, 0.09);
      color: #3f2d14;
    }

    .submission-status strong {
      display: block;
      margin-bottom: 4px;
    }

    .submission-status.ok {
      border-left-color: var(--green);
      background: #ecfdf5;
      color: #064e3b;
    }

    .submission-status.fail {
      border-left-color: var(--red);
      background: #fff1f2;
      color: #7f1d1d;
    }

    .legal-note {
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.7);
      color: #4b5563;
      margin-bottom: 42px;
    }

    .legal-note strong {
      color: var(--navy);
    }

    .footer {
      padding: 26px 0 40px;
      color: var(--muted);
      font-size: 0.9rem;
      border-top: 1px solid var(--line);
    }

    [hidden] {
      display: none !important;
    }

    @media (max-width: 900px) {
      .hero,
      .wizard-header {
        grid-template-columns: 1fr;
      }

      .info-strip {
        grid-template-columns: 1fr;
      }

      .info-item {
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .info-item:last-child {
        border-bottom: 0;
      }

      .option-grid,
      .option-grid.three,
      .form-grid,
      .summary-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      .page-shell {
        width: min(100% - 24px, 1120px);
      }

      .top-note {
        display: none;
      }

      .hero {
        padding: 48px 0 32px;
      }

      .hero-panel,
      .wizard-header,
      form {
        padding: 22px;
      }

      .wizard-actions {
        flex-direction: column;
      }

      .wizard-actions .btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <header class="topbar page-shell">
    <div class="brand-row">
      <div class="brand">
        <span class="brand-mark">SC</span>
        <span>Sotomayor Consulting</span>
      </div>
      <div class="top-note">Florida Mortgage Prequalification · Foreign Nationals</div>
    </div>
  </header>

  <main>
    <section class="hero page-shell">
      <div>
        <div class="eyebrow">Evaluación preliminar</div>
        <h1>Precalifica tu compra en Florida.</h1>
        <p class="hero-copy">
          Completa una evaluación breve, privada y ordenada para orientar tu perfil hipotecario, identificar una posible ruta de financiamiento y preparar el siguiente paso con un asesor.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#formulario">Iniciar evaluación</a>
          <a class="btn btn-ghost" href="#como-funciona">Ver cómo funciona</a>
        </div>
      </div>

      <aside class="hero-panel" id="como-funciona" aria-label="Información del proceso">
        <h2>Qué revisamos</h2>
        <ul class="hero-list">
          <li>Objetivo del préstamo, uso de la propiedad y plazo estimado de compra.</li>
          <li>Perfil del comprador local o extranjero, identificación disponible y estructura personal o LLC.</li>
          <li>Actividad laboral, ingresos, fondos disponibles para la operación, deudas y propiedades actuales.</li>
        </ul>
      </aside>
    </section>

    <section class="page-shell">
      <div class="info-strip">
        <div class="info-item">
          <strong>1. Perfil de compra</strong>
          <span>Identificamos si buscas comprar, refinanciar o retirar dinero, junto con el uso previsto de la propiedad.</span>
        </div>
        <div class="info-item">
          <strong>2. Ruta del comprador</strong>
          <span>El flujo distingue compradores locales, extranjeros, ITIN, pasaporte, LLC, inversión o revisión manual.</span>
        </div>
        <div class="info-item">
          <strong>3. Siguiente paso</strong>
          <span>Al finalizar, se genera una clasificación preliminar y se envía el caso para revisión de un asesor.</span>
        </div>
      </div>
    </section>

    <section class="wizard-wrap page-shell" id="formulario">
      <div class="wizard-header">
        <div>
          <div class="eyebrow">Wizard hipotecario</div>
          <h2>Evaluación de precalificación</h2>
          <p>No constituye aprobación de crédito. Sirve para ordenar tu perfil antes de la revisión profesional.</p>
        </div>
        <div class="progress-box" aria-label="Progreso del formulario">
          <div class="progress-meta">
            <span>Progreso</span>
            <span id="progressText">0%</span>
          </div>
          <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
        </div>
      </div>

      <div class="step-nav" aria-label="Navegación del formulario">
        <button type="button" data-step-target="0" class="active">Contacto</button>
        <button type="button" data-step-target="1">Préstamo</button>
        <button type="button" data-step-target="2">Propiedad</button>
        <button type="button" data-step-target="3">Perfil</button>
        <button type="button" data-step-target="4">Ingresos</button>
        <button type="button" data-step-target="5">Crédito</button>
        <button type="button" data-step-target="6">Confirmación</button>
      </div>

      <form id="mortgageWizard" novalidate>
        <section class="form-step active" data-step="0">
          <div class="step-kicker">Paso 1</div>
          <h2>Datos de contacto</h2>
          <p>Usaremos esta información para identificar tu evaluación y coordinar el contacto con un asesor.</p>

          <div class="form-grid">
            <div class="field">
              <label for="firstName">Nombre</label>
              <input id="firstName" name="firstName" type="text" autocomplete="given-name" required placeholder="Nombre" />
            </div>
            <div class="field">
              <label for="lastName">Apellido</label>
              <input id="lastName" name="lastName" type="text" autocomplete="family-name" required placeholder="Apellido" />
            </div>
            <div class="field">
              <label for="email">Correo electrónico</label>
              <input id="email" name="email" type="email" autocomplete="email" required placeholder="correo@dominio.com" />
            </div>
            <div class="field">
              <label for="phone">Teléfono / WhatsApp</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" required placeholder="Código de país + número" />
            </div>
            <div class="field">
              <label for="countryResidence">País de residencia actual</label>
              <select id="countryResidence" name="countryResidence" required>
                <option value="">Selecciona una opción</option>
                <option>Estados Unidos</option>
                <option>Ecuador</option>
                <option>Colombia</option>
                <option>México</option>
                <option>Chile</option>
                <option>Argentina</option>
                <option>Perú</option>
                <option>Otro</option>
              </select>
            </div>
            <div class="field">
              <label for="preferredLanguage">Idioma de atención</label>
              <select id="preferredLanguage" name="preferredLanguage" required>
                <option value="">Selecciona una opción</option>
                <option>Español</option>
                <option>Inglés</option>
                <option>Ambos</option>
              </select>
            </div>
          </div>
          <div class="error-box" role="alert"></div>
        </section>

        <section class="form-step" data-step="1">
