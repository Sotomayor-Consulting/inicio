                <label class="option-card"><input type="checkbox" name="employmentTypes" value="Inversionista" /> Inversionista</label>
                <label class="option-card"><input type="checkbox" name="employmentTypes" value="Jubilado" /> Jubilado</label>
                <label class="option-card"><input type="checkbox" name="employmentTypes" value="Rentista" /> Rentista</label>
