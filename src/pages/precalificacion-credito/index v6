<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Precalificación Hipotecaria en Florida</title>
  <meta name="description" content="Formulario de precalificación hipotecaria para compra, refinanciamiento o inversión en propiedades en Florida." />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@latest/build/css/intlTelInput.css" />
  <style>
    :root{
      --bg:#fbfaf7;
      --surface:#ffffff;
      --ink:#111827;
      --muted:#667085;
      --soft:#f2eee6;
      --line:#ded6c8;
      --gold:#b88a44;
      --gold-dark:#8b642b;
      --navy:#111827;
      --green:#067647;
      --red:#b42318;
      --amber:#b54708;
      --shadow: 0 18px 55px rgba(17,24,39,.07);
      --radius: 26px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color:var(--ink);
      background:
        linear-gradient(90deg, rgba(184,138,68,.08) 1px, transparent 1px),
        linear-gradient(rgba(184,138,68,.07) 1px, transparent 1px),
        radial-gradient(circle at top left, rgba(184,138,68,.16), transparent 34%),
        var(--bg);
      background-size:64px 64px,64px 64px,auto,auto;
    }

    a{color:inherit;text-decoration:none}

    .page{
      width:min(1120px, calc(100% - 32px));
      margin:0 auto;
    }

    .hero{
      padding:62px 0 32px;
      display:grid;
      grid-template-columns:1.08fr .92fr;
      gap:56px;
      align-items:end;
    }

    .eyebrow{
      text-transform:uppercase;
      letter-spacing:.14em;
      font-size:12px;
      font-weight:800;
      color:var(--gold-dark);
      margin:0 0 16px;
    }

    h1{
      margin:0;
      font-family: Georgia, "Times New Roman", serif;
      font-weight:500;
      font-size:clamp(42px, 6vw, 76px);
      line-height:.94;
      letter-spacing:-.06em;
      max-width:820px;
    }

    .hero-copy{
      margin:22px 0 0;
      max-width:710px;
      font-size:18px;
      line-height:1.72;
      color:#4b5563;
    }

    .hero-note{
      border-left:1px solid var(--gold);
      padding:8px 0 8px 22px;
      color:#4b5563;
      line-height:1.65;
      font-size:15px;
    }

    .hero-note strong{color:var(--ink)}

    .top-actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:30px;
    }

    .btn{
      border:0;
      appearance:none;
      cursor:pointer;
      border-radius:999px;
      padding:14px 22px;
      font-weight:800;
      font-size:14px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      transition:.18s ease;
    }

    .btn-primary{background:var(--navy); color:white; box-shadow:0 10px 22px rgba(17,24,39,.18)}
    .btn-primary:hover{transform:translateY(-1px); box-shadow:0 14px 26px rgba(17,24,39,.22)}
    .btn-secondary{background:transparent; border:1px solid var(--line); color:var(--ink)}
    .btn-secondary:hover{border-color:var(--gold); color:var(--gold-dark)}
    .btn[disabled]{opacity:.55; cursor:not-allowed; transform:none; box-shadow:none}

    .process{
      margin:22px auto 38px;
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
      display:grid;
      grid-template-columns:repeat(3, 1fr);
    }

    .process-item{
      padding:26px 28px;
      min-height:122px;
      border-right:1px solid var(--line);
    }
    .process-item:last-child{border-right:0}
    .process-item h3{
      margin:0 0 10px;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-size:13px;
    }
    .process-item p{
      margin:0;
      color:#596273;
      line-height:1.7;
      font-size:14px;
    }

    .qualifier{
      margin:34px auto 70px;
      display:grid;
      grid-template-columns:300px minmax(0,1fr);
      gap:0;
      background:rgba(255,255,255,.82);
      border:1px solid var(--line);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
      backdrop-filter: blur(8px);
    }

    .qualifier-side{
      background:linear-gradient(180deg,#121927,#0f172a);
      color:white;
      padding:34px 28px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      min-height:720px;
    }

    .side-title{
      margin:0 0 8px;
      font-size:22px;
      letter-spacing:-.03em;
    }
    .side-copy{
      margin:0 0 28px;
      color:#d1d5db;
      font-size:14px;
      line-height:1.7;
    }

    .category-list{
      list-style:none;
      padding:0;
      margin:0;
      display:grid;
      gap:6px;
    }
    .category-list li{
      padding:12px 0;
      border-bottom:1px solid rgba(255,255,255,.11);
      display:grid;
      grid-template-columns:26px 1fr auto;
      align-items:center;
      gap:10px;
      color:#cbd5e1;
      font-size:13px;
    }
    .category-list li.active{color:white}
    .category-list li.complete{color:#d7b46b}
    .cat-number{
      width:24px;height:24px;border-radius:50%;
      display:inline-flex;align-items:center;justify-content:center;
      border:1px solid rgba(255,255,255,.25);
      font-size:11px;font-weight:900;
    }
    .category-list li.active .cat-number,
    .category-list li.complete .cat-number{
      border-color:#d7b46b;color:#d7b46b;
    }
    .cat-status{font-size:11px;color:#94a3b8}

    .side-footer{
      margin-top:34px;
      font-size:12px;
      line-height:1.65;
      color:#cbd5e1;
    }

    .qualifier-main{
      padding:42px 44px 36px;
      min-height:720px;
      display:flex;
      flex-direction:column;
    }

    .progress-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
      margin-bottom:28px;
    }
    .category-label{
      margin:0 0 8px;
      color:var(--gold-dark);
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.12em;
      font-size:12px;
    }
    .step-indicator{
      color:var(--muted);
      font-size:13px;
      white-space:nowrap;
      padding-top:2px;
    }
    .progress-line{
      height:4px;
      width:100%;
      background:#ece7df;
      border-radius:999px;
      overflow:hidden;
      margin-bottom:38px;
    }
    .progress-fill{
      width:0%;height:100%;background:var(--gold);transition:.28s ease;
    }

    .question-area{
      flex:1;
      display:flex;
      flex-direction:column;
      justify-content:center;
      min-height:430px;
    }

    .question-title{
      margin:0;
      font-family: Georgia, "Times New Roman", serif;
      font-weight:500;
      font-size:clamp(30px,4.4vw,48px);
      line-height:1.04;
      letter-spacing:-.045em;
      max-width:760px;
    }
    .question-help{
      margin:18px 0 0;
      color:#596273;
      line-height:1.75;
      font-size:16px;
      max-width:720px;
    }

    .answer{
      margin-top:34px;
      max-width:780px;
    }

    input, select, textarea{
      width:100%;
      border:0;
      border-bottom:1px solid #cfc7ba;
      background:transparent;
      color:var(--ink);
      padding:16px 2px;
      font-size:20px;
      outline:none;
      transition:.18s ease;
      border-radius:0;
    }
    textarea{min-height:116px;resize:vertical;font-size:17px;line-height:1.6;border:1px solid var(--line);padding:16px;border-radius:18px;background:#fffdf9}
    input:focus, select:focus{border-bottom-color:var(--gold)}
    textarea:focus{border-color:var(--gold)}
    input::placeholder, textarea::placeholder{color:#a3a3a3}
    input.currency-input{font-variant-numeric: tabular-nums;}

    .select-wrap{position:relative}
    .select-wrap select{appearance:none;cursor:pointer;padding-right:42px}
    .select-wrap::after{content:"⌄";position:absolute;right:8px;top:14px;color:#9a6a2f;font-size:20px;pointer-events:none}
    .other-detail{margin-top:18px}
    .other-detail label{display:block;color:#7a5a2d;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}
    .other-detail textarea{min-height:96px}
    .phone-preview{margin-top:12px;color:#596273;font-size:13px;line-height:1.5}
    .phone-preview strong{color:var(--ink)}
    .phone-combo{display:grid;grid-template-columns:200px minmax(0,1fr);gap:14px;align-items:end;max-width:780px}
    .phone-field{display:flex;flex-direction:column;gap:8px}
    .phone-field span{font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#8a6330}
    .phone-country-select,.phone-number-input{height:64px;border:1px solid var(--line);border-radius:18px;background:#fffdf9;padding:0 16px;font-size:18px;color:var(--ink);outline:none;transition:.18s ease}
    .phone-country-select{appearance:auto;cursor:pointer;font-weight:850;padding-right:10px}
    .phone-number-input{width:100%;font-variant-numeric:tabular-nums;border-bottom:1px solid var(--line)}
    .phone-country-select:focus,.phone-number-input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(178,125,55,.10)}
    .phone-final{margin-top:14px;padding:12px 14px;border:1px solid #eadfcf;border-radius:14px;background:#fffaf2;color:#596273;font-size:13px;line-height:1.45;max-width:780px}
    .phone-final strong{color:var(--ink)}
    .iti{width:100%;max-width:780px}
    .iti .phone-number-input{width:100%;height:64px;border:1px solid var(--line);border-radius:18px;background:#fffdf9;font-size:18px;color:var(--ink);outline:none;transition:.18s ease}
    .iti .phone-number-input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(178,125,55,.10)}
    .iti__selected-country{border-radius:18px 0 0 18px;padding-left:14px}
    .iti__country-list{border:1px solid var(--line);border-radius:14px;box-shadow:0 16px 40px rgba(17,24,39,.14);font-size:14px;max-width:360px}
    .iti__country{padding:10px 12px}
    .iti__country-name{font-weight:800;letter-spacing:.04em}
    .iti__dial-code{color:#8b642b;font-weight:800}
    .option.locked{cursor:not-allowed;opacity:.92}

    .options{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px;
      margin-top:4px;
    }
    .option{
      border:1px solid var(--line);
      background:rgba(255,255,255,.7);
      color:var(--ink);
      border-radius:18px;
      padding:16px 18px;
      min-height:72px;
      text-align:left;
      font-weight:800;
      cursor:pointer;
      transition:.16s ease;
      line-height:1.35;
      display:flex;
      flex-direction:column;
      justify-content:center;
      gap:5px;
    }
    .option-title{
      display:block;
      font-weight:850;
      font-size:14px;
      letter-spacing:-.01em;
    }
    .option-desc{
      display:block;
      color:#667085;
      font-size:12px;
      font-weight:600;
      line-height:1.45;
    }
    .option:hover{border-color:var(--gold); transform:translateY(-1px)}
    .option.selected{
      border-color:var(--gold);
      background:#fff7e8;
      color:#6f4a14;
      box-shadow:0 8px 18px rgba(184,138,68,.10);
    }
    .option.selected .option-desc{color:#805915;}

    .hint-row{
      margin-top:16px;
      color:#6b7280;
      font-size:13px;
      line-height:1.6;
    }

    .validation{
      display:none;
      margin-top:18px;
      color:var(--red);
      background:#fff1f0;
      border-left:3px solid var(--red);
      padding:12px 14px;
      border-radius:0 12px 12px 0;
      font-size:13px;
      font-weight:700;
    }
    .validation.show{display:block}

    .nav-actions{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:14px;
      padding-top:30px;
      border-top:1px solid var(--line);
      margin-top:30px;
    }

    .micro-note{
      color:#707987;
      font-size:12px;
      line-height:1.6;
      max-width:500px;
    }

    .summary{
      display:none;
    }
    .summary.active{display:block}
    .summary h2{
      margin:0;
      font-family: Georgia, "Times New Roman", serif;
      font-weight:500;
      font-size:clamp(34px,4.7vw,54px);
      line-height:1.02;
      letter-spacing:-.05em;
    }
    .summary p{color:#596273;line-height:1.7}

    .summary-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:12px;
      margin:28px 0 20px;
    }
    .metric{
      border:1px solid var(--line);
      border-radius:18px;
      padding:17px;
      background:#fffdf9;
    }
    .metric span{
      display:block;
      color:#7a8290;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-size:11px;
      margin-bottom:10px;
    }
    .metric strong{font-size:22px;letter-spacing:-.025em}

    .badges{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0 24px}
    .badge{border-radius:999px;border:1px solid #efd8a7;background:#fff9ed;color:#8a5205;padding:8px 11px;font-weight:900;font-size:12px}
    .badge.green{border-color:#a9e7c8;background:#ecfdf3;color:#067647}
    .badge.red{border-color:#fecdca;background:#fff1f0;color:#b42318}

    .send-state{
      display:none;
      margin-top:16px;
      padding:14px 16px;
      border-radius:14px;
      font-weight:800;
      font-size:13px;
      line-height:1.55;
    }
    .send-state.show{display:block}
    .send-state.ok{background:#ecfdf3;color:#067647;border:1px solid #abefc6}
    .send-state.warn{background:#fffaeb;color:#b54708;border:1px solid #fedf89}
    .send-state.err{background:#fff1f0;color:#b42318;border:1px solid #fecdca}

    .footer-note{
      margin:0 auto 60px;
      color:#667085;
      font-size:13px;
      line-height:1.75;
      border-top:1px solid var(--line);
      padding-top:22px;
    }

    .hidden{display:none!important}

    @media (max-width: 940px){
      .hero{grid-template-columns:1fr;gap:24px;padding-top:40px}
      .process{grid-template-columns:1fr}
      .process-item{border-right:0;border-bottom:1px solid var(--line)}
      .process-item:last-child{border-bottom:0}
      .qualifier{grid-template-columns:1fr}
      .qualifier-side{min-height:auto;padding:28px}
      .category-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 18px}
      .qualifier-main{min-height:680px;padding:34px 26px 28px}
      .options{grid-template-columns:1fr}
      .summary-grid{grid-template-columns:1fr}
    }

    @media (max-width: 580px){
      .page{width:min(100% - 22px, 1120px)}
      h1{font-size:42px}
      .hero-copy{font-size:16px}
      .top-actions{flex-direction:column}
      .btn{width:100%}
      .category-list{grid-template-columns:1fr}
      .progress-head{display:block}
      .step-indicator{margin-top:8px;display:block}
      .question-title{font-size:32px}
      .nav-actions{flex-direction:column-reverse;align-items:stretch}
      .micro-note{max-width:none;text-align:center}
      input,select{font-size:18px}
    }
  </style>
</head>
<body>
  <main>
    <section class="page hero">
      <div>
        <p class="eyebrow">Precalificación hipotecaria · Florida</p>
        <h1>Conoce tu ruta de financiamiento antes de comprar.</h1>
        <p class="hero-copy">Completa una evaluación breve, guiada y ordenada. Al finalizar, un asesor podrá revisar tu perfil, documentación inicial, tipo de propiedad y alternativa hipotecaria preliminar.</p>
        <div class="top-actions">
          <a class="btn btn-primary" href="#formulario">Comenzar evaluación</a>
          <a class="btn btn-secondary" href="#proceso">Ver cómo funciona</a>
        </div>
      </div>
      <div class="hero-note">
        <strong>Diseñado para compradores locales y extranjeros.</strong><br>
        La evaluación considera compra, refinanciamiento, inversión, ingresos fuera de EE. UU., SSN, ITIN, pasaporte, LLC y fondos disponibles.
      </div>
    </section>

    <section id="proceso" class="page process">
      <div class="process-item">
        <h3>1. Objetivo financiero</h3>
        <p>Identificamos si buscas comprar, refinanciar o retirar capital de una propiedad en Florida.</p>
      </div>
      <div class="process-item">
        <h3>2. Perfil del comprador</h3>
        <p>Revisamos residencia, documentación, ingresos, fondos y capacidad de pago preliminar.</p>
      </div>
      <div class="process-item">
        <h3>3. Revisión inicial</h3>
        <p>Se prepara una ruta preliminar para que un asesor valide el producto hipotecario más adecuado.</p>
      </div>
    </section>

    <section id="formulario" class="page qualifier">
      <aside class="qualifier-side">
        <div>
          <h2 class="side-title">Evaluación guiada</h2>
          <p class="side-copy">Cada categoría se presenta de forma individual para evitar confusión y capturar solo los datos relevantes según tu caso.</p>
          <ol class="category-list" id="categoryList"></ol>
        </div>
        <p class="side-footer">Esta revisión no constituye aprobación final del préstamo. La aprobación queda sujeta a análisis documental, crédito, propiedad, tasación y criterios del entidad hipotecaria.</p>
      </aside>

      <section class="qualifier-main" aria-live="polite">
        <div id="questionView">
          <div class="progress-head">
            <div>
              <p class="category-label" id="categoryLabel">Categoría</p>
              <div class="progress-line"><div class="progress-fill" id="progressFill"></div></div>
            </div>
            <span class="step-indicator" id="stepIndicator">Pregunta 1 de 1</span>
          </div>

          <div class="question-area">
            <h2 class="question-title" id="questionTitle"></h2>
            <p class="question-help" id="questionHelp"></p>
            <div class="answer" id="answerContainer"></div>
            <div class="validation" id="validationBox">Completa esta respuesta para continuar.</div>
          </div>
        </div>

        <div class="summary" id="summaryView">
          <p class="category-label">Resultado preliminar</p>
          <h2>Resumen de precalificación preparado</h2>
          <p id="summaryIntro"></p>
          <div class="summary-grid" id="summaryGrid"></div>
          <div class="badges" id="badges"></div>
          <p id="routeText"></p>
          <div class="send-state" id="sendState"></div>
        </div>

        <div class="nav-actions">
          <button type="button" class="btn btn-secondary" id="backBtn">Atrás</button>
          <p class="micro-note" id="microNote">Tus respuestas se utilizarán para preparar una revisión inicial con un asesor hipotecario.</p>
          <button type="button" class="btn btn-primary" id="nextBtn">Continuar</button>
          <button type="button" class="btn btn-primary hidden" id="submitBtn">Enviar evaluación</button>
        </div>
      </section>
    </section>

    <p class="page footer-note">La información ingresada es referencial y será revisada por un asesor. No reemplaza una solicitud hipotecaria formal ni garantiza aprobación, tasa, plazo o condiciones de financiamiento.</p>
  </main>

  <iframe name="hiddenWebhookFrame" id="hiddenWebhookFrame" class="hidden" title="envio"></iframe>

  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@latest/build/js/intlTelInput.min.js"></script>
  <script>
    const WEBHOOK_URL = "https://n8n.sotomayorconsulting.com/webhook/precalificacion-credito";
    const FORM_VERSION = "v16";

    const categories = [
      { id:"contacto", label:"Contacto", description:"Datos para coordinar la revisión." },
      { id:"objetivo", label:"Objetivo", description:"Compra o refinanciamiento." },
      { id:"propiedad", label:"Propiedad", description:"Datos principales del inmueble." },
      { id:"comprador", label:"Comprador", description:"Documentos y forma de compra." },
      { id:"ingresos", label:"Ingresos", description:"Actividad e ingresos declarados." },
      { id:"fondos", label:"Fondos", description:"Recursos disponibles para la operación." },
      { id:"credito", label:"Crédito", description:"Crédito y deudas actuales." },
      { id:"cierre", label:"Cierre", description:"Próximo paso y autorización." }
    ];

    const COUNTRY_OPTIONS = [
      "Estados Unidos", "México", "Argentina", "Ecuador", "Colombia", "Chile", "Perú", "Brasil",
      "Uruguay", "Paraguay", "Bolivia", "Venezuela", "Panamá", "Costa Rica", "República Dominicana",
      "España", "Canadá", "Otro"
    ];

    const PHONE_RULES = {
      "Estados Unidos": { flag:"🇺🇸", iso:"US", code:"1", localLength:10, example:"+1 305 000 0000" },
      "Canadá": { flag:"🇨🇦", iso:"CA", code:"1", localLength:10, example:"+1 416 000 0000" },
      "México": { flag:"🇲🇽", iso:"MX", code:"52", whatsappPrefix:"1", localLength:10, example:"+52 1 55 0000 0000" },
      "Argentina": { flag:"🇦🇷", iso:"AR", code:"54", whatsappPrefix:"9", minLength:10, example:"+54 9 11 0000 0000" },
      "Ecuador": { flag:"🇪🇨", iso:"EC", code:"593", minLength:9, example:"+593 99 000 0000" },
      "Colombia": { flag:"🇨🇴", iso:"CO", code:"57", localLength:10, example:"+57 300 000 0000" },
      "Chile": { flag:"🇨🇱", iso:"CL", code:"56", localLength:9, example:"+56 9 0000 0000" },
