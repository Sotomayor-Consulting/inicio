    function cleanDependentData(){
      // Remove responses that no longer apply after conditional changes.
      const activeIds = new Set(activeQuestions().map(q => q.id));
      Object.keys(data).forEach(key => {
        const q = questions.find(item => item.id === key);
        if (q && q.visible && !activeIds.has(key)) delete data[key];
      });
    }

    function formatCurrencyInput(value){
      const digits = String(value ?? "").replace(/[^0-9]/g, "");
      if (!digits) return "";
      return new Intl.NumberFormat("en-US", { style:"currency", currency:"USD", maximumFractionDigits:0 }).format(Number(digits));
    }

    function phoneRule(country){
      return PHONE_RULES[country] || null;
    }

    function phoneDialPrefix(country){
      const rule = phoneRule(country);
      if (!rule) return "+";
      return `+${rule.code}${rule.whatsappPrefix ? " " + rule.whatsappPrefix : ""}`;
    }

    function phoneCountryIso(country){
      const rule = phoneRule(country);
      return rule?.iso || (country === "Otro" ? "OTRO" : "");
    }

    function phoneCountryLabel(country){
      if (country === "Otro") return "🌐 OTRO";
      const rule = phoneRule(country);
      return rule ? `${rule.flag || "🌐"} ${rule.iso} ${phoneDialPrefix(country)}` : `🌐 ${country}`;
    }

    const PHONE_COUNTRY_NAME_BY_ISO = {
      US:"Estados Unidos", CA:"Canadá", MX:"México", AR:"Argentina", EC:"Ecuador", CO:"Colombia", CL:"Chile", PE:"Perú", BR:"Brasil",
      UY:"Uruguay", PY:"Paraguay", BO:"Bolivia", VE:"Venezuela", PA:"Panamá", CR:"Costa Rica", DO:"República Dominicana", ES:"España"
    };

    function phoneCountryNameFromIso(iso){
      const key = String(iso || "").toUpperCase();
      return PHONE_COUNTRY_NAME_BY_ISO[key] || key;
    }

    function buildIntlIsoI18n(){
      const result = {};
      const list = window.intlTelInputGlobals?.getCountryData?.() || [];
      list.forEach(country => {
        if (country?.iso2) result[country.iso2] = country.iso2.toUpperCase();
      });
      return result;
    }

    function normalizeWhatsappNumber(e164, iso){
      let number = String(e164 || "").replace(/[^+0-9]/g, "");
      const countryIso = String(iso || "").toUpperCase();
      if (!number.startsWith("+")) number = `+${number.replace(/[^0-9]/g, "")}`;

      if (countryIso === "MX" && number.startsWith("+52") && !number.startsWith("+521")){
        number = `+521${number.slice(3)}`;
      }
      if (countryIso === "AR" && number.startsWith("+54") && !number.startsWith("+549")){
        number = `+549${number.slice(3)}`;
      }
      return number;
    }

    function buildE164Fallback(raw, selectedCountry){
      const digits = String(raw || "").replace(/\D/g, "");
      if (!digits) return "";
      const dial = String(selectedCountry?.dialCode || "").replace(/\D/g, "");
      if (String(raw || "").trim().startsWith("+")) return `+${digits}`;
      if (dial && digits.startsWith(dial) && digits.length > dial.length + 5) return `+${digits}`;
      return dial ? `+${dial}${digits.replace(/^0+/, "")}` : `+${digits}`;
    }

    function syncIntlPhoneData(input, iti){
      const country = iti?.getSelectedCountryData?.() || {};
      const iso = String(country.iso2 || "").toUpperCase();
      const dial = country.dialCode ? `+${country.dialCode}` : "";
      const raw = String(input?.value || "").trim();
      let e164 = "";
      let valid = false;

      try { e164 = iti?.getNumber?.() || ""; } catch (e) { e164 = ""; }
      if (!e164) e164 = buildE164Fallback(raw, country);

      try { valid = Boolean(iti?.isValidNumber?.()); } catch (e) { valid = false; }
      if (!valid) {
        const digitCount = String(e164 || raw || "").replace(/\D/g, "").length;
        valid = digitCount >= 8 && digitCount <= 15;
      }

      data.phone = raw;
      data.phoneCountry = phoneCountryNameFromIso(iso);
      data.phoneCountryIso = iso;
      data.phoneDialCode = dial;
      data.phoneE164 = e164;
      data.whatsAppPhone = normalizeWhatsappNumber(e164, iso);
      data.phoneIsValid = valid;
      return { ok: valid, e164, whatsapp: data.whatsAppPhone, iso, dial };
    }

    function phoneExample(){
      const country = data.phoneCountry || "Estados Unidos";
      const rule = phoneRule(country);
      return rule?.example || "+ país + número";
    }

    function stripPhoneLocalDigits(raw, country){
      const original = String(raw || "").trim();
      let digits = original.replace(/\D/g, "");
      const rule = phoneRule(country);
      if (!digits || !rule) return digits;

      if (country === "México") {
        if (digits.startsWith("521")) digits = digits.slice(3);
        else if (digits.startsWith("52")) digits = digits.slice(2);
        if (digits.startsWith("1") && digits.length === 11) digits = digits.slice(1);
        return digits.replace(/^0+/, "");
      }

      if (country === "Argentina") {
        if (digits.startsWith("549")) digits = digits.slice(3);
        else if (digits.startsWith("54")) digits = digits.slice(2);
        if (digits.startsWith("9") && digits.length >= 11) digits = digits.slice(1);
        digits = digits.replace(/^0+/, "");
        digits = digits.replace(/^(\d{2,4})15/, "$1");
        return digits;
      }

      if (digits.startsWith(rule.code) && digits.length > (rule.localLength || rule.minLength || 8)) {
        digits = digits.slice(rule.code.length);
      }
      if (country !== "Estados Unidos" && country !== "Canadá" && country !== "República Dominicana") {
        digits = digits.replace(/^0+/, "");
      }
      return digits;
    }

    function groupPhoneDigits(digits, groups){
      const parts = [];
      let cursor = 0;
      groups.forEach(size => {
        if (digits.length > cursor) parts.push(digits.slice(cursor, cursor + size));
        cursor += size;
      });
      if (digits.length > cursor) parts.push(digits.slice(cursor));
      return parts.filter(Boolean).join(" ");
    }

    function formatPhoneLocalForDisplay(raw, country){
      const digits = stripPhoneLocalDigits(raw, country);
      if (!digits) return "";
      if (country === "Estados Unidos" || country === "Canadá" || country === "República Dominicana") {
        if (digits.length <= 3) return digits;
        if (digits.length <= 6) return `(${digits.slice(0,3)}) ${digits.slice(3)}`;
        return `(${digits.slice(0,3)}) ${digits.slice(3,6)}-${digits.slice(6,10)}${digits.length > 10 ? " " + digits.slice(10) : ""}`;
      }
      if (country === "México") {
        const twoDigitAreas = ["55","56","33","81"];
        return twoDigitAreas.includes(digits.slice(0,2)) ? groupPhoneDigits(digits, [2,4,4]) : groupPhoneDigits(digits, [3,3,4]);
      }
      if (country === "Argentina") return digits.startsWith("11") ? groupPhoneDigits(digits, [2,4,4]) : groupPhoneDigits(digits, [3,3,4]);
      if (country === "Ecuador") return groupPhoneDigits(digits, [2,3,4]);
      if (country === "Colombia") return groupPhoneDigits(digits, [3,3,4]);
      if (country === "Chile") return groupPhoneDigits(digits, [1,4,4]);
      if (country === "Perú") return groupPhoneDigits(digits, [3,3,3]);
      if (country === "España") return groupPhoneDigits(digits, [3,3,3]);
      return groupPhoneDigits(digits, [3,3,4,4]);
    }

    function normalizePhone(raw, country){
      const original = String(raw || "").trim();
      const hasPlus = original.startsWith("+");
      const rule = phoneRule(country);
      let local = stripPhoneLocalDigits(original, country);

      if (!local) return { ok:false, message:"Ingresa un número de teléfono válido." };

      if (!rule) {
        const digits = original.replace(/\D/g, "");
        if (!hasPlus || digits.length < 8 || digits.length > 15) {
          return { ok:false, message:"Para este país, escribe el número completo con código internacional. Ejemplo: + país + número." };
        }
        return { ok:true, e164:`+${digits}`, whatsapp:`+${digits}` };
      }

      if (country === "México") {
        if (local.length !== 10) return { ok:false, message:"Para México, ingresa 10 dígitos del número móvil. Lo dejaremos en formato WhatsApp como +52 1." };
        return { ok:true, e164:`+52${local}`, whatsapp:`+521${local}` };
      }

      if (country === "Argentina") {
        if (local.length < 10 || local.length > 11) return { ok:false, message:"Para Argentina, ingresa el número móvil con código de área. Lo dejaremos en formato WhatsApp como +54 9." };
        return { ok:true, e164:`+54${local}`, whatsapp:`+549${local}` };
      }

      if (rule.localLength && local.length !== rule.localLength) {
        return { ok:false, message:`Para ${country}, revisa la cantidad de dígitos del número. Ejemplo: ${rule.example}.` };
      }
      if (rule.minLength && local.length < rule.minLength) {
        return { ok:false, message:`Para ${country}, el número parece incompleto. Ejemplo: ${rule.example}.` };
      }
      const normalized = `+${rule.code}${local}`;
      return { ok:true, e164:normalized, whatsapp:normalized };
    }

