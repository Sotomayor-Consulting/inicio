---
const { btnId } = Astro.props;

interface Props {
  btnId: string;
}
---

<astro-banner-redisign btnId={btnId} class="banner-container">
  <div
    class="fixed inset-0 left-0 z-55 h-full w-full p-6 bg-blend-saturation dark:bg-neutral-700/90 flex justify-center items-center opacity-100 transition-opacity duration-500"
    role="region"
    aria-label="Informational Banner"
  >
    <div
      class="h-fit w-fit rounded-xl border border-neutral-700 bg-neutral-100 bg-clip-padding p-4 backdrop-blur-md backdrop-filter dark:border-neutral-600 dark:bg-neutral-800/40"
    >
      <div class="items-center justify-center">
        <div class="flex flex-col">
          <div class="flex justify-end w-full mb-4">
            <button
              type="button"
              class="inline-flex items-center gap-x-2 rounded-full border border-transparent p-1 text-sm font-semibold text-gray-800 hover:bg-gray-200 disabled:pointer-events-none disabled:opacity-50 dark:text-neutral-50 dark:hover:bg-neutral-700/80 dark:hover:text-neutral-50 dark:focus:outline-hidden"
              id={btnId}
            >
              <span class="sr-only">Cerrar</span>
              <svg
                class="size-5 shrink-0"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
              >
            </button>
          </div>

          <div class="flex items-center text-black dark:text-white">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </div>
</astro-banner-redisign>
<script>
  class AstroBannerRedisign extends HTMLElement {
    connectedCallback() {
      const btnId = this.getAttribute("btnId");
      const button = this.querySelector(`#${btnId}`) as HTMLButtonElement | null;
      const banner = this.querySelector<HTMLElement>("[role='region']");
      let isClosing = false;

      const closeBanner = () => {
        if (isClosing) return;

        isClosing = true;

        if (banner == null) {
          this.remove();
          return;
        }

        banner.style.opacity = "0";

        window.setTimeout(() => this.remove(), 500);
      };

      if (button != null) {
        button.addEventListener("click", closeBanner);
      }

      window.setTimeout(closeBanner, 4000);
    }
  }

   if (!customElements.get("astro-banner-redisign")) {
     customElements.define("astro-banner-redisign", AstroBannerRedisign);
   }
</script>
