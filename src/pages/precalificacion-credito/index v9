<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Precalificación Hipotecaria en Florida | Wizard</title>
  <style>
    :root {
      --bg: #f7f5f0;
      --surface: #ffffff;
      --surface-soft: #fbfaf7;
      --ink: #111827;
      --ink-2: #243041;
      --muted: #6b7280;
      --line: #e6dfd2;
      --line-strong: #d5c8b3;
      --accent: #9b6b2d;
      --accent-2: #c59a52;
      --accent-soft: #f5efe5;
      --navy: #071e33;
      --white: #ffffff;
      --ok: #027a48;
      --warn: #b54708;
      --danger: #b42318;
      --radius-xl: 28px;
      --radius-lg: 18px;
      --radius-md: 12px;
      --shadow-soft: 0 24px 70px rgba(17, 24, 39, 0.08);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        linear-gradient(90deg, rgba(155, 107, 45, 0.045) 1px, transparent 1px),
        linear-gradient(180deg, #fbfaf7 0%, var(--bg) 54%, #ffffff 100%);
      background-size: 72px 72px, auto;
      line-height: 1.58;
    }

    a { color: inherit; }

    .page-shell {
      width: min(1120px, calc(100% - 38px));
      margin: 0 auto;
    }

    .topbar {
      padding: 24px 0;
      border-bottom: 1px solid rgba(213, 200, 179, 0.72);
      background: rgba(251, 250, 247, 0.86);
      backdrop-filter: blur(14px);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 14px;
      font-weight: 760;
      color: var(--ink);
      letter-spacing: -0.02em;
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--ink);
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.04em;
    }

    .brand-subtitle {
      font-size: 12px;
      color: var(--muted);
      font-weight: 560;
      letter-spacing: 0.02em;
    }

    .hero {
      padding: clamp(58px, 8vw, 112px) 0 clamp(46px, 6vw, 78px);
      color: var(--ink);
      position: relative;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--line-strong), transparent);
      pointer-events: none;
    }

    .hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.58fr);
      gap: clamp(34px, 6vw, 76px);
      align-items: end;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    .eyebrow::before {
      content: "";
      width: 34px;
      height: 1px;
      background: var(--accent);
      display: inline-block;
    }

    .hero h1 {
      margin: 0;
      max-width: 850px;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 500;
      font-size: clamp(42px, 6vw, 76px);
      line-height: 0.98;
      letter-spacing: -0.055em;
      color: var(--ink);
    }

    .hero p {
      margin: 24px 0 0;
      color: var(--ink-2);
      font-size: clamp(17px, 1.65vw, 20px);
      max-width: 680px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 34px;
    }

    .btn {
      border: 0;
      border-radius: 999px;
      padding: 13px 20px;
      min-height: 48px;
      font-size: 14px;
      font-weight: 780;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .btn:hover { transform: translateY(-1px); }

    .btn-primary {
      background: var(--ink);
      color: var(--white);
      box-shadow: 0 18px 32px rgba(17, 24, 39, 0.16);
    }

    .btn-secondary,
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border: 1px solid var(--line-strong);
    }

    .btn-blue {
      background: var(--accent);
      color: var(--white);
      box-shadow: 0 14px 24px rgba(155, 107, 45, 0.16);
    }

    .hero-card {
      border-left: 1px solid var(--line-strong);
      padding: 8px 0 8px 28px;
      background: transparent;
    }

    .hero-card h3 {
      margin: 0 0 16px;
      font-size: 18px;
      color: var(--ink);
      font-weight: 760;
      letter-spacing: -0.02em;
    }

    .check-list {
      display: grid;
      gap: 14px;
      margin: 0;
      padding: 0;
      list-style: none;
      color: var(--muted);
      font-size: 14px;
    }

    .check-list li {
      display: grid;
      grid-template-columns: 18px 1fr;
      gap: 10px;
      align-items: start;
    }

    .check-list li::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-top: 8px;
      background: var(--accent);
      display: block;
    }

    .section-intro {
      margin: clamp(50px, 7vw, 86px) 0 24px;
      max-width: 830px;
      text-align: left;
    }

    .section-intro h2 {
      margin: 0;
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 500;
      font-size: clamp(31px, 4vw, 52px);
      line-height: 1.04;
      letter-spacing: -0.045em;
    }

    .section-intro p {
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 16px;
      max-width: 720px;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      margin: 30px 0 58px;
      border-top: 1px solid var(--line-strong);
      border-bottom: 1px solid var(--line-strong);
    }

    .benefit-card {
      background: transparent;
      border-right: 1px solid var(--line);
      padding: 26px 28px 28px 0;
      margin-right: 28px;
    }

    .benefit-card:last-child {
      border-right: 0;
      margin-right: 0;
    }

    .benefit-card strong {
      color: var(--ink);
      display: block;
      margin-bottom: 8px;
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .benefit-card span {
      color: var(--muted);
      font-size: 14px;
    }

    .wizard-wrap {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: clamp(26px, 4vw, 54px);
      align-items: start;
      margin-bottom: 54px;
    }

    .wizard-side {
      position: sticky;
      top: 104px;
      background: transparent;
      border: 0;
      padding: 4px 0;
      box-shadow: none;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--muted);
      font-weight: 760;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      margin-bottom: 12px;
    }

    .progress-bar {
      width: 100%;
      height: 3px;
      background: var(--line);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 26px;
    }

    .progress-fill {
      width: 0%;
      height: 100%;
      background: var(--accent);
      border-radius: inherit;
      transition: width 0.3s ease;
    }

    .step-list {
      display: grid;
      gap: 2px;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--line);
    }

    .step-list button {
      width: 100%;
      text-align: left;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: transparent;
      color: var(--muted);
      border-radius: 0;
      padding: 14px 0;
      cursor: pointer;
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 10px;
      align-items: center;
      font-weight: 680;
    }

    .step-index {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1px solid var(--line-strong);
      color: var(--muted);
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 800;
      background: transparent;
    }

    .step-list button.active {
      color: var(--ink);
      font-weight: 820;
    }

    .step-list button.active .step-index {
      background: var(--ink);
      color: var(--white);
      border-color: var(--ink);
    }

    .side-note {
      margin-top: 24px;
      padding: 16px 0 0;
      border-top: 1px solid var(--line-strong);
      color: var(--muted);
      font-size: 13px;
      font-weight: 560;
    }

    .wizard-main {
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-soft);
      overflow: hidden;
      backdrop-filter: blur(12px);
    }

    .form-step {
      display: none;
      padding: clamp(28px, 5vw, 54px);
    }

    .form-step.active { display: block; }

    .step-kicker {
      color: var(--accent);
      font-weight: 820;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .form-step h2 {
      margin: 0;
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 500;
      font-size: clamp(31px, 4vw, 46px);
      line-height: 1.05;
      letter-spacing: -0.045em;
    }

    .form-step > p {
      color: var(--muted);
      margin: 12px 0 32px;
      max-width: 760px;
      font-size: 15px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 22px;
    }

    .field {
      display: grid;
      gap: 8px;
    }

    .field.full { grid-column: 1 / -1; }


    .phone-combo {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr;
      min-height: 56px;
      border: 1px solid var(--line);
      border-radius: 0;
      background: rgba(255, 255, 255, 0.72);
      overflow: visible;
      transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .phone-combo:focus-within {
      border-color: var(--gold);
      box-shadow: 0 10px 30px rgba(128, 84, 23, 0.08);
      background: rgba(255, 255, 255, 0.92);
    }

    .phone-country-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 118px;
      padding: 0 14px;
      border: 0;
      border-right: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.36);
      color: var(--ink);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .phone-country-trigger .flag {
      font-size: 19px;
      line-height: 1;
    }

    .phone-country-trigger .chevron {
      color: var(--muted);
      font-size: 12px;
      transform: translateY(1px);
    }

    .phone-combo input[type="tel"] {
      min-height: 54px;
      border: 0;
      background: transparent;
      padding-left: 16px;
    }

    .phone-combo input[type="tel"]:focus {
      box-shadow: none;
    }

    .phone-country-menu {
      position: absolute;
      z-index: 25;
      top: calc(100% + 6px);
      left: 0;
      width: min(360px, 100%);
      max-height: 264px;
      overflow-y: auto;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 22px 45px rgba(16, 24, 40, 0.16);
      padding: 6px;
    }

    .phone-country-option {
      width: 100%;
      display: grid;
      grid-template-columns: 26px 1fr auto;
      align-items: center;
      gap: 10px;
      border: 0;
      background: transparent;
      color: var(--ink);
      border-radius: 10px;
      padding: 10px 10px;
      font: inherit;
      cursor: pointer;
      text-align: left;
    }

    .phone-country-option:hover,
    .phone-country-option.active {
      background: rgba(128, 84, 23, 0.08);
    }

    .phone-country-option .country-code {
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
    }

    .currency-field {
      font-size: 18px;
      font-weight: 680;
      letter-spacing: -0.02em;
    }

    .calculation-panel {
      grid-column: 1 / -1;
      margin-top: -2px;
      padding-top: 2px;
    }

    .calculation-panel .calculation-note {
      color: var(--muted);
      font-size: 13px;
      margin: 0 0 16px;
    }

    .calculation-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .calc-box {
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 18px 20px;
      background: rgba(255, 255, 255, 0.58);
      min-height: 112px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .calc-box small {
      display: block;
      color: var(--muted);
      font-weight: 820;
      font-size: 11px;
      line-height: 1.35;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 10px;
    }

    .calc-box strong {
      color: var(--ink);
      font-size: clamp(22px, 3vw, 28px);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .calc-box.wide {
      grid-column: span 1;
    }

    label {
      font-weight: 720;
      color: var(--ink);
      font-size: 13px;
      letter-spacing: -0.01em;
    }

    .hint {
      color: var(--muted);
      font-size: 12px;
      margin-top: -2px;
    }

    input, select, textarea {
      width: 100%;
      border: 0;
      border-bottom: 1px solid var(--line-strong);
      border-radius: 0;
      background: transparent;
      padding: 12px 0 13px;
      min-height: 46px;
      color: var(--ink);
      font: inherit;
      outline: none;
      transition: border-color 0.18s ease, background 0.18s ease;
    }

    input::placeholder, textarea::placeholder {
      color: #a39b8f;
    }

    select {
      color: var(--ink);
      cursor: pointer;
    }

    textarea { min-height: 96px; resize: vertical; }

    input:focus, select:focus, textarea:focus {
      border-color: var(--accent);
      background: rgba(245, 239, 229, 0.28);
    }

    .option-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 12px;
    }

    .option-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .option-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .option-card {
      position: relative;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 12px 15px;
      min-height: 50px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.48);
      transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
      font-weight: 640;
      color: var(--ink-2);
    }

    .option-card:hover {
      border-color: var(--accent-2);
      background: var(--accent-soft);
    }

    .option-card input {
      width: 16px;
      height: 16px;
      min-height: auto;
      accent-color: var(--accent);
      border: initial;
      border-bottom: initial;
      padding: initial;
      background: initial;
      flex: 0 0 auto;
    }

    .option-card.detailed {
      border-radius: 18px;
      align-items: flex-start;
      line-height: 1.35;
    }

    .option-card.detailed span {
      display: block;
      font-size: 12px;
      font-weight: 520;
      color: var(--muted);
      margin-top: 2px;
    }

    .option-card.detailed:has(input:checked) span {
      color: rgba(255, 255, 255, 0.78);
    }

    .option-copy {
      display: block;
    }

    .option-card:has(input:checked) {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--white);
    }

    .option-card.detailed:has(input:checked) span {
      color: rgba(255, 255, 255, 0.78);
    }

    .conditional-box {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line-strong);
      border-bottom: 1px solid var(--line-strong);
      background: rgba(245, 239, 229, 0.32);
      padding: 24px 0;
      display: none;
      margin-top: 4px;
    }

    .conditional-box.visible { display: block; }

    .conditional-box .form-grid {
      padding: 0 20px;
    }

    .subsection-title {
      margin: 0 20px 14px;
      color: var(--ink);
      font-size: 16px;
      letter-spacing: -0.01em;
      font-weight: 760;
    }

    .wizard-actions {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 24px clamp(28px, 5vw, 54px);
      border-top: 1px solid var(--line-strong);
      background: rgba(251, 250, 247, 0.86);
    }

    .error-box {
      display: none;
      margin-top: 20px;
      border-left: 3px solid var(--danger);
      background: #fff7f6;
      color: var(--danger);
      padding: 12px 14px;
      font-weight: 680;
      font-size: 14px;
    }

    .summary-card {
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-lg);
      padding: 24px;
      background: var(--surface-soft);
      margin-top: 24px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 16px;
    }

    .metric {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 14px;
    }

    .metric small {
      display: block;
      color: var(--muted);
      font-weight: 720;
      margin-bottom: 5px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .metric strong {
      color: var(--ink);
      font-size: 18px;
      letter-spacing: -0.02em;
    }

    .pill-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 16px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 7px 10px;
      font-weight: 760;
      font-size: 12px;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid var(--line-strong);
    }

    .pill.ok { background: #ecfdf3; color: var(--ok); border-color: #abefc6; }
    .pill.warn { background: #fffaeb; color: var(--warn); border-color: #fedf89; }
    .pill.danger { background: #fff1f3; color: var(--danger); border-color: #fecdd6; }

    .json-preview {
      display: none !important;
    }

    .submission-status {
      margin-top: 18px;
      border: 1px solid var(--line-strong);
      border-radius: 18px;
      padding: 16px 18px;
      background: rgba(255,255,255,0.72);
      color: var(--muted);
      font-size: 14px;
      line-height: 1.65;
    }

    .submission-status strong {
      color: var(--ink);
      display: block;
      margin-bottom: 4px;
      font-size: 15px;
    }

    .submission-status.ok {
      border-color: #abefc6;
      background: #ecfdf3;
      color: #067647;
    }

    .submission-status.fail {
      border-color: #fecdd6;
      background: #fff1f3;
      color: #b42318;
    }

    .legal-note {
      border-top: 1px solid var(--line-strong);
      border-bottom: 1px solid var(--line-strong);
      padding: 22px 0;
      color: var(--muted);
      font-size: 13px;
      margin: 30px 0 50px;
      background: transparent;
    }

    .legal-note strong { color: var(--ink); }

    .footer {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      padding: 24px 0 42px;
    }

    [hidden] { display: none !important; }

    @media (max-width: 940px) {
      .topbar { position: relative; }

      .hero-grid,
      .wizard-wrap,
      .benefits-grid {
        grid-template-columns: 1fr;
      }

      .hero-card {
        border-left: 0;
        border-top: 1px solid var(--line-strong);
        padding: 24px 0 0;
      }

      .benefits-grid { border-bottom: 0; }

      .benefit-card {
        border-right: 0;
        border-bottom: 1px solid var(--line);
        margin-right: 0;
        padding-right: 0;
      }

      .wizard-side {
        position: relative;
        top: auto;
      }

      .step-list {
        grid-template-columns: repeat(2, 1fr);
        gap: 0 18px;
      }
    }

    @media (max-width: 660px) {
      .page-shell { width: min(100% - 24px, 1120px); }
      .hero { padding: 46px 0 36px; }
      .hero h1 { font-size: clamp(38px, 13vw, 52px); }
      .form-grid,
      .option-grid,
      .option-grid.three,
      .option-grid.two,
      .summary-grid,
      .calculation-grid {
        grid-template-columns: 1fr;
      }
      .phone-combo { grid-template-columns: 108px 1fr; }
      .phone-country-trigger { min-width: 108px; padding: 0 10px; }
