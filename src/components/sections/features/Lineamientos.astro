---
interface Props {
  title: string;
  description: string;
  titleM: string;
  descriptionM: string;
  titleV: string;
  descriptionV: string;
}

const { title, description, titleM, descriptionM, titleV, descriptionV} = Astro.props
---

<div
  class="justify center flex flex-col text-primario-black dark:text-neutral-300"
>
  <h4 class="mb-5 text-3xl font-bold"> {title}</h4>
  <p class="w-full md:w-1/2">
    {description}
  </p>
</div>
<!-- Icon Blocks -->
<div class="mx-auto w-full py-10 lg:py-14">
  <div class="grid gap-6 sm:grid-cols-2 md:gap-10">
    <!-- Card -->
    <div class="size-full rounded-xl bg-white p-5 shadow-lg dark:bg-[#262626]">
      <div class="mb-3 flex items-center gap-x-4">
        <div
          class="inline-flex size-15.5 items-center justify-center rounded-full border-4 border-[#0e2738] bg-[#0e2738] text-white dark:border-[#b98d33] dark:bg-[#b98d33]"
        >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 shrink-0 text-white " width="24" height="24" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 22q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22m0-2q3.35 0 5.675-2.325T20 12t-2.325-5.675T12 4T6.325 6.325T4 12t2.325 5.675T12 20m0-2q-2.5 0-4.25-1.75T6 12t1.75-4.25T12 6t4.25 1.75T18 12t-1.75 4.25T12 18m0-2q1.65 0 2.825-1.175T16 12t-1.175-2.825T12 8T9.175 9.175T8 12t1.175 2.825T12 16m0-2q-.825 0-1.412-.587T10 12t.588-1.412T12 10t1.413.588T14 12t-.587 1.413T12 14" />
        </svg>
        </div>
        <div class="shrink-0">
          <h3 class="block text-lg font-semibold text-primario-black dark:text-white">
            
            {titleM}
          </h3>
        </div>
      </div>
      <p class="text-primario-black dark:text-neutral-400">
        {descriptionM}
      </p>
    </div>
    <!-- End Card -->

    <!-- Card -->
    <div class="size-full rounded-xl bg-white p-5 shadow-lg dark:bg-[#262626]">
      <div class="mb-3 flex items-center gap-x-4">
        <div
          class="inline-flex size-15.5 items-center justify-center rounded-full border-4 border-[#0e2738] bg-[#0e2738] text-white dark:border-[#b98d33] dark:bg-[#b98d33]"
        >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 shrink-0 text-white " width="24" height="24" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 9a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3m0 8a5 5 0 0 1-5-5a5 5 0 0 1 5-5a5 5 0 0 1 5 5a5 5 0 0 1-5 5m0-12.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5" />
        </svg>
        </div>
        <div class="shrink-0">
          <h3 class="block text-lg font-semibold text-primario-black dark:text-white">
            {titleV}
          </h3>
        </div>
      </div>
      <p class="text-primario-black dark:text-neutral-400">
        {descriptionV}
      </p>
    </div>
    <!-- End Card -->
  </div>
</div>
<!-- End Icon Blocks -->
