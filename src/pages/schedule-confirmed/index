<script type="text/javascript" data-cfasync="false">
  (function () {
    "use strict";

    const root = document.getElementById("sci-schedule-confirmed");
    if (!root || root.dataset.initialized === "true") return;

    root.dataset.initialized = "true";

    const CONFIG = Object.freeze({
      version: "4.0",
      validationEndpoint: "https://n8n.sotomayorconsulting.com/webhook/schedule-confirmed-validate",
      whatsappNumber: "17542175066",
      defaultTimezone: "America/Guayaquil"
    });

    const preservedQuery = typeof window.__SCI_SCHEDULE_QUERY__ === "string"
      ? window.__SCI_SCHEDULE_QUERY__
      : "";
    const params = new URLSearchParams(preservedQuery);

    const elements = Object.freeze({
      title: root.querySelector("#sci-title"),
      statusMessage: root.querySelector("#sci-status-message"),
      navbarStatus: root.querySelector("#sci-navbar-status"),
      retryButton: root.querySelector("#sci-retry-validation"),
      footnote: root.querySelector("#sci-footnote"),
      validationLoader: root.querySelector("#sci-validation-loader"),
      validationStage: root.querySelector("#sci-validation-stage"),
      validationTime: root.querySelector("#sci-validation-time"),
      supportActions: root.querySelector("#sci-support-actions"),
      whatsappButton: root.querySelector("#sci-whatsapp-support"),
      calendarButton: root.querySelector("#sci-google-calendar"),
      validationContent: Array.from(root.querySelectorAll("[data-validation-content]"))
    });

    const booking = Object.freeze({
      fullName: readParam("fullName"),
      email: normalizeEmail(readParam("email")),
      phone: readParam("a[0]") || readParam("phone"),
      detail: readParam("a[1]") || readParam("detail"),
      timezone: getSafeTimezone(readParam("timezone") || CONFIG.defaultTimezone),
      duration: readParam("duration"),
      startDate: readParam("startDate")
    });

    const startDate = parseDate(booking.startDate);
    let requestInProgress = false;
    let waitingIntervalId = null;
    let waitingStartedAt = 0;

    configureWhatsappButton("");

    if (elements.retryButton) {
      elements.retryButton.addEventListener("click", validateSchedule);
    }

    console.info("SCI Schedule Confirmed Landing", {
      version: CONFIG.version,
      endpoint: CONFIG.validationEndpoint,
      queryCaptured: Boolean(preservedQuery)
    });

    validateSchedule();

    async function validateSchedule() {
      if (requestInProgress) return;

      requestInProgress = true;
      setValidationState("validating");
      startWaitingVisual();

      try {
        const response = await fetch(buildValidationUrl(), {
          method: "GET",
          mode: "cors",
          cache: "no-store",
          credentials: "omit",
          headers: {
            "Accept": "application/json"
          }
        });

        if (!response.ok) {
          throw new Error("HTTP " + response.status + " al consultar la validación");
        }

        const payload = await response.json();
        const result = extractValidationResult(payload);
        const status = normalizeStatus(result && result.status);
        const requestId = result && result.request_id != null
          ? String(result.request_id).trim()
          : "";

        console.info("SCI validation response", {
          responseShape: Array.isArray(payload) ? "array" : typeof payload,
          status: status,
          requestId: requestId
        });

        if (status === "approved" && requestId) {
          renderApprovedBooking();
          configureWhatsappButton(requestId);
          setValidationState("approved");
          pushScheduleConfirmed(requestId);
          return;
        }

        if (status === "rejected") {
          configureWhatsappButton(requestId);
          setValidationState("rejected");
          pushValidationRejected(requestId);
          return;
        }

        throw new Error("Respuesta de validación inesperada o incompleta");
      } catch (error) {
        console.error("SCI schedule validation error", error);
        setValidationState("error");
      } finally {
        stopWaitingVisual();
        requestInProgress = false;
      }
    }

    function extractValidationResult(payload) {
      if (Array.isArray(payload)) {
        return payload.length > 0 && isPlainObject(payload[0]) ? payload[0] : null;
      }

      if (isPlainObject(payload) && Array.isArray(payload.data)) {
        return payload.data.length > 0 && isPlainObject(payload.data[0])
          ? payload.data[0]
          : null;
      }

      if (isPlainObject(payload) && isPlainObject(payload.data)) {
        return payload.data;
      }

      return isPlainObject(payload) ? payload : null;
    }

    function isPlainObject(value) {
      return Boolean(value && typeof value === "object" && !Array.isArray(value));
    }

    function normalizeStatus(value) {
      return String(value || "").trim().toLowerCase();
    }

    function buildValidationUrl() {
      const url = new URL(CONFIG.validationEndpoint);
      const allowedFields = [
        ["fullName", booking.fullName],
        ["email", booking.email],
        ["timezone", booking.timezone],
        ["a[0]", booking.phone],
        ["a[1]", booking.detail],
        ["duration", booking.duration],
        ["startDate", booking.startDate]
      ];

      allowedFields.forEach(function (entry) {
        const key = entry[0];
        const value = entry[1];
        if (value) url.searchParams.set(key, value);
      });

      url.searchParams.set("_validation_ts", String(Date.now()));
      return url.toString();
    }

    function renderApprovedBooking() {
      setText("#sci-full-name", booking.fullName, "No informado");
      setText("#sci-email", booking.email, "No informado");
      setText("#sci-phone", booking.phone, "No informado");
      setText("#sci-timezone", booking.timezone, "No informada");
      setText("#sci-extra-detail", booking.detail, "No informado");
      setText(
        "#sci-duration",
        booking.duration ? booking.duration + " minutos" : "",
        "No informada"
      );

      if (startDate) {
        const dayName = new Intl.DateTimeFormat("es-EC", {
          weekday: "long",
          timeZone: booking.timezone
        }).format(startDate);

        const dateText = new Intl.DateTimeFormat("es-EC", {
          day: "2-digit",
          month: "long",
          year: "numeric",
          timeZone: booking.timezone
        }).format(startDate);

        const timeText = new Intl.DateTimeFormat("es-EC", {
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
          timeZone: booking.timezone
        }).format(startDate);

        setText("#sci-day-name", capitalize(dayName), "Fecha");
        setText("#sci-meeting-date", capitalize(dateText), "Fecha por confirmar");
        setText(
          "#sci-meeting-time",
          timeText + " hrs - " + booking.timezone,
          "Hora por confirmar"
        );
      }

      configureGoogleCalendar();
    }

    function configureGoogleCalendar() {
      if (!elements.calendarButton) return;

      if (!startDate) {
        elements.calendarButton.hidden = true;
        return;
      }

      const parsedDuration = Number.parseInt(booking.duration, 10);
      const durationMinutes = Number.isFinite(parsedDuration) && parsedDuration > 0
        ? parsedDuration
        : 60;
      const endDate = new Date(startDate.getTime() + durationMinutes * 60 * 1000);
      const calendarUrl = new URL("https://calendar.google.com/calendar/render");

      calendarUrl.searchParams.set("action", "TEMPLATE");
      calendarUrl.searchParams.set("text", "Asesoría con Sotomayor Consulting");
      calendarUrl.searchParams.set(
        "details",
        "Reunión de asesoría agendada con Sotomayor Consulting International."
      );
      calendarUrl.searchParams.set(
        "dates",
        toGoogleDate(startDate) + "/" + toGoogleDate(endDate)
      );
      calendarUrl.searchParams.set("ctz", booking.timezone);

      elements.calendarButton.href = calendarUrl.toString();
      elements.calendarButton.hidden = false;
    }

    function configureWhatsappButton(requestId) {
      if (!elements.whatsappButton) return;

      const reference = requestId ? " Referencia: " + requestId + "." : "";
      const message = "Hola, necesito ayuda con la validación de mi asesoría." + reference;

      elements.whatsappButton.href =
        "https://wa.me/" + CONFIG.whatsappNumber + "?text=" + encodeURIComponent(message);
    }

    function setValidationState(state) {
      root.classList.remove(
        "is-validating",
        "is-approved",
        "is-rejected",
        "is-validation-error"
      );
      root.setAttribute("aria-busy", state === "validating" ? "true" : "false");

      elements.validationContent.forEach(function (element) {
        element.hidden = state !== "approved";
      });

      if (elements.validationLoader) {
        elements.validationLoader.hidden = state !== "validating";
      }
      if (elements.retryButton) {
        elements.retryButton.hidden = state !== "error";
      }
      if (elements.supportActions) {
        elements.supportActions.hidden = state !== "rejected" && state !== "error";
      }

      if (state === "approved") {
        root.classList.add("is-approved");
        setCopy(
          "Agenda confirmada",
          "Tu asesoría fue agendada correctamente",
          "Validamos la información de tu reunión. Revisa el resumen y guarda el horario en tu calendario.",
          "Si necesitas modificar el horario, responde al correo de confirmación o contacta al equipo de Sotomayor Consulting."
        );
        return;
      }

      if (state === "rejected") {
        root.classList.add("is-rejected");
        setCopy(
          "Agenda no confirmada",
          "No pudimos confirmar esta reunión",
          "En este momento no podemos mantener activa una nueva reunión asociada a este registro. Nuestro equipo puede revisar tu caso y orientarte personalmente.",
          "Usa el botón de WhatsApp para solicitar atención del equipo."
        );
        return;
      }

      if (state === "error") {
        root.classList.add("is-validation-error");
        setCopy(
          "Validación pendiente",
          "No pudimos verificar tu asesoría",
          "Se produjo un problema de conexión antes de recibir la respuesta final. Puedes intentar nuevamente o solicitar ayuda por WhatsApp.",
          "La reunión no se mostrará como confirmada hasta completar la validación."
        );
        return;
      }

      root.classList.add("is-validating");
      setCopy(
        "Validando agenda",
        "Estamos validando tu asesoría",
        "Estamos contrastando los datos de la reserva. Este proceso puede tardar unos segundos.",
        "Espera el resultado de la validación antes de cerrar esta ventana."
      );
    }

    function setCopy(navbar, title, message, note) {
      if (elements.navbarStatus) elements.navbarStatus.textContent = navbar;
      if (elements.title) elements.title.textContent = title;
      if (elements.statusMessage) elements.statusMessage.textContent = message;
      if (elements.footnote) elements.footnote.textContent = note;
    }

    function startWaitingVisual() {
      waitingStartedAt = Date.now();
      updateWaitingVisual();
      window.clearInterval(waitingIntervalId);
      waitingIntervalId = window.setInterval(updateWaitingVisual, 1000);
    }

    function stopWaitingVisual() {
      window.clearInterval(waitingIntervalId);
      waitingIntervalId = null;
    }

    function updateWaitingVisual() {
      const elapsed = Math.max(0, Math.floor((Date.now() - waitingStartedAt) / 1000));

      if (elapsed < 6) {
        setWaitingCopy(
          "Conectando con el sistema de validación",
          "No cierres esta ventana mientras revisamos tu agenda."
        );
        return;
      }

      if (elapsed < 15) {
        setWaitingCopy(
          "Consultando la información registrada",
          "Estamos revisando la reserva y los datos disponibles en nuestro sistema."
        );
        return;
      }

      if (elapsed < 30) {
        setWaitingCopy(
          "Aplicando las reglas de agendamiento",
          "La consulta sigue activa. Esperaremos la respuesta final antes de mostrar un resultado."
        );
        return;
      }

      setWaitingCopy(
        "La validación sigue en curso",
        "El sistema está tardando más de lo habitual, pero la consulta continúa activa."
      );
    }

    function setWaitingCopy(stage, detail) {
      if (elements.validationStage) elements.validationStage.textContent = stage;
      if (elements.validationTime) elements.validationTime.textContent = detail;
    }

    function pushScheduleConfirmed(requestId) {
      const eventId = "sci_schedule_" + requestId;
      const storageKey = "sci_schedule_confirmed_" + requestId;

      if (hasSessionFlag(storageKey)) return;

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "schedule_confirmed",
        event_source: "sci_schedule_confirmed_page",
        event_id: eventId,
        validation_request_id: requestId,
        content_type: "service",
        content_name: "Asesoría Sotomayor Consulting",
        content_category: "schedule_confirmed",
        currency: "USD",
        value: 0,
        meeting_duration: booking.duration || "60",
        meeting_timezone: booking.timezone,
        meeting_start_date: booking.startDate,
        page_path: window.location.pathname,
        page_location_clean: window.location.origin + window.location.pathname
      });

      setSessionFlag(storageKey);
    }

    function pushValidationRejected(requestId) {
      const storageKey = "sci_schedule_rejected_" + (requestId || "without_id");
      if (hasSessionFlag(storageKey)) return;

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "schedule_validation_rejected",
        event_source: "sci_schedule_confirmed_page",
        validation_request_id: requestId || "",
        page_path: window.location.pathname,
        page_location_clean: window.location.origin + window.location.pathname
      });

      setSessionFlag(storageKey);
    }

    function hasSessionFlag(key) {
      try {
        return Boolean(window.sessionStorage && window.sessionStorage.getItem(key) === "true");
      } catch (error) {
        return false;
      }
    }

    function setSessionFlag(key) {
      try {
        if (window.sessionStorage) window.sessionStorage.setItem(key, "true");
      } catch (error) {}
    }

    function readParam(key) {
      const value = params.get(key);
      return value == null ? "" : String(value).replace(/\u00A0/g, " ").trim();
    }

    function normalizeEmail(value) {
      return String(value || "").trim().toLowerCase();
    }

    function getSafeTimezone(value) {
      const candidate = String(value || "").trim() || CONFIG.defaultTimezone;

      try {
        new Intl.DateTimeFormat("es-EC", { timeZone: candidate }).format(new Date());
        return candidate;
      } catch (error) {
        return CONFIG.defaultTimezone;
      }
    }

    function parseDate(value) {
      if (!value) return null;
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? null : date;
    }

    function setText(selector, value, fallback) {
      const element = root.querySelector(selector);
      if (!element) return;
      element.textContent = value || fallback;
    }

    function toGoogleDate(date) {
      return date.toISOString().replace(/[-:]/g, "").split(".")[0] + "Z";
    }

    function capitalize(value) {
      return value ? value.charAt(0).toUpperCase() + value.slice(1) : value;
    }
  })();
</script>
