    async function sendLeadToWebhook(payload) {
      try {
        const response = await fetch(CONFIG.webhookUrl, {
          method: "POST",
          mode: "cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        return response.ok;
      } catch (error) {
        console.warn("Webhook CORS/JSON falló. Intentando fallback no-cors:", error);
      }
      try {
        await fetch(CONFIG.webhookUrl, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=UTF-8" },
          body: JSON.stringify({ ...payload, transport_fallback: "no-cors-text-plain" })
        });
        return false;
      } catch (fallbackError) {
        console.warn("Fallback no-cors falló:", fallbackError);
        return false;
      }
    }

