    async function sotoRequestLeadLookup(payload) {
      const controller = new AbortController();
      const timeout = window.setTimeout(function () {
        controller.abort();
      }, 12000);

      try {
        const response = await fetch(SOTO_LEAD_LOOKUP_WEBHOOK, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload),
          signal: controller.signal
        });

        const contentType = response.headers.get('content-type') || '';
        let data = {};

        if (contentType.includes('application/json')) {
          data = await response.json();
        } else {
          const text = await response.text();
          try {
            data = JSON.parse(text);
          } catch (error) {
            data = { status: response.ok ? 'ok' : 'error', message: text };
          }
        }

        if (!response.ok) {
          throw new Error(data.message || 'No se pudo consultar el registro.');
        }

        return data;
      } finally {
        window.clearTimeout(timeout);
      }
    }

    function sotoInitLeadLookup() {
      const form = document.getElementById('leadLookupForm');
      const input = document.getElementById('lookupValue');

      if (!form || !input) return;

      form.addEventListener('submit', async function (event) {
        event.preventDefault();

        const lookupType = sotoDetectLookupType(input.value);
        const lookupValue = sotoNormalizeLookupValue(input.value, lookupType);

        if (!lookupType || !lookupValue) {
          sotoSetLookupFeedback(
            'warning',
            'Revisa el dato ingresado',
            'Ingresa el WhatsApp o email que usaste en el registro para continuar con la agenda.'
          );
          input.focus();
          return;
        }

        const payload = sotoBuildLeadLookupPayload(lookupValue, lookupType);

        window.dataLayer.push({
          event: 'lead_lookup_started',
          lookup_type: lookupType,
          event_id: payload.event_id
        });

        sotoSetLookupLoading(true);

        try {
          const responseData = await sotoRequestLeadLookup(payload);
          const lookupResult = sotoReadLookupResult(responseData);

          if (lookupResult.found && lookupResult.url) {
            sotoUpdateCalendarUrl(lookupResult.url, 'prefilled');

            window.dataLayer.push({
              event: 'lead_lookup_found',
              lookup_type: lookupType,
              event_id: payload.event_id,
              lead_token_present: Boolean(lookupResult.lead_token)
            });

            sotoSetLookupFeedback(
              'success',
              'Agenda lista',
              'Ya vinculamos tu registro. Ahora puedes elegir el horario que mejor te acomode.',
              lookupResult.url,
              'Elegir horario'
            );

            document.getElementById('agenda')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
          }

          window.dataLayer.push({
            event: 'lead_lookup_not_found',
            lookup_type: lookupType,
            event_id: payload.event_id
          });

          sotoShowCalendar(false);

          sotoSetLookupFeedback(
            'warning',
            'No pudimos vincular el registro',
            'Intenta con el otro WhatsApp o correo que pudiste haber utilizado en el registro.'
          );
        } catch (error) {
          console.warn('[Sotomayor] Error en consulta de lead:', error);

          window.dataLayer.push({
            event: 'lead_lookup_error',
            lookup_type: lookupType,
            event_id: payload.event_id,
            error_message: error && error.message ? error.message : 'lookup_error'
          });

          sotoShowCalendar(false);

          sotoSetLookupFeedback(
            'error',
            'No pudimos validar el dato',
            'Intenta nuevamente en unos minutos o verifica que el dato ingresado sea el mismo de tu registro.'
          );
        } finally {
          sotoSetLookupLoading(false);
        }
      });
    }

    function sotoInitTestimonialCarousel() {
      const carousel = document.getElementById('testimonialCarousel');
      if (!carousel) return;

      const track = carousel.querySelector('.testimonial-track');
      const prevButton = carousel.querySelector('.carousel-button.prev');
      const nextButton = carousel.querySelector('.carousel-button.next');
      const dotsContainer = carousel.querySelector('.carousel-dots');
      if (!track || !dotsContainer) return;

      const testimonials = Array.from(track.querySelectorAll('.testimonial'));
      if (testimonials.length < 2) return;

      // Orden aleatorio en cada carga. Se muestran dos perfiles por grupo.
      for (let i = testimonials.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [testimonials[i], testimonials[j]] = [testimonials[j], testimonials[i]];
      }

      track.innerHTML = '';
      for (let i = 0; i < testimonials.length; i += 2) {
        const page = document.createElement('div');
        page.className = 'testimonial-page';
        page.appendChild(testimonials[i]);
        if (testimonials[i + 1]) page.appendChild(testimonials[i + 1]);
        track.appendChild(page);
      }

      const pages = Array.from(track.querySelectorAll('.testimonial-page'));
      let currentIndex = Math.floor(Math.random() * pages.length);
      let autoplayId = null;
      const autoplayDelay = 4000; // intervalo consistente, superior al mínimo de 2 segundos

      pages.forEach(function (_, index) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'carousel-dot';
        dot.setAttribute('aria-label', 'Mostrar testimonios ' + (index + 1));
        dot.addEventListener('click', function () {
          goTo(index);
          restartAutoplay();
        });
        dotsContainer.appendChild(dot);
      });

      const dots = Array.from(dotsContainer.querySelectorAll('.carousel-dot'));

      function goTo(index) {
        currentIndex = (index + pages.length) % pages.length;
        track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
        dots.forEach(function (dot, dotIndex) {
          dot.classList.toggle('is-active', dotIndex === currentIndex);
        });
      }

      function startAutoplay() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || autoplayId) return;
        autoplayId = window.setInterval(function () { goTo(currentIndex + 1); }, autoplayDelay);
      }

      function stopAutoplay() {
        if (autoplayId) window.clearInterval(autoplayId);
        autoplayId = null;
      }

      function restartAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      prevButton?.addEventListener('click', function () { goTo(currentIndex - 1); restartAutoplay(); });
      nextButton?.addEventListener('click', function () { goTo(currentIndex + 1); restartAutoplay(); });
      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', startAutoplay);
      carousel.addEventListener('focusin', stopAutoplay);
      carousel.addEventListener('focusout', startAutoplay);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stopAutoplay(); else startAutoplay();
      });

      goTo(currentIndex);
      startAutoplay();
    }

    function sotoInitAgendaScrollButton() {
      const button = document.getElementById('agendaScrollButton');
      const calendar = document.getElementById('calendarCard');
      if (!button || !calendar) return;

      button.addEventListener('click', function () {
        calendar.scrollIntoView({ behavior: 'smooth', block: 'center' });
        window.dataLayer.push({
          event: 'agenda_scroll_assist_clicked',
          event_source: 'sotomayor_thank_you_page'
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      sotoGetStoredTtclid();

      sotoTrack('PageView', {
        description: SOTO_TIKTOK_EVENT_CONFIG.PageView.description
      });

      sotoTrack('ViewContent', {
        description: SOTO_TIKTOK_EVENT_CONFIG.ViewContent.description
      });

      sotoTrack('SubmitForm', {
        description: SOTO_TIKTOK_EVENT_CONFIG.SubmitForm.description,
        form_context: 'tiktok_native_lead_form_redirect'
      });

      document.querySelectorAll('[data-track-schedule]').forEach(function (element) {
        element.addEventListener('click', function () {
          const scheduleUrl = element.getAttribute('href') || SOTO_DEFAULT_ZCAL_URL;

          sotoTrack('Schedule', {
            description: SOTO_TIKTOK_EVENT_CONFIG.Schedule.description,
            schedule_url: scheduleUrl,
            schedule_context: element.hasAttribute('data-manual-schedule') ? 'manual_schedule_fallback' : 'click_to_open_zcal'
          });
        });
      });

      sotoInitLeadLookup();
      sotoInitTestimonialCarousel();
      sotoInitAgendaScrollButton();
    });
  </script>
