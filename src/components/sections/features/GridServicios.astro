---
import { Image } from "astro:assets";
import ImagenMock from "@images/mockup.avif";
import GridFlags from "@components/ui/cards/GridFlags.astro";
import { banderas } from "@data/generales.json";

interface Props {
  title: string;
  description: string;
  link: string;
  grid2: string;
  grid3: string;
  grid3link: string;
  grid4: string;
  grid4link: string;
}

const { grid4, grid4link, grid3, grid3link, grid2, title, description, link } = Astro.props;
---

<div
  class="mx-auto my-20 grid max-w-9xl grid-cols-2 grid-rows-4 gap-4 max-xl:h-137.5 max-md:h-[80vh] max-sm:h-225 max-sm:gap-3 md:grid-cols-4 md:grid-rows-2 xl:h-[700px]"
>
  <div
    class="z-40 col-start-2 row-start-2 rounded-2xl border-transparent bg-linear-to-r p-[.2rem] transition-all duration-150 ease-in hover:scale-105 hover:shadow-[0_10px_50px_rgba(185,141,51,0.2)] md:col-start-4 dark:border-2"
  >
    <div class="h-full w-full overflow-hidden rounded-2xl">
      <div
        class="relative h-full w-full overflow-hidden rounded-2xl bg-linear-to-tr from-white to-[#e5e5e5] dark:bg-linear-to-bl dark:from-[#262626] dark:to-[#171717]"
      >
        <a
          href={grid4link}
          aria-label="View this site's code repository on GitHub"
        >
          <div class="relative flex h-full flex-col gap-8 p-8">
            <div class="z-2">
              <h3
                class="text-primario-black text-4xl font-extrabold max-xl:text-3xl max-md:text-xl dark:text-white"
              >
                {grid4}
              </h3>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              class="absolute -bottom-10 left-30 size-50 text-primario-black opacity-10 ease-in-out group-hover:animate-pulse max-md:left-30 max-sm:left-10 xl:-right-24 xl:-bottom-5 xl:size-56 dark:text-white"
              ><path
                fill="currentColor"
                d="M21 2H6a2 2 0 0 0-2 2v3H2v2h2v2H2v2h2v2H2v2h2v3a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1m-8 2.999c1.648 0 3 1.351 3 3A3.01 3.01 0 0 1 13 11c-1.647 0-3-1.353-3-3.001c0-1.649 1.353-3 3-3M19 18H7v-.75c0-2.219 2.705-4.5 6-4.5s6 2.281 6 4.5z"
              ></path></svg
            >
          </div>
        </a>
      </div>
    </div>
  </div>
  <div
    class="z-40 col-start-1 row-start-2 rounded-2xl border-transparent bg-linear-to-r p-[.2rem] transition-all duration-150 ease-in hover:scale-105 hover:shadow-[0_10px_50px_rgba(185,141,51,0.2)] md:col-start-3"
  >
    <div class="h-full w-full overflow-hidden rounded-2xl">
      <div
        class="relative h-full w-full overflow-hidden rounded-2xl bg-linear-to-tr from-white to-[#e5e5e5] dark:bg-linear-to-bl dark:from-[#262626] dark:to-[#171717]"
      >
        <a
          href={grid3link}
          aria-label="View this site's code repository on GitHub"
        >
          <div class="relative flex h-full flex-col gap-8 p-8">
            <div class="z-2">
              <h3
                class="text-primario-black text-4xl font-extrabold max-xl:text-3xl max-md:text-xl dark:text-white"
              >
                {grid3}
              </h3>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              class="absolute -bottom-10 left-30 size-40 text-primario-black opacity-10 ease-in-out group-hover:animate-pulse max-md:left-30 max-sm:left-10 xl:-right-24 xl:-bottom-5 xl:size-40 dark:text-white"
              ><path
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                d="M12 5H2v17h17V12m-9 2L22 2m-8 0h8v8"></path></svg
            >
          </div>
        </a>
      </div>
    </div>
  </div>
  <div
    class="from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 hover:to-mint-300/30 dark:hover:to-mint-600/30 col-span-2 col-start-1 row-start-1 rounded-2xl bg-linear-to-r p-[.2rem] md:col-start-3"
  >
    <article
      class="group relative z-0 flex h-full w-full flex-col gap-6 overflow-hidden rounded-2xl bg-linear-to-tr from-white to-[#e5e5e5] p-6 transition before:transition hover:shadow-[0_10px_50px_rgba(185,141,51,0.2)] max-lg:gap-4 max-md:gap-3 max-md:p-4 dark:overflow-hidden dark:from-[#262626] dark:to-[#171717]"
    >
      <div class="flex items-center gap-4 max-md:gap-2">
        <svg
          width="1em"
          height="1em"
          class="text-primario-black text-3xl max-md:text-2xl max-sm:text-sm dark:text-white"
          aria-hidden="true"
          data-icon="dashboard"
        >
          <symbol id="ai:local:dashboard" viewBox="0 0 15 15"
            ><path
              fill="currentColor"
              fill-rule="evenodd"
              d="M2.8 1h-.05c-.229 0-.426 0-.6.041A1.5 1.5 0 0 0 1.04 2.15c-.04.174-.04.37-.04.6v2.5c0 .229 0 .426.041.6A1.5 1.5 0 0 0 2.15 6.96c.174.04.37.04.6.04h2.5c.229 0 .426 0 .6-.041A1.5 1.5 0 0 0 6.96 5.85c.04-.174.04-.37.04-.6v-2.5c0-.229 0-.426-.041-.6A1.5 1.5 0 0 0 5.85 1.04C5.676 1 5.48 1 5.25 1zm-.417 1.014c.043-.01.11-.014.417-.014h2.4c.308 0 .374.003.417.014a.5.5 0 0 1 .37.37c.01.042.013.108.013.416v2.4c0 .308-.003.374-.014.417a.5.5 0 0 1-.37.37C5.575 5.996 5.509 6 5.2 6H2.8c-.308 0-.374-.003-.417-.014a.5.5 0 0 1-.37-.37C2.004 5.575 2 5.509 2 5.2V2.8c0-.308.003-.374.014-.417a.5.5 0 0 1 .37-.37M9.8 1h-.05c-.229 0-.426 0-.6.041A1.5 1.5 0 0 0 8.04 2.15c-.04.174-.04.37-.04.6v2.5c0 .229 0 .426.041.6A1.5 1.5 0 0 0 9.15 6.96c.174.04.37.04.6.04h2.5c.229 0 .426 0 .6-.041a1.5 1.5 0 0 0 1.11-1.109c.04-.174.04-.37.04-.6v-2.5c0-.229 0-.426-.041-.6a1.5 1.5 0 0 0-1.109-1.11c-.174-.04-.37-.04-.6-.04zm-.417 1.014c.043-.01.11-.014.417-.014h2.4c.308 0 .374.003.417.014a.5.5 0 0 1 .37.37c.01.042.013.108.013.416v2.4c0 .308-.004.374-.014.417a.5.5 0 0 1-.37.37c-.042.01-.108.013-.416.013H9.8c-.308 0-.374-.003-.417-.014a.5.5 0 0 1-.37-.37C9.004 5.575 9 5.509 9 5.2V2.8c0-.308.003-.374.014-.417a.5.5 0 0 1 .37-.37M2.75 8h2.5c.229 0 .426 0 .6.041A1.5 1.5 0 0 1 6.96 9.15c.04.174.04.37.04.6v2.5c0 .229 0 .426-.041.6a1.5 1.5 0 0 1-1.109 1.11c-.174.04-.37.04-.6.04h-2.5c-.229 0-.426 0-.6-.041a1.5 1.5 0 0 1-1.11-1.109c-.04-.174-.04-.37-.04-.6v-2.5c0-.229 0-.426.041-.6A1.5 1.5 0 0 1 2.15 8.04c.174-.04.37-.04.6-.04m.05 1c-.308 0-.374.003-.417.014a.5.5 0 0 0-.37.37C2.004 9.425 2 9.491 2 9.8v2.4c0 .308.003.374.014.417a.5.5 0 0 0 .37.37c.042.01.108.013.416.013h2.4c.308 0 .374-.004.417-.014a.5.5 0 0 0 .37-.37c.01-.042.013-.108.013-.416V9.8c0-.308-.003-.374-.014-.417a.5.5 0 0 0-.37-.37C5.575 9.004 5.509 9 5.2 9zm7-1h-.05c-.229 0-.426 0-.6.041A1.5 1.5 0 0 0 8.04 9.15c-.04.174-.04.37-.04.6v2.5c0 .229 0 .426.041.6a1.5 1.5 0 0 0 1.109 1.11c.174.041.371.041.6.041h2.5c.229 0 .426 0 .6-.041a1.5 1.5 0 0 0 1.109-1.109c.041-.174.041-.371.041-.6v-2.5c0-.229 0-.426-.041-.6A1.5 1.5 0 0 0 12.85 8.04c-.174-.04-.37-.04-.6-.04zm-.417 1.014c.043-.01.11-.014.417-.014h2.4c.308 0 .374.003.417.014a.5.5 0 0 1 .37.37c.01.042.013.108.013.416v2.4c0 .308-.004.374-.014.417a.5.5 0 0 1-.37.37c-.042.01-.108.013-.416.013H9.8c-.308 0-.374-.004-.417-.014a.5.5 0 0 1-.37-.37C9.004 12.575 9 12.509 9 12.2V9.8c0-.308.003-.374.014-.417a.5.5 0 0 1 .37-.37"
              clip-rule="evenodd"></path></symbol
          ><use href="#ai:local:dashboard"></use>
        </svg>
        <h3
          class="text-primario-black text-4xl font-extrabold max-xl:text-3xl max-md:text-xl dark:text-white"
        >
          {grid2} 
        </h3>
      </div>
      <GridFlags banderas={banderas} />
    </article>
  </div>
  <div
    class="col-span-2 row-span-2 rounded-2xl bg-linear-to-r p-[.2rem] md:col-start-1 md:row-start-1"
  >
    <article
      class="group relative flex h-full flex-col justify-start overflow-hidden rounded-2xl bg-linear-to-tr from-white to-[#e5e5e5] transition-all before:absolute before:bottom-30 before:left-1/2 before:-z-0 before:aspect-square before:h-[30%] before:rounded-full before:bg-[radial-gradient(circle,rgba(185,141,51)_0,rgba(185,141,51)_100%)] before:opacity-70 before:blur-3xl before:transition hover:shadow-[0_10px_50px_rgba(185,141,51,0.2)] hover:before:animate-pulse max-md:p-6 xl:before:bottom-2/5 dark:bg-linear-to-bl dark:from-[#262626] dark:to-[#171717]"
    >
      <a
        href={link}
        class="absolute top-0 left-0 z-40 h-full w-full bg-transparent"
        aria-label="LLCs"></a>
      <div class="flex items-center gap-4 max-md:gap-2">
        <h3
          class="mx-6 mt-10 text-4xl font-extrabold max-xl:text-3xl max-md:text-xl dark:text-white text-primario-black"
        >
          {title}
        </h3>
      </div>
      <p
        class="z-2 mx-6 my-6 max-w-[90%] text-lg leading-6 font-semibold max-xl:text-base max-md:max-w-[85%] dark:text-gray-200 text-primario-black"
      >
        {description}
      </p>

      <Image
        src={ImagenMock}
        alt="imagen web sotomayor"
        class="lg:relative lg:left-0 lg:z-0 mt-20 ml-20 w-2/4 scale-180 object-cover transition-all duration-500 ease-in-out group-hover:scale-185 group-hover:rotate-2 before:absolute before:-bottom-0  before:-z-10 before:aspect-square before:h-[80%] before:rounded-full before:bg-[radial-gradient(circle,rgba(185,141,51)_0,rgba(185,141,51)_100%)] before:opacity-80 before:blur-3xl before:transition max-xl:mt-28 max-lg:mt-10 max-md:scale-100 max-md:group-hover:scale-105 max-sm:mt-0 max-sm:scale-125 lg:w-3/5 lg:mb-0 mb-5"
      />
    </article>
  </div>
</div>
